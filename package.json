{
  "name": "app",
  "private": true,
  "scripts": {
    "build:dev": "esbuild app/javascript/*.* --bundle --sourcemap --format=esm --outdir=app/assets/builds --public-path=/assets --alias:@controllers=app/javascript/controllers --alias:@utils=app/javascript/utils --alias:stimulus=@hotwired/stimulus",
    "build": "esbuild app/javascript/*.* --bundle --format=esm --outdir=app/assets/builds --public-path=/assets --alias:@controllers=app/javascript/controllers --alias:@utils=app/javascript/utils --alias:stimulus=@hotwired/stimulus",
    "build:css": "tailwindcss -i ./app/assets/stylesheets/application.css -o ./app/assets/builds/application.css --minify",
    "watch:css": "tailwindcss -i ./app/assets/stylesheets/application.css -o ./app/assets/builds/application.css --watch"
  },
  "dependencies": {
    "@fortawesome/fontawesome-free": "^7.2.0",
    "@hotwired/stimulus": "^3.2.2",
    "@hotwired/turbo-rails": "^8.0.23",
    "@types/sortablejs": "^1.15.9",
    "cropperjs": "^2.2.0",
    "sortablejs": "^1.15.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@tailwindcss/cli": "^4",
    "@types/hotwired__turbo-rails": "^8.0.0",
    "esbuild": "^0.27.4",
    "eslint": "^10.0.3",
    "globals": "^17.5.0",
    "tailwindcss": "^4",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.57.0"
  },
  "browserslist": [
    "defaults"
  ]
}
