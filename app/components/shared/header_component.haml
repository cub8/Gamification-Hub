%header.w-100.px-3.py-1.d-flex.align-items-center

  %a.d-flex.align-items-center.text-decoration-none.h-100{href: home_path}
    = image_tag 'logo.png', alt: 'App logo', class: 'h-100'

  .ms-auto.d-flex.gap-2.align-items-center.gap-1
    %button.btn.btn-flat.fs-5
      Dołącz do grupy
    #header-actions.d-block.h-100.d-flex.justify-content-between.align-items-center
      - if @current_user.teacher?
        %i.fa-solid.fa-fw.fa-bell.fs-4.cursor-pointer
      = image_tag 'default_user.jpg', alt: 'User icon', class: 'h-100 user-icon rounded-circle cursor-pointer'
