%nav.gh-mobile-tabbar{ 'aria-label': 'Nawigacja' }
  - items.each do |item|
    - on = item.current?(current_path)
    = link_to item.path, class: "gh-mobile-tab #{'gh-mobile-tab--active' if on}",
      'aria-current': ('page' if on),
      data: (item.frame ? { turbo_frame: item.frame } : {}) do
      %i.fa-solid{ class: item.icon }
      -# The tab bar has less room than the sidebar, so two labels shorten.
      %span= item.tab_label

  %button.gh-mobile-tab{ type: 'button',
                  data: { action: 'menu#open', menu_id_param: 'gh-more-sheet' } }
    %i.fa-solid.fa-ellipsis
    %span Więcej
