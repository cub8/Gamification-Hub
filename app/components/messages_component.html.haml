%div{id: @id, data: { turbo_temporary: true} }
  - if flash.any?
    .container-fluid.mt-3
      - if notice
        .alert.alert-success.fw-500.alert-dismissible.fade.show{role: "alert"}
          = notice
          = close_button
      - if alert
        .alert.alert-danger.fw-500.alert-dismissible.fade.show{role: "alert"}
          = alert
          = close_button
