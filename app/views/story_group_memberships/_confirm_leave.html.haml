- story_group = membership.story_group

%h2#gh-leave-title.gh-h2= t('.title', name: story_group.name)
- badges = t('.badges', count: membership.students_badges.count)
- items  = t('.items', count: membership.students_items.count)
%p= t('.lose', balance: membership.current_currency.to_i, currency: story_group.currency_name, badges:, items:)

%p.gh-warning-note{ role: 'alert' }
  %i.fa-solid.fa-triangle-exclamation{ 'aria-hidden': 'true' }
  %span= t('.warning')

.gh-dialog-button-row
  - if @in_modal
    %button.gh-btn.gh-btn--secondary{ type: 'button', data: { action: 'dialog#close' }, autofocus: true }
      = t('.stay')
  - else
    = link_to t('.stay'), edit_story_group_membership_path(story_group),
      class: 'gh-btn gh-btn--secondary'

  = button_to t('.leave'), story_group_membership_path(story_group),
    method: :delete, class: 'gh-btn',
    form: { data: { turbo_frame: (@in_modal ? 'modal' : nil) } }
