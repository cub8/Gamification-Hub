%h2#gh-nick-title.gh-h2= t('.title', name: membership.story_group.name)
%p= t('.hint')

= form_with model: membership, url: story_group_membership_path(membership.story_group),
  method: :patch, data: { turbo_frame: (@in_modal ? 'modal' : nil) } do |f|
  = hidden_field_tag :return_to, 'ranking'
  = render 'nickname_field', f: f, membership: membership, submit_label: nil, autofocus: true

  .gh-dialog-button-row
    - if @in_modal
      %button.gh-btn.gh-btn--secondary{ type: 'button', data: { action: 'dialog#close' } }= t('shared.actions.cancel')
    - else
      = link_to t('shared.actions.cancel'), story_group_ranking_path(membership.story_group),
        class: 'gh-btn gh-btn--secondary'

    %button.gh-btn{ type: 'submit' }= t('.save')
