%h2= @activity_group.name

= link_to 'Back to activity groups', story_group_activity_groups_path(@story_group)

%hr

- if @categories.empty?
  %p No categories defined for this group.
- elsif @students.empty?
  %p No students in this story group.
- else
  = form_with url: story_group_activity_group_students_activity_group_categories_path(@story_group, @activity_group), method: :patch do |f|
    = hidden_field_tag 'completions[_placeholder]', ''
    %table.table.table-sm.table-bordered
      %thead
        %tr
          %th Story description
          - @categories.each do |cat|
            %th= cat.story_description
        %tr
          %th Didactic description
          - @categories.each do |cat|
            %th= cat.didactic_description
        %tr
          %th Points
          - @categories.each do |cat|
            %th= cat.reward
      %tbody
        - @students.each do |student|
          %tr
            %td= student.full_name
            - @categories.each do |cat|
              - completed = @completed.include?([cat.id, student.id])
              %td
                = check_box_tag "completions[#{student.id}][#{cat.id}]",
                                '1',
                                completed,
                                disabled: completed

    = f.submit 'Save rewards'
