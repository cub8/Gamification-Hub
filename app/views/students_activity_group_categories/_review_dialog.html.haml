-# "Przejrzyj i przyznaj". Mockup: js-expanded/30-main.js:215-222.
-#
-# The whole matrix is rendered here, hidden, and the controller unhides what is
-# marked. Building the list in JavaScript would mean writing markup, which no
-# controller in this app does — and the screen is a class by a dozen columns,
-# so there is nothing to gain by being clever about it.
%dialog.gh-dialog.gh-dialog--review{ 'aria-labelledby': 'gh-review-title',
                                     data: { grading_target: 'dialog',
                                             action: 'close->grading#closeReview click->grading#closeOnBackdrop' } }
  .gh-dialog-body
    %h2#gh-review-title.gh-h2
      Przyznajesz
      %span{ data: { grading_target: 'reviewSum' } }
      = @story_group.currency_name
      %span{ data: { grading_target: 'reviewStudents' } }

    %p.gh-warn{ role: 'alert' }
      %i.fa-solid.fa-lock{ 'aria-hidden': 'true' }
      Po zatwierdzeniu nie da się tego cofnąć. Sprawdź listę, zanim przyznasz nagrody.

    %ul.gh-rv
      - students.each do |student|
        -# The REAL name, never the nickname: grading is the teacher naming a
        -# person, and a pseudonym in this column is the one thing that could
        -# make them award the wrong row. The mockup prints `s.name` here too.
        - name = student.full_name
        - open_categories = categories.reject { |category| @sheet.awarded?(student, category) }
        - next if open_categories.empty?
        %li{ hidden: true, data: { grading_target: 'reviewRow', gh_student: student.id } }
          %span.gh-rv-n
            %span.gh-av.gh-av--sm{ 'data-gh-h': gh_avatar_hue(name), 'aria-hidden': 'true' }
              = gh_initials(name)
            = name
          %span.gh-rv-c
            - open_categories.each do |category|
              %span.gh-rvchip.gh-oct{ hidden: true,
                                      data: { grading_target: 'reviewChip',
                                              gh_student: student.id, gh_column: category.id } }
                = category.didactic_description
                %b= "+#{category.reward.to_i}"
          %span.gh-rv-s{ data: { grading_target: 'reviewRowSum' } }

    .gh-dlg-b
      -# The safe button first and focused (DECISIONS.md:31). The one beside it
      -# hands out currency that cannot be taken back.
      %button.gh-btn.gh-btn--sec{ type: 'button', autofocus: true,
                                  data: { action: 'grading#closeReview' } }
        Wróć do edycji
      %button.gh-btn.gh-btn--gold{ type: 'submit', form: 'gh-grade-form' }
        Przyznaj
        %span{ data: { grading_target: 'reviewConfirmSum' } }
        = @story_group.currency_name
