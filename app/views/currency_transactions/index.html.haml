%h1= @student.full_name

%h2 Currency Transactions

- if @student.user == @current_user
  = link_to 'Back', story_group_profile_index_path(@story_group)
- else
  = link_to 'Back', story_group_students_path(@story_group)

%hr

- if @transactions.empty?
  %p No transactions yet.
- else
  %table.table.table-sm.table-bordered
    %thead
      %tr
        %th Amount
        %th Date
        %th Type
        %th Source
    %tbody
      - @transactions.each do |transaction|
        %tr
          %td= transaction.amount
          %td= transaction.created_at.strftime('%Y-%m-%d %H:%M')
          %td= transaction.kind
          %td= transaction_source(transaction)
