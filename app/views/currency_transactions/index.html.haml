- content_for :title, "Transactions — #{@student.full_name}"

.dark-page
  .d-flex.align-items-center.justify-content-between.mb-4
    .d-flex.align-items-center.gap-3
      - if @student.user == @current_user
        = link_to story_group_profile_index_path(@story_group), class: "btn btn-secondary" do
          %i.bi.bi-arrow-left
      - else
        = link_to story_group_students_path(@story_group), class: "btn btn-secondary" do
          %i.bi.bi-arrow-left
      %div
        %h1.h3.mb-0 Currency Transactions
        %small.text-dimmed= @student.full_name
    %span.text-dimmed
      Balance:
      %strong.text-main= @student.current_currency

  - if @transactions.empty?
    %p.text-dimmed No transactions yet.
  - else
    %table.table.table-sm.table-hover
      %thead
        %tr
          %th Amount
          %th Type
          %th Source
          %th.text-end Date
      %tbody
        - @transactions.each do |transaction|
          %tr
            %td
              - if transaction.amount >= 0
                %span.text-success= "+#{transaction.amount}"
              - else
                %span.text-danger= transaction.amount
            %td
              - badge_class = { "reward" => "bg-primary", "adjustment" => "bg-secondary", "purchase" => "bg-info" }[transaction.kind] || "bg-secondary"
              %span.badge{ class: badge_class }= transaction.kind.capitalize
            %td.text-dimmed= transaction_source(transaction)
            %td.text-end.text-dimmed= transaction.created_at.strftime("%Y-%m-%d %H:%M")
