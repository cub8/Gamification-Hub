- summary = local_assigns.fetch(:summary, nil)
- entries = ledger.entries(kind: kind)

.gh-ledger-header
  = ledger_filter_chips(ledger, kind, path_for: path_for)
  - if summary
    %span.gh-ledger-header-spacer
    %span.gh-small= summary

%div{ role: 'table', 'aria-label': 'Historia waluty' }
  .gh-ledger-row.gh-ledger-row--header{ role: 'row' }
    %span{ role: 'columnheader' } Kwota
    %span{ role: 'columnheader' } Typ
    %span{ role: 'columnheader' } Za co
    %span{ role: 'columnheader' } Kiedy
    %span.gh-ledger-cell--right{ role: 'columnheader' } Saldo po

  - entries.each do |entry|
    .gh-ledger-row{ role: 'row' }
      %span.gh-ledger-amount{ class: "gh-ledger-amount--#{entry.tone}", role: 'cell' }= entry.signed_amount
      %span.gh-pill.gh-octagon-clip{ class: "gh-pill--#{entry.tone}", role: 'cell' }= entry.label
      %span.gh-ledger-source{ role: 'cell' }
        = entry.title
        - if entry.withdrawn?
          %span.gh-tag.gh-tag--removed Usunięty z oferty
        - if entry.context.present?
          %small= entry.context
      %span.gh-small.gh-ledger-date{ role: 'cell' }= ledger_when(entry)
      %span.gh-ledger-balance{ role: 'cell' }= entry.balance_after

- if entries.empty?
  %p.gh-explainer-note.gh-ledger-empty= empty_message
