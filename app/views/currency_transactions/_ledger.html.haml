-# The currency ledger. Mockup: 30-sp.js:32-33 (the student's own screen) and
-# 30-student.js:34-35 (the teacher's third tab).
-#
-# ONE partial for both, because the mockup's two copies are identical apart
-# from their wrapper, the summary line and the empty sentence — and a ledger
-# that disagreed with itself depending on who was reading would be worse than
-# either copy.
-#
-# Locals:
-#   ledger        — Redesign::CurrencyLedger
-#   kind          — the active filter, or nil for "Wszystkie"
-#   path_for      — ->(kind) { url }, so each screen keeps its own URL shape
-#   empty_message — what to say when the filter matches nothing
-#   summary       — optional markup shown beside the filters (the teacher's)
- summary = local_assigns.fetch(:summary, nil)
- entries = ledger.entries(kind: kind)

.gh-ledh
  = ledger_filter_chips(ledger, kind, path_for: path_for)
  - if summary
    %span.gh-ledh-sp
    %span.gh-small= summary

-# role="table" rather than a <table>: every row has to reflow into a stacked
-# block on a phone, which a table cannot do. Same reasoning as the invites list.
%div{ role: 'table', 'aria-label': 'Historia waluty' }
  .gh-lrow.gh-lrow--h{ role: 'row' }
    %span{ role: 'columnheader' } Kwota
    %span{ role: 'columnheader' } Typ
    %span{ role: 'columnheader' } Za co
    %span{ role: 'columnheader' } Kiedy
    %span.gh-lrow-r{ role: 'columnheader' } Saldo po

  - entries.each do |entry|
    .gh-lrow{ role: 'row' }
      %span.gh-amt{ class: "gh-amt--#{entry.tone}", role: 'cell' }= entry.signed_amount
      -# The chip IS the cell. The mockup wraps it in a second span, which
      -# leaves the wrapper as the grid item and the chip's own placement rules
      -# matching nothing — visible only once the row reflows on a phone.
      %span.gh-ty{ class: "gh-ty--#{entry.tone}", role: 'cell' }= entry.label
      %span.gh-src{ role: 'cell' }
        = entry.title
        -# The item is off the shelf but the row stays: soft delete keeps
        -# history (DECISIONS.md:28), and a purchase that vanished would make
        -# the balance below it unexplainable.
        - if entry.withdrawn?
          %span.gh-tag.gh-tag--del Usunięty z oferty
        - if entry.context.present?
          %small= entry.context
      %span.gh-dt{ role: 'cell' }= ledger_when(entry)
      %span.gh-bal2{ role: 'cell' }= entry.balance_after

- if entries.empty?
  %p.gh-expl.gh-ledger-empty= empty_message
