%h1 Ostatnie zdarzenia

%table.table.mt-4
  %thead
    %tr
      %th Grupa
      %th Student
      %th Zdarzenie
      %th Przedmiot
      %th Data
  %tbody
    - @notifications.each do |notification|
      %tr
        %td= notification.story_group.name
        %td= notification.story_group_student.user.email
        %td Kupił(a) przedmiot w sklepie
        %td= notification.item.name
        %td= notification.created_at.strftime('%Y-%m-%d %H:%M')
