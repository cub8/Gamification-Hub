-# Notifications for the redesign layout, rendered into the anchored panel.
-# The Bootstrap dropdown version lives in index.html.haml; both are fed by
-# NotificationsController#index.
-#
-# No close button: the panel is dismissed by clicking away from it or with
-# Escape, exactly like the mockup's popover.
= turbo_frame_tag 'panel' do
  = render 'notifications/redesign_panel',
    notifications: @notifications, unread: @unread, read: @read
