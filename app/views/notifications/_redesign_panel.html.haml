-# Contents of the notifications panel. Kept separate from redesign_index so
-# mark_as_read can re-render it into the open panel without nesting a second
-# turbo-frame inside the first.
.gh-pop-h
  %h2.gh-h3 Powiadomienia
  - if unread.any?
    = button_to mark_as_read_notifications_path, class: 'gh-linkbtn' do
      %i.fa-solid.fa-check-double
      Oznacz wszystkie

- if notifications.any?
  - if unread.any?
    %p.gh-pop-sec Nowe
    %ul.gh-nlist
      = render partial: 'notifications/redesign_notification', collection: unread, as: :notification

  - if read.any?
    %p.gh-pop-sec Wcześniej
    %ul.gh-nlist
      = render partial: 'notifications/redesign_notification', collection: read, as: :notification
- else
  %p.gh-small Brak powiadomień.
