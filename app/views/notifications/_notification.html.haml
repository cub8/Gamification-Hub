- student = notification.story_group_student
- story_group = notification.story_group
- unread = notification.read_at.nil?

%li.gh-notification-row{ class: ('gh-notification-row--unread' if unread) }
  = link_to story_group_student_students_items_path(story_group, student),
    class: 'gh-notification-row-link', data: { turbo_frame: '_top' } do
    = render 'layouts/item_thumb', item: notification.item
    %span.gh-notification-row-text
      %b= student.full_name
      %span= t('.purchase', name: notification.item.name)
      %small= t('.meta', group: story_group.name, when: gh_when(notification.created_at))
    - if unread
      %span.gh-notification-unread-dot.gh-octagon-clip{ 'aria-label': t('.unread') }
