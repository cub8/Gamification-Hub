-# One purchase notification. Mockup: the `row()` closure inside popNotif()
-# (js-expanded/10-core.js:252).
-#
-# The thumbnail is the purchased ITEM, not the group — the group is named in
-# the caption line underneath instead.
- student = notification.story_group_student
- story_group = notification.story_group
- unread = notification.read_at.nil?

%li.gh-notification-row{ class: ('gh-notification-row--unread' if unread) }
  = link_to story_group_student_students_items_path(story_group, student),
    class: 'gh-notification-row-link', data: { turbo_frame: '_top' } do
    = render 'layouts/item_thumb', item: notification.item
    %span.gh-notification-row-text
      %b= student.full_name
      %span= "Zakup: #{notification.item.name}"
      %small= "#{story_group.name}, #{gh_when(notification.created_at)}"
    - if unread
      %span.gh-notification-unread-dot.gh-octagon-clip{ 'aria-label': 'nowe' }
