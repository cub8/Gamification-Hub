%h1 Mój profil

%h3= "Moja obecna waluta: #{@student.current_currency}"
%h5= "Łączna waluta: #{@student.total_currency}"

%h3
  = link_to "Moje odznaki", story_group_student_badges_path(@story_group, @student)

- if @student.rank
  %h3 Moja ranga

  %p
    - if @student.rank.icon.attached?
      = image_tag @student.rank.icon, height: 50
      = @student.rank.name

%p
  = link_to "Moje transakcje", story_group_student_currency_transactions_path(@story_group, @student)

%p
  = link_to "Wróć", story_group_path(@story_group)
