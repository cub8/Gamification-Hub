%h2#gh-del-title.gh-h2= t('.title', name: teacher.full_name)
%p= t('.body')

.gh-dialog-button-row
  - if @in_modal
    %button.gh-btn.gh-btn--secondary{ type: 'button', data: { action: 'dialog#close' }, autofocus: true }= t('shared.actions.cancel')
  - else
    = link_to t('shared.actions.cancel'), story_group_teachers_path(@story_group), class: 'gh-btn gh-btn--secondary'

  = button_to t('.remove'), story_group_teacher_path(@story_group, teacher),
    method: :delete, class: 'gh-btn',
    form: { data: { turbo_frame: (@in_modal ? 'modal' : nil) } }
