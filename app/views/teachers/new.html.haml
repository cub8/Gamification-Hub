-# Either the layout's shared `modal` frame or a page — never both. A page
-# carrying its own <turbo-frame id="modal"> would collide with the one the
-# layout already has inside the dialog.
- content_for :title, 'Dodaj nauczyciela'

- if @in_modal
  = turbo_frame_tag 'modal' do
    = render 'form', teacher: @teacher, pool: @pool
- else
  -# Rendered as a page it needs a surface of its own: these screens keep the app
  -# shell, so unlike the join flow they never land inside .gh-acard.
  %section.gh-panel.gh-dlg-page
    = render 'form', teacher: @teacher, pool: @pool
