%h3 Add Teacher

- if @teacher.errors.any?
  .errors{ style: "color: red; margin-bottom: 1em;" }
    %ul
      - @teacher.errors.full_messages.each do |message|
        %li= message

= form_with model: @teacher do |f|
  .field
    = f.label :user_id, "Select teacher"
    = f.select :user_id,
        options_from_collection_for_select(@teachers, :id, :email, @teacher.user_id),
        { prompt: "Choose a user" },
        { data: { controller: "tom-select", tom_select_options_value: teacher_map(@teachers).to_json} }

  .actions
    = f.submit "Add Teacher"

%p
  = link_to "Back", story_group_teachers_path(@story_group)
