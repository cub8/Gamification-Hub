%h3 Add Teacher

= form_with url: story_group_teachers_path(@story_group), scope: :story_group_teacher, method: :post do |f|
  .field
    = f.label :user_id, "Select teacher"
    %br
    = f.select :user_id,
      options_from_collection_for_select(teachers(@current_user),
        :id,
        :email,
      ),
      { prompt: "Choose a user" },
      { data: { controller: "tom-select", tom_select_options_value: teacher_map(@current_user).to_json} }

  .actions
    = f.submit "Add Teacher"

%p
  = link_to "Back", story_group_teachers_path(@story_group)
