- content_for :title, "Add Teacher"

.dark-page
  .row.justify-content-center
    .col-12.col-md-8.col-lg-6
      %h1.sg-form-title Add Teacher

      - if @teacher.errors.any?
        .sg-errors
          %h2 Please fix the following errors:
          %ul
            - @teacher.errors.full_messages.each do |message|
              %li= message

      = form_with model: @teacher, url: story_group_teachers_path(@story_group) do |f|
        .sg-section
          .sg-section-title Basic Information

          .sg-form-group
            = f.label :user_id, "Select teacher"
            = f.select :user_id,
                options_from_collection_for_select(@teachers, :id, :email, @teacher.user_id),
                { prompt: "Choose a user" },
                { class: "form-control",
                  data: { controller: "tom-select-user", tom_select_options_value: teacher_map(@teachers).to_json } }

        .sg-form-actions
          = link_to "Cancel", story_group_teachers_path(@story_group), class: "sg-btn-cancel"
          = f.submit "Add Teacher", class: "sg-btn-submit"
