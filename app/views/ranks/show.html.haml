- content_for :title, @rank.name

%turbo-frame#modal
  .modal-overlay.py-5.px-3
    .form-card.p-4
      %h2.page-title.mb-4= @rank.name

      .text-center.mb-4
        - if @rank.icon.attached?
          = image_tag @rank.icon, class: "img-fluid rounded"
        - else
          %i.fa-solid.fa-trophy.fa-4x.text-dimmed

      .d-flex.flex-column.gap-2.mb-4
        .d-flex.justify-content-between
          %span.text-dimmed Required currency
          %span= @rank.required_currency_value
        .d-flex.justify-content-between
          %span.text-dimmed Discount
          %span= "#{@rank.discount}%"

      .d-flex.justify-content-end.align-items-center.gap-2
        = link_to "Zamknij", story_group_ranks_path(@story_group), class: "btn btn-secondary"
        - if policy(@story_group).update?
          = link_to edit_story_group_rank_path(@story_group, @rank), class: "btn btn-primary", data: { turbo_frame: "_top" } do
            %i.fa-solid.fa-pen.me-1
            Edytuj
