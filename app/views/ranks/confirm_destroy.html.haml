- content_for :title, "Usuń rangę #{@rank.name}"

- if @in_modal
  = turbo_frame_tag 'modal' do
    = render 'confirm_destroy', rank: @rank, dependent_items: @dependent_items
- else
  %section.gh-panel.gh-dialog-page-panel
    = render 'confirm_destroy', rank: @rank, dependent_items: @dependent_items
