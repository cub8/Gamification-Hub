- content_for :title, t('.page_title', name: @rank.name)

- if @in_modal
  = turbo_frame_tag 'modal' do
    = render 'confirm_destroy',
             rank:            @rank,
             dependent_items: @dependent_items,
             in_modal:        @in_modal,
             story_group:     @story_group
- else
  %section.gh-panel.gh-dialog-page-panel
    = render 'confirm_destroy',
             rank:            @rank,
             dependent_items: @dependent_items,
             in_modal:        @in_modal,
             story_group:     @story_group
