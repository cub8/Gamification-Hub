-# The group's currency beside the threshold field — the mockup's `.tok`
-# (20-form.css:77-80), a gold rim around a cream plate. Decorative: the field's
-# own label already says what the number means.
%span.gh-tok{ 'aria-hidden': 'true' }
  %span
    - if @story_group.currency_icon.attached?
      = image_tag @story_group.currency_icon, alt: ''
    - else
      %i.fa-solid.fa-coins
