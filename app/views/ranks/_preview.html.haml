- saved   = ladder.rungs.map(&:rank).reject { |other| other == rank }
- entries = (saved.map { |other| [other, false] } << [rank, true])
- entries = entries.sort_by { |entry, draft| [entry.required_currency_value.to_i, draft ? 1 : 0] }

%details.gh-preview-details{ open: true }
  %summary
    Podgląd rangi
    %i.fa-solid.fa-chevron-down{ 'aria-hidden': 'true' }

  %section.gh-panel.gh-preview-panel
    %h3 Karta rangi
    .gh-preview-flip-card
      %article.gh-card.gh-card--rank
        .gh-card-frame
          .gh-card-inset
            .gh-card-header
              %h4.gh-card-name{ class: ('gh-placeholder-text' if rank.name.blank?),
                                data: { rank_form_target: 'cardName' } }
                = rank.name.presence || 'Nazwa rangi'
            .gh-card-art{ data: { rank_form_target: 'cardArt' } }
              - if rank.upload?
                = image_tag rank.icon, alt: ''
              - else
                = gh_glyph(rank.icon_glyph)
            %p.gh-rule-text{ data: { rank_form_target: 'cardRules' } }= rank_reward_line(rank)

  %section.gh-panel.gh-preview-panel
    %h3 Drabinka rang
    -# Ascending in the DOM; .gh-rank-form-ladder reverses it visually, so the highest
    -# rung reads first exactly as it does on both list screens.
    %ol.gh-rank-form-ladder{ data: { rank_form_target: 'ladder' } }
      - entries.each do |entry, draft|
        %li.gh-rank-form-rung{ class: ('gh-rank-form-rung--draft' if draft),
                    data: { rank_id: (draft ? 'draft' : entry.id),
                            min: entry.required_currency_value.to_i } }
          = render 'rank_thumb', rank: entry,
            inner_data: (draft ? { rank_form_target: 'draftArt' } : nil)
          %span
            %b
              %span{ data: (draft ? { rank_form_target: 'draftName' } : {}) }
                = entry.name.presence || 'Nowa ranga'
              - if draft
                %small (ta ranga)
            %small{ data: (draft ? { rank_form_target: 'draftTerms' } : {}) }
              = rank_ladder_terms(entry)
          %span.gh-rank-form-rung-value{ data: (draft ? { rank_form_target: 'draftValue' } : {}) }
            = "od #{entry.required_currency_value.to_i}"
