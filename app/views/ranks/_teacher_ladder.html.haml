%section.gh-panel.gh-page-header
  .gh-page-header-text
    %h1.gh-h1 Rangi
    %p.gh-lead
      = "#{ladder.size} #{gh_plural(ladder.size, 'ranga', 'rangi', 'rang')}."
      Ranga zależy od łącznie zebranej waluty, więc wydawanie jej nie obniża rangi.

  .gh-button-row
    = link_to new_story_group_rank_path(@story_group), class: 'gh-btn' do
      %i.fa-solid.fa-plus
      Nowa ranga

- if ladder.any?
  %section.gh-panel.gh-list-panel
    %ol.gh-rank-ladder-list
      - ladder.descending.each_with_index do |rung, position|
        - if position.positive?
          %li.gh-rank-gap{ 'aria-hidden': 'true' }
            = "↑ #{rung.gap_to_next} zebranych do awansu"

        %li.gh-rank-row
          = render 'rank_thumb', rank: rung.rank
          %div
            %b= rung.rank.name
            %small.gh-small= rank_summary(rung.rank)

            - required_by = ladder.dependent_items(rung.rank)
            - if required_by.any?
              %small.gh-rank-row-requirement
                = "Wymagana do zakupu: #{required_by.map(&:name).join(', ')}"

          .gh-rank-row-stats
            %b= rung.holders
            = gh_plural(rung.holders, 'student', 'studentów', 'studentów')
            - if ladder.total_students.positive?
              .gh-progress-bar.gh-octagon-clip{ role: 'progressbar',
                       'aria-valuemin': 0,
                       'aria-valuemax': ladder.total_students,
                       'aria-valuenow': rung.holders,
                       'aria-label': "Studenci z rangą #{rung.rank.name}" }
                %i.gh-octagon-clip{ style: "--gh-p: #{gh_percent(rung.holders, ladder.total_students)}%" }

          = link_to edit_story_group_rank_path(@story_group, rung.rank),
            class: 'gh-btn gh-btn--secondary gh-btn--small' do
            %i.fa-solid.fa-pen
            Edytuj
- else
  %section.gh-panel.gh-empty-state
    %h2.gh-h2 Nie ma jeszcze żadnych rang
    %p.gh-lead
      Dodaj rangi, żeby studenci widzieli, do czego dążą. Ranga zależy od łącznie
      zebranej waluty, a każda może dawać zniżkę w sklepie.
