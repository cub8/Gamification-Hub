- content_for :title, "Ranks"

.dark-page
  .d-flex.align-items-center.justify-content-between.mb-4
    %h1.h3.mb-0 Ranks
    - if policy(@story_group).update?
      = link_to new_story_group_rank_path(@story_group), class: "btn btn-primary" do
        %i.bi.bi-plus-lg.me-1
        New Rank

  - if @ranks.empty?
    %p.text-dimmed No ranks yet.
  - else
    .row.g-3
      - @ranks.each do |rank|
        .col-12.col-sm-6.col-md-4.col-xl-3
          .dark-card
            - if rank.icon.attached?
              .dark-card-cover
                = image_tag rank.icon
            - else
              .dark-card-icon
                %i.bi.bi-trophy{ style: "font-size: 2.5rem;" }

            .dark-card-body
              .dark-card-title= rank.name
              .d-flex.align-items-center.gap-2.mt-2
                %span.text-dimmed.small Required:
                %span.small= rank.required_currency_value
              .d-flex.align-items-center.gap-2
                %span.text-dimmed.small Discount:
                %span.small= "#{rank.discount}%"

            .dark-card-actions
              = link_to story_group_rank_path(@story_group, rank), class: "btn btn-sm btn-secondary border-0", title: "View" do
                %i.bi.bi-eye
              - if policy(@story_group).update?
                = link_to edit_story_group_rank_path(@story_group, rank), class: "btn btn-sm btn-secondary border-0", title: "Edit" do
                  %i.bi.bi-pencil
                = button_to story_group_rank_path(@story_group, rank),
                  method: :delete,
                  form: { data: { turbo_confirm: "Delete rank \"#{rank.name}\"?" } },
                  class: "btn btn-sm btn-danger border-0", title: "Delete" do
                  %i.bi.bi-trash
