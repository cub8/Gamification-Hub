%h2 Teachers

%table
  %thead
    %tr
    %th Email
    %th
  %tbody
    - @story_group_teachers.each do |teacher|
      %tr
        %td= teacher.user.email
        %td
          = button_to "Remove",
            story_group_story_group_teacher_path(@story_group, teacher),
            method: :delete,
            data: { confirm: "Are you sure?" }

%hr

%h3 Add Teacher

= form_with model: [@story_group, @story_group_teacher] do |f|
  .field
    = f.label :user_id, "Select teacher"
    %br
    = f.select :user_id,
      options_from_collection_for_select( teachers,
        :id,
        :email,
      ),
      { prompt: "Choose a user" },
      { data: { controller: "tom-select", tom_select_options_value: teacher_map.to_json} }

  .actions
    = f.submit "Add Teacher"

%p
  = link_to "Back", story_group_path(@story_group)
