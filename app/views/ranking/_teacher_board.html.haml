- story_group = board.story_group

%section.gh-panel.gh-page-header
  .gh-page-header-text
    %h1.gh-h1= t('.title')
    %p.gh-lead= t('.lead', currency: story_group.currency_name)

  .gh-ranking-controls
    .gh-toggle-switch-row.gh-switch-row--inline
      = link_to '', confirm_visibility_story_group_ranking_path(story_group,
                                                                enabled: !board.visible?),
        class: 'gh-toggle-switch gh-switch--link gh-octagon-clip', role: 'switch',
        'aria-checked': board.visible?.to_s, 'aria-labelledby': 'gh-rk-vis',
        data: { turbo_frame: 'modal' }
      %span
        %b#gh-rk-vis= t('.visible')

    - if board.visible?
      .gh-segmented-toggle-2.gh-octagon-clip{ role: 'group', 'aria-label': t('.modes_label') }
        - StoryGroup.ranking_modes.each_key do |mode|
          - label = StoryGroup.ranking_mode_label(mode)
          - if story_group.ranking_mode == mode
            %span{ 'aria-pressed': 'true' }= label
          - else
            = link_to label, confirm_mode_story_group_ranking_path(story_group, mode: mode),
              'aria-pressed': 'false', data: { turbo_frame: 'modal' }

- if !board.visible?
  %p.gh-info-banner.gh-ranking-visibility-note
    %i.fa-solid.fa-eye-slash{ 'aria-hidden': 'true' }
    %span
      %b= t('.hidden_note')
      = t('.hidden_note_tail')
- elsif story_group.ranking_podium_and_own?
  %p.gh-info-banner.gh-ranking-visibility-note
    %i.fa-solid.fa-eye-slash{ 'aria-hidden': 'true' }
    %span
      %b= t('.podium_note')
      = t('.podium_note_tail')

- if board.any?
  = render 'board', board: board, reveal_names: true

  %p.gh-small.gh-ranking-footnote= t('.footnote')
- else
  %section.gh-panel.gh-empty-state
    %h2.gh-h2= t('.empty_title')
    %p.gh-lead= t('.empty_body')
    .gh-button-row
      = link_to story_group_invites_path(story_group), class: 'gh-btn' do
        %i.fa-solid.fa-qrcode
        = t('.invites')
