-# Either the layout's shared `modal` frame or a page — never both. A page
-# carrying its own <turbo-frame id="modal"> would collide with the one the
-# layout already has inside the dialog.
- content_for :title, @enabled ? 'Pokaż ranking' : 'Ukryj ranking'

- if @in_modal
  = turbo_frame_tag 'modal' do
    = render 'confirm_visibility', story_group: @story_group, enabled: @enabled, mode: @mode
- else
  -# As a page it needs a surface of its own: this screen keeps the app shell,
  -# so unlike the join flow it never lands inside .gh-auth-card.
  %section.gh-panel.gh-dialog-page-panel
    = render 'confirm_visibility', story_group: @story_group, enabled: @enabled, mode: @mode
