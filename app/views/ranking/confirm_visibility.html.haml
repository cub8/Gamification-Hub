- content_for :title, @enabled ? t('.show_page_title') : t('.hide_page_title')

- if @in_modal
  = turbo_frame_tag 'modal' do
    = render 'confirm_visibility', story_group: @story_group, enabled: @enabled, mode: @mode
- else
  %section.gh-panel.gh-dialog-page-panel
    = render 'confirm_visibility', story_group: @story_group, enabled: @enabled, mode: @mode
