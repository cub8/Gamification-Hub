- content_for :title, "Ranking"

.dark-page
  .d-flex.align-items-center.justify-content-between.mb-4
    %h1.h3.mb-0 Ranking

    - if policy(@story_group).update?
      - if @story_group.ranking_enabled?
        = button_to change_status_story_group_ranking_path(@story_group),
          params: { ranking_enabled: false },
          form: { data: { turbo_confirm: "Are you sure you want to disable the ranking?" } },
          class: "btn btn-secondary" do
          %i.fa-solid.fa-eye-slash.me-1
          Disable ranking
      - else
        = button_to change_status_story_group_ranking_path(@story_group),
          params: { ranking_enabled: true },
          form: { data: { turbo_confirm: "Are you sure you want to enable the ranking?" } },
          class: "btn btn-primary" do
          %i.fa-solid.fa-eye.me-1
          Enable ranking

  - if policy(@story_group).update? && !@story_group.ranking_enabled?
    .alert.alert-warning.mb-3
      %i.fa-solid.fa-triangle-exclamation.me-1
      Ranking is currently hidden from students.

  - if @students.empty?
    %p.text-dimmed No students yet.
  - else
    %table.table.table-sm.table-hover
      %thead
        %tr
          %th.text-center #
          %th Full name
          %th Rank
          %th.text-end Total currency
      %tbody
        - @students.each_with_index do |student, index|
          %tr
            %td.text-center.text-dimmed= index + 1
            %td= student.full_name
            %td
              - if @student_ranks[student.id]
                = @student_ranks[student.id].name
              - else
                %span.text-dimmed —
            %td.text-end= student.total_currency
