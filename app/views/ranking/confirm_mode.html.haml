- content_for :title, t('.page_title', mode: StoryGroup.ranking_mode_label(@mode))

- if @in_modal
  = turbo_frame_tag 'modal' do
    = render 'confirm_mode', story_group: @story_group, mode: @mode
- else
  %section.gh-panel.gh-dialog-page-panel
    = render 'confirm_mode', story_group: @story_group, mode: @mode
