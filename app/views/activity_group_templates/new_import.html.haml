- content_for :title, t('.title')
- columns = tag.code('nr_szablonu, szablon, pozycja, opis_dydaktyczny, opis_fabularny, nagroda')

= render 'shared/csv_import_dialog', title: t('.dialog_title'),
                                     url:   import_story_group_activity_group_templates_path(@story_group),
                                     hint:  t('.hint_html', columns: columns),
                                     error: @upload_error
