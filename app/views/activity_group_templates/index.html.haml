%h1 Szablony grup aktywności

= link_to 'Nowy szablon', new_story_group_activity_group_template_path(@story_group)
|
= link_to 'Wróć do grupy', @story_group

%hr

- if @activity_group_templates.empty?
  %p Brak szablonów.
- else
  - @activity_group_templates.each do |template|
    %div
      %strong= template.base_name
      \(#{template.categories.count} kategorie)

      = link_to 'Edytuj', edit_story_group_activity_group_template_path(@story_group, template)
      |
      = button_to 'Usuń', story_group_activity_group_template_path(@story_group, template), method: :delete, data: { turbo_confirm: 'Czy na pewno chcesz usunąć ten szablon?' }

    %hr
