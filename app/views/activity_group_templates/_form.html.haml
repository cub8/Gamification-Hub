= form_with model: [@story_group, @activity_group_template], data: { turbo_frame: '_top' } do |f|
  - if @activity_group_template.errors.any?
    .form-errors.p-3.mb-3
      %h2 Popraw następujące błędy:
      %ul
        - @activity_group_template.errors.full_messages.each do |msg|
          %li= msg

  .form-section.p-4.mb-3
    .section-title.mb-3 Informacje podstawowe
    .field-group
      = f.label :base_name, 'Nazwa'
      = f.text_field :base_name, class: 'form-control'

  %div{ data: { controller: 'sortable-form nested-rondo', sortable_form_handle_value: '.drag-handle', nested_rondo_field_class_value: 'nested-fields' } }
    %div#template-categories-list{ data: { sortable_form_target: 'list', nested_rondo_target: 'fieldContain' } }
      = f.fields_for :categories do |cf|
        = render ActivityGroup::CategoryFormComponent.new(f: cf)

    .mt-2
      = link_to_add_association f, :categories, { partial: 'activity_group_templates/category_form' }, { class: 'btn btn-sm btn-secondary border-0' } do
        %i.fa-solid.fa-plus.me-1
        Dodaj kategorię

  .form-actions.gap-3.mt-4
    = link_to 'Anuluj', story_group_activity_groups_path(@story_group), class: 'btn-cancel py-2 px-3', data: { turbo_frame: '_top' }
    = f.submit(@activity_group_template.new_record? ? 'Utwórz' : 'Zapisz', class: 'btn-submit py-2 px-4')
