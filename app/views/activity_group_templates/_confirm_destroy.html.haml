%h2#gh-del-title.gh-h2= t('.title', name: template.base_name)
%p= t('.body')

- if sheet_names.any?
  %p.gh-info-banner
    %i.fa-solid.fa-table{ 'aria-hidden': 'true' }
    %span= t('.sheets', count: sheet_names.size, names: gh_and_list(sheet_names))

.gh-dialog-button-row
  - if @in_modal
    %button.gh-btn.gh-btn--secondary{ type: 'button', data: { action: 'dialog#close' }, autofocus: true }
      = t('shared.actions.cancel')
  - else
    = link_to t('shared.actions.cancel'), edit_story_group_activity_group_template_path(@story_group, template),
      class: 'gh-btn gh-btn--secondary'

  = button_to t('.remove'), story_group_activity_group_template_path(@story_group, template),
    method: :delete, class: 'gh-btn',
    form: { data: { turbo_frame: (@in_modal ? 'modal' : nil) } }
