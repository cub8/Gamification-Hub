- content_for :title, "Students"
- content_for :head do
  %meta{ name: "turbo-cache-control", content: "no-preview" }

.dark-page
  .d-flex.align-items-center.justify-content-between.mb-4
    %h1.h3.mb-0 Students
    = link_to new_story_group_student_path(@story_group), class: "btn btn-primary" do
      %i.fa-solid.fa-plus.me-1
      Add Student

  - if @students.empty?
    %p.text-dimmed No students yet.
  - else
    %table.table.table-sm.table-hover
      %thead
        %tr
          %th Full name
          %th Email address
          %th Lives
          %th Current currency
          %th Total currency
          %th.text-end Actions
      %tbody
        - @students.each do |student|
          %tr
            %td
              = link_to student.full_name, story_group_student_path(@story_group, student), class: "d-block text-decoration-none text-reset"
            %td
              = link_to student.email, story_group_student_path(@story_group, student), class: "d-block text-decoration-none text-reset"
            %td
              .d-flex.align-items-center.gap-1
                = button_to update_lives_story_group_student_path(@story_group, student, change: -1),
                  method: :post,
                  form: { data: { turbo_confirm: "Czy na pewno chcesz odebrać życie studentowi #{student.full_name}?" } },
                  class: "btn btn-sm btn-secondary border-0 px-1 py-0" do
                  %i.fa-solid.fa-minus
                %span= student.lives
                = button_to update_lives_story_group_student_path(@story_group, student, change: 1),
                  method: :post,
                  form: { data: { turbo_confirm: "Czy na pewno chcesz dodać życie studentowi #{student.full_name}?" } },
                  class: "btn btn-sm btn-secondary border-0 px-1 py-0" do
                  %i.fa-solid.fa-plus
            %td
              = link_to student.current_currency, story_group_student_path(@story_group, student), class: "d-block text-decoration-none text-reset"
            %td
              = link_to student.total_currency, story_group_student_path(@story_group, student), class: "d-block text-decoration-none text-reset"
            %td.text-end
              .d-flex.justify-content-end.gap-1
                = link_to edit_story_group_student_path(@story_group, student), class: "btn btn-sm btn-secondary border-0", title: "Edit" do
                  %i.fa-solid.fa-pen
                = link_to new_story_group_student_badge_path(@story_group, student), class: "btn btn-sm btn-secondary border-0", title: "Manage badges" do
                  %i.fa-solid.fa-award
                = link_to new_story_group_student_currency_adjustment_path(@story_group, student), class: "btn btn-sm btn-secondary border-0", title: "Adjust currency" do
                  %i.fa-solid.fa-money-bill-transfer
                .dropdown
                  %button.btn.btn-sm.btn-secondary.border-0{ data: { bs_toggle: "dropdown" }, "aria-expanded": "false" }
                    %i.fa-solid.fa-ellipsis-vertical
                  %ul.dropdown-menu.dropdown-menu-end
                    %li
                      = button_to story_group_student_path(@story_group, student),
                        method: :delete,
                        form: { data: { turbo_confirm: "Are you sure you want to remove #{student.full_name}?" } },
                        class: "dropdown-item text-danger" do
                        %i.fa-solid.fa-trash.me-2
                        Usuń
          - if defined?(@failed_student_id) && student.id == @failed_student_id && @student.errors.any?
            %tr
              %td{ colspan: 6 }
                .form-errors.p-3.mb-3
                  %ul
                    - @student.errors.full_messages.each do |message|
                      %li= message
