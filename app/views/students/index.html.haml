%h2 Students

%table
  %thead
    %tr
      %th Email
      %th Lives
      %th Current currency
      %th Total currency
      %th
  %tbody
    - @story_group_students.each do |student|
      %tr
        %td= student.user.email
        %td= student.lives
        %td= student.current_currency
        %td= student.total_currency
        %td
          = button_to "Remove",
            story_group_student_path(@story_group, student),
            method: :delete,
            data: { confirm: "Are you sure?" }

%hr

%h3 Add Student

= form_with url: story_group_students_path(@story_group), scope: :story_group_student, method: :post do |f|
  .field
    = f.label :user_id, "Select student"
    %br
    = f.select :user_id,
      options_from_collection_for_select( students(@current_user),
        :id,
        :email,
      ),
      { prompt: "Choose a user" },
      { data: { controller: "tom-select", tom_select_options_value: student_map(@current_user).to_json} }

  .actions
    = f.submit "Add Student"

%p
  = link_to "Back", story_group_path(@story_group)
