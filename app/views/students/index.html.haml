- content_for :title, t('.title')

%section.gh-panel.gh-page-header
  .gh-page-header-text
    %h1.gh-h1= t('.title')
    %p.gh-lead= student_list_lead(@list)

  .gh-button-row
    = link_to story_group_invites_path(@story_group), class: 'gh-btn gh-btn--secondary' do
      %i.fa-solid.fa-qrcode{ 'aria-hidden': 'true' }
      = t('.invites')
    = link_to quick_story_group_invites_path(@story_group), class: 'gh-btn',
                                                            data:  { turbo_frame: 'modal' } do
      %i.fa-solid.fa-eye{ 'aria-hidden': 'true' }
      = t('.show_code')

- if @list.any?
  %div{data: { controller:              'list-search',
               list_search_total_value: @list.size,
               list_search_of_value:    t('.of'),  }}
    .gh-student-list-toolbar
      %label.gh-search-input
        %i.fa-solid.fa-magnifying-glass{ 'aria-hidden': 'true' }
        %input{type:         'search',
               placeholder:  t('.search'),
               'aria-label': t('.search'),
               data:         { list_search_target: 'input', action: 'input->list-search#filter' },}
      %span.gh-card-meta{ data: { list_search_target: 'count' } }
        = t('.count', shown: @list.size, total: @list.size)

    %section.gh-panel.gh-student-list-panel
      %ul.gh-student-rows{ role: 'list' }
        %li.gh-student-row.gh-student-row--header{ 'aria-hidden': 'true' }
          %span= t('.columns.student')
          %span= t('.columns.rank')
          %span= t('.columns.lives')
          %span= t('.columns.balance')
          %span= t('.columns.total')
          %span= t('.columns.badges')
          %span.gh-ledger-cell--right= t('.columns.actions')

        = render partial: 'students/row', collection: @list.rows, as: :row

    %section.gh-panel.gh-empty-state{ hidden: true, data: { list_search_target: 'empty' } }
      %h2.gh-h2
        = t('.no_match')
        %span{ data: { list_search_target: 'emptyQuery' } }
      %p.gh-lead= t('.no_match_hint')
- else
  %section.gh-panel.gh-empty-state
    %h2.gh-h2= t('.empty_title')
    %p.gh-lead= t('.empty_body')
    .gh-button-row
      = link_to t('.invites'), story_group_invites_path(@story_group), class: 'gh-btn'
      = link_to quick_story_group_invites_path(@story_group), class: 'gh-btn gh-btn--secondary',
                                                              data:  { turbo_frame: 'modal' } do
        %i.fa-solid.fa-eye{ 'aria-hidden': 'true' }
        = t('.show_code')
