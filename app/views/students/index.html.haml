- content_for :title, t('.title')

%section.gh-panel.gh-page-header
  .gh-page-header-text
    %h1.gh-h1= t('.title')
    %p.gh-lead= student_list_lead(@list)

  .gh-button-row
    = link_to story_group_invites_path(@story_group), class: 'gh-btn gh-btn--secondary' do
      %i.fa-solid.fa-qrcode{ 'aria-hidden': 'true' }
      = t('.invites')
    = link_to quick_story_group_invites_path(@story_group),
              class: 'gh-btn',
              data:  { turbo_frame: 'modal' } do
      %i.fa-solid.fa-eye{ 'aria-hidden': 'true' }
      = t('.show_code')
    - import_link_options = { class: 'gh-btn gh-btn--secondary', data: { turbo_frame: 'modal' } }
    = link_to new_import_story_group_students_path(@story_group), import_link_options do
      %i.fa-solid.fa-file-import{ 'aria-hidden': 'true' }
      = t('shared.actions.import_csv')

- if @list.any?
  %div{data: { controller:                    'list-search filter-pane',
               list_search_total_value:       @list.size,
               list_search_of_value:          t('.of'),
               filter_pane_remove_label_value: t('.filters.remove'), }}
    .gh-student-list-toolbar
      %label.gh-search-input
        %i.fa-solid.fa-magnifying-glass{ 'aria-hidden': 'true' }
        %input{type:         'search',
               placeholder:  t('.search'),
               'aria-label': t('.search'),
               data:         { list_search_target: 'input', action: 'input->list-search#filter' },}
      - filter_groups = student_filter_groups(@list)
      - if filter_groups.any?
        %button.gh-btn.gh-btn--secondary.gh-btn--small{ type: 'button', 'aria-expanded': 'false',
                                                        'aria-controls': 'student-filters',
                                                        data: { filter_pane_target: 'toggle',
                                                                action:             'filter-pane#toggle', } }
          %i.fa-solid.fa-sliders{ 'aria-hidden': 'true' }
          = t('.filters.button')
          %span.gh-filter-count{ hidden: true, data: { filter_pane_target: 'count' } }
      %span.gh-card-meta{ data: { list_search_target: 'count' } }
        = t('.count', shown: @list.size, total: @list.size)

    - if filter_groups.any?
      .gh-filter-summary{ hidden: true, data: { filter_pane_target: 'summary' } }
        %span.gh-filter-summary-chips{ data: { filter_pane_target: 'chips' } }
        %button.gh-link-button{ type: 'button', data: { action: 'filter-pane#clear' } }= t('.filters.clear')

      %section#student-filters.gh-panel.gh-student-filters{ hidden: true, data: { filter_pane_target: 'pane' } }
        .gh-student-filters-grid
          - filter_groups.each do |key, options|
            = render 'filter_chips', key: key, options: options, selected: @selected[key]
        .gh-student-filters-footer
          %button.gh-link-button{ type: 'button', data: { action: 'filter-pane#clear' } }= t('.filters.clear_all')

    %section.gh-panel.gh-student-list-panel
      %ul.gh-student-rows{ role: 'list' }
        %li.gh-student-row.gh-student-row--header{ 'aria-hidden': 'true' }
          %span= t('.columns.student')
          %span= t('.columns.rank')
          %span= t('.columns.lives')
          %span= t('.columns.balance')
          %span= t('.columns.total')
          %span= t('.columns.badges')
          %span.gh-ledger-cell--right= t('.columns.actions')

        = render partial: 'students/row',
                 collection: @list.rows,
                 as: :row, locals: { story_group: @story_group }


    %section.gh-panel.gh-empty-state{ hidden: true, data: { list_search_target: 'empty' } }
      %h2.gh-h2
        = t('.no_match')
        %span{ data: { list_search_target: 'emptyQuery' } }
      %p.gh-lead= t('.no_match_hint')
- else
  %section.gh-panel.gh-empty-state
    %h2.gh-h2= t('.empty_title')
    %p.gh-lead= t('.empty_body')
    .gh-button-row
      = link_to t('.invites'), story_group_invites_path(@story_group), class: 'gh-btn'
      = link_to quick_story_group_invites_path(@story_group), class: 'gh-btn gh-btn--secondary',
                                                              data:  { turbo_frame: 'modal' } do
        %i.fa-solid.fa-eye{ 'aria-hidden': 'true' }
        = t('.show_code')
