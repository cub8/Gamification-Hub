-# Studenci. Mockup: #/t/students, js-expanded/30-lists.js:45-48.
- content_for :title, 'Studenci'

%section.gh-panel.gh-phead
  .gh-phead-t
    %h1.gh-h1 Studenci
    %p.gh-lead= student_list_lead(@list)

  .gh-rowb
    = link_to story_group_invites_path(@story_group), class: 'gh-btn gh-btn--sec' do
      %i.fa-solid.fa-qrcode{ 'aria-hidden': 'true' }
      Kody i zaproszenia
    -# "Dodaj studenta" picks an existing account rather than inviting one, and
    -# that screen is still on the Bootstrap layout — so it is a plain
    -# navigation, not a dialog: its markup would not survive this one.
    = link_to new_story_group_student_path(@story_group), class: 'gh-btn' do
      %i.fa-solid.fa-plus{ 'aria-hidden': 'true' }
      Dodaj studenta

- if @list.any?
  %div{ data: { controller: 'list-search',
                list_search_total_value: @list.size,
                list_search_of_value: 'z' } }
    .gh-stbar
      %label.gh-search
        %i.fa-solid.fa-magnifying-glass{ 'aria-hidden': 'true' }
        %input{ type: 'search',
                placeholder: 'Szukaj studenta',
                'aria-label': 'Szukaj studenta',
                data: { list_search_target: 'input', action: 'input->list-search#filter' } }
      %span.gh-meta{ data: { list_search_target: 'count' } }
        = "#{@list.size} z #{@list.size}"

    %section.gh-panel.gh-st
      %ul.gh-srows{ role: 'list' }
        -# A header for the grid below, not a <thead>: hidden on a phone, where
        -# each cell carries its own label instead.
        %li.gh-srow.gh-srow--h{ 'aria-hidden': 'true' }
          %span Student
          %span Ranga
          %span Życia
          %span Do wydania
          %span Zebrane
          %span Odznaki
          %span.gh-lrow-r Akcje

        = render partial: 'students/row', collection: @list.rows, as: :row

    -# Revealed by the controller when the query matches nobody on the page.
    %section.gh-panel.gh-gm{ hidden: true, data: { list_search_target: 'empty' } }
      %h2.gh-h2
        Brak studentów o nazwie
        %span{ data: { list_search_target: 'emptyQuery' } }
      %p.gh-lead Wyczyść wyszukiwanie albo sprawdź pisownię.
- else
  -# The mockup has no empty state here. House rule: name the next action.
  %section.gh-panel.gh-gm
    %h2.gh-h2 Nie ma jeszcze nikogo w grupie
    %p.gh-lead
      Wyślij studentom kod albo zaproszenie — kiedy dołączą, pojawią się tutaj
      razem z rangą, walutą i życiami.
    .gh-rowb
      = link_to 'Kody i zaproszenia', story_group_invites_path(@story_group), class: 'gh-btn'
