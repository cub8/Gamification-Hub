%h2 Students

%table.table
  %thead
    %tr
      %th Email
      %th Lives
      %th Current currency
      %th Total currency
      %th
      %th
      %th
      %th
      %th
      %th
  %tbody
    - @students.each do |student|
      %tr
        %td= student.user.email
        %td= student.lives
        %td= student.current_currency
        %td= student.total_currency
        %td
          = link_to "Show",
            story_group_student_path(@story_group, student)
        %td
          = button_to "Grant Life",
            update_lives_story_group_student_path(@story_group, student, change: 1),
            method: :post
        %td
          = button_to "Take Life",
            update_lives_story_group_student_path(@story_group, student, change: -1),
            method: :post
        %td
          = link_to "Edit",
            edit_story_group_student_path(@story_group, student)
        %td
          = link_to "Manage badges",
            story_group_student_badges_path(@story_group, student)
        %td
          = link_to "Transactions",
            story_group_student_currency_transactions_path(@story_group, student)
        %td
          = link_to "Adjust currency",
            new_story_group_student_currency_adjustment_path(@story_group, student)
        %td
          = button_to "Remove",
            story_group_student_path(@story_group, student),
            method: :delete,
            data: { confirm: "Are you sure?" }
      - if defined?(@failed_student_id) && student.id == @failed_student_id && @student.errors.any?
        %tr
          %td{ colspan: 10 }
            .errors{ style: "color: red; margin-bottom: 1em; display: flex" }
              %ul
                - @student.errors.full_messages.each do |message|
                  %li= message

%p
  = link_to "Add Student",
    new_story_group_student_path(@story_group)
  |
  = link_to "Back", story_group_path(@story_group)
