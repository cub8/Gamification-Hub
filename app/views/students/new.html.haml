%h3 Add Student

- if @student.errors.any?
  .errors{ style: "color: red; margin-bottom: 1em;" }
    %ul
      - @student.errors.full_messages.each do |message|
        %li= message

= form_with model: @student do |f|
  .field.w-25
    = f.label :user_id, "Select student"
    = f.select :user_id,
        options_from_collection_for_select(@students,:id, :email, @student.user_id),
        { prompt: "Choose a user" },
        { data: { controller: "tom-select-user", tom_select_options_value: student_map(@students).to_json} }

  .actions
    = f.submit "Add Student"

%p
  = link_to "Back", story_group_students_path(@story_group)
