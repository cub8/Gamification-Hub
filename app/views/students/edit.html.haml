- content_for :title, "Edit Lives — #{@student.full_name}"

.dark-page
  .row.justify-content-center
    .col-12.col-md-8.col-lg-6
      %h1.sg-form-title Edit Lives

      - if @student.errors.any?
        .sg-errors
          %h2 Please fix the following errors:
          %ul
            - @student.errors.full_messages.each do |message|
              %li= message

      = form_with model: @student, url: story_group_student_path(@story_group, @student), method: :patch do |f|
        .sg-section
          .sg-section-title
            = @student.full_name
            %small.text-dimmed.fw-normal.ms-2= @student.email

          .sg-form-group
            = f.label :lives, "Lives"
            = f.number_field :lives, class: "form-control", min: 0

        .sg-form-actions
          = link_to "Cancel", story_group_students_path(@story_group), class: "sg-btn-cancel"
          = f.submit "Save", class: "sg-btn-submit"
