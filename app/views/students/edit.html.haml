- content_for :title, t('.page_title', name: @student.display_name)

- if @in_modal
  = turbo_frame_tag 'modal' do
    = render 'form',
             student:     @student,
             story_group: @story_group,
             in_modal:    @in_modal
- else
  %section.gh-panel.gh-dialog-page-panel
    = render 'form',
             student:     @student,
             story_group: @story_group,
             in_modal:    @in_modal
