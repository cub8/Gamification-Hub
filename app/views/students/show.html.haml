-# Student: szczegóły. Mockup: #/t/student, js-expanded/30-student.js:19-35.
-#
-# A PAGE, not a dialog — the mockup's own shape, and the three tabs need the
-# width. The quick actions on it (przyznaj, koryguj, edytuj) are the dialogs.
-# The real name in the title, the avatar, the breadcrumb and the h1 — the
-# mockup's own choice (30-student.js:20). The nickname is not dropped, it moves
-# to the sub-line, so a teacher can see what this student calls themselves in
-# the ranking without it standing in for who they are.
- content_for :title, @student.full_name
- name = @student.full_name

%section.gh-panel.gh-student-page
  .gh-student-page-header
    %span.gh-avatar.gh-octagon-clip{ 'data-gh-h': gh_avatar_hue(name), 'aria-hidden': 'true' }= gh_initials(name)
    %div
      %p.gh-breadcrumbs
        = link_to 'Studenci', story_group_students_path(@story_group)
        %i.fa-solid.fa-chevron-right{ 'aria-hidden': 'true' }
        %span= name
      %h1.gh-h1= name
      %p.gh-student-page-subtitle= student_sheet_subtitle(@student)

    .gh-button-row
      = link_to new_story_group_student_badge_path(@story_group, @student), class: 'gh-btn',
        data: { turbo_frame: 'modal' } do
        %i.fa-solid.fa-award{ 'aria-hidden': 'true' }
        Przyznaj odznakę
      = link_to new_story_group_student_currency_adjustment_path(@story_group, @student),
        class: 'gh-btn gh-btn--secondary', data: { turbo_frame: 'modal' } do
        %i.fa-solid.fa-coins{ 'aria-hidden': 'true' }
        Koryguj walutę
      = link_to edit_story_group_student_path(@story_group, @student),
        class: 'gh-btn gh-btn--secondary', data: { turbo_frame: 'modal' } do
        %i.fa-solid.fa-pen{ 'aria-hidden': 'true' }
        Edytuj

  %dl.gh-student-stats
    .gh-student-stat
      %dt Ranga
      %dd
        = @sheet.rank&.name || '—'
        - if (line = student_rank_progress_line(@sheet))
          %small= line
      - if (progress = @sheet.rank_progress)
        .gh-progress-bar.gh-octagon-clip{ role: 'progressbar', 'aria-valuemin': 0, 'aria-valuemax': 100,
                 'aria-valuenow': progress,
                 'aria-label': "Postęp do rangi #{@sheet.next_rank.name}" }
          %i.gh-octagon-clip{ style: "--gh-p: #{progress}%" }

    .gh-student-stat
      %dt Do wydania
      %dd= @sheet.balance
    .gh-student-stat
      %dt Zebrane łącznie
      %dd= @sheet.total
    .gh-student-stat
      %dt Życia
      %dd
        -# One heart and a number (DECISIONS.md:35).
        %span.gh-lives-badge{ class: ('gh-lives-badge--zero' if @sheet.lives.zero?) }
          %i.fa-solid.fa-heart{ 'aria-hidden': 'true' }
        = @sheet.lives

-# Links carrying aria-current, not role="tab" buttons: these navigate, so the
-# student list's history icon can point straight at one and the choice survives
-# a refresh. Same shape as the group index's tabs.
%nav.gh-group-tabs{ 'aria-label': 'Sekcje studenta' }
  - StudentSheet::TABS.each do |key, label|
    = link_to story_group_student_path(@story_group, @student, tab: key), class: 'gh-group-tab',
      'aria-current': (@tab == key).to_s do
      = label
      %span.gh-count-label= @sheet.count_for(key)

%section.gh-panel.gh-tab-panel
  - case @tab
  - when 'items'
    = render 'students/tab_items', sheet: @sheet
  - when 'hist'
    = render 'students/tab_history', sheet: @sheet, kind: @kind
  - else
    = render 'students/tab_badges', sheet: @sheet
