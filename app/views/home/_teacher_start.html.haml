-# Mockup: #/t/dash, design/mockup-src/js-expanded/30-main.js `viewDash`.
- recent = @dashboard.recent_purchases
- groups = @dashboard.groups

%section.gh-panel.gh-phead
  .gh-phead-t
    %h1.gh-h1 Dzień dobry, #{@current_user.full_name.to_s.split(' ').first}
    %p.gh-lead
      - if recent.any?
        - group_count = @dashboard.recent_group_count
        = "Od wczoraj studenci kupili #{recent.size} #{gh_plural(recent.size, 'przedmiot', 'przedmioty', 'przedmiotów')}"
        = "w #{group_count} #{gh_plural(group_count, 'grupie', 'grupach', 'grupach')}."
      - elsif groups.any?
        Od wczoraj nikt nic nie kupił. Zajrzyj do swoich grup poniżej.
      - else
        Nie prowadzisz jeszcze żadnej grupy. Utwórz pierwszą, żeby zacząć.

.gh-dash
  %section.gh-panel.gh-purch{ 'aria-labelledby': 'gh-purch-title' }
    %h2#gh-purch-title.gh-h2 Ostatnie zakupy

    - if groups.size > 1
      .gh-filters{ role: 'group', 'aria-label': 'Pokaż zakupy z grupy' }
        -# Links, not buttons: filtering is server-side so the choice survives
        -# a refresh and a shared URL.
        = link_to 'Wszystkie grupy', home_path, class: 'gh-fchip',
          'aria-current': @dashboard.filter.nil?.to_s
        - groups.each do |group|
          = link_to home_path(group: group.story_group.id), class: 'gh-fchip',
            'aria-current': (@dashboard.filter == group.story_group.id).to_s do
            = render 'layouts/redesign/group_thumb', story_group: group.story_group
            = group.story_group.name

    - if @dashboard.purchases.any?
      - TeacherStartDashboard::DAYS.each do |day|
        - rows = @dashboard.purchases_on(day)
        - next if rows.empty?
        %h3.gh-day= day
        %ul.gh-plist
          - rows.each do |purchase|
            %li.gh-prow
              = render 'layouts/redesign/item_thumb', item: purchase.item
              %span.gh-p-main
                %b= purchase.item&.name || 'Przedmiot usunięty z oferty'
                %span= purchase.student_name
                %span.gh-p-gm
                  = render 'layouts/redesign/group_chip', story_group: purchase.story_group
              %span.gh-p-g
                = render 'layouts/redesign/group_chip', story_group: purchase.story_group
              %span.gh-cost
                %b= purchase.price
                = render 'layouts/redesign/currency_token', story_group: purchase.story_group, size: 16
              %span.gh-p-time= purchase.time
    - else
      %p.gh-small.mt-4
        - if @dashboard.filter
          W tej grupie nie ma jeszcze żadnych zakupów.
        - else
          Nikt jeszcze niczego nie kupił. Zakupy pojawią się tutaj same.

  .gh-dash-side
    - if @dashboard.pending
      - pending = @dashboard.pending
      %section.gh-card.gh-todo
        .gh-card-f
          .gh-card-i
            %p.gh-k Czeka na ocenę
            %h2.gh-todo-t= pending.activity_group.name
            = render 'layouts/redesign/group_chip', story_group: pending.story_group
            %p.gh-small
              = "Zostało #{pending.categories_count} #{gh_plural(pending.categories_count, 'kategoria', 'kategorie', 'kategorii')}"
              = "dla #{pending.students_count} #{gh_plural(pending.students_count, 'studenta', 'studentów', 'studentów')}."
            = link_to 'Oceń',
              edit_story_group_activity_group_students_activity_group_categories_path(pending.story_group, pending.activity_group),
              class: 'gh-btn'

    %section.gh-panel.gh-mygroups
      %h2.gh-h2 Twoje grupy
      - if groups.any?
        %ul.gh-gtl
          - groups.each do |group|
            %li
              = link_to story_group_path(group.story_group), class: 'gh-gt' do
                = render 'layouts/redesign/group_thumb', story_group: group.story_group, size: :lg
                %span
                  %b= group.story_group.name
                  %small
                    = "#{group.role}, #{group.students_count} #{gh_plural(group.students_count, 'student', 'studentów', 'studentów')}"
                - if group.new_purchases.positive?
                  %span.gh-gt-new
                    = "#{group.new_purchases} #{gh_plural(group.new_purchases, 'nowy zakup', 'nowe zakupy', 'nowych zakupów')}"
      - else
        %p.gh-small Nie prowadzisz jeszcze żadnej grupy.

      = link_to new_story_group_path, class: 'gh-btn gh-btn--sec', data: { turbo_frame: 'modal' } do
        %i.fa-solid.fa-plus
        Utwórz grupę
