- organizations = @dashboard.organizations

%section.gh-panel.gh-page-header
  .gh-page-header-text
    %h1.gh-h1= home_greeting(@current_user)
    %p.gh-lead
      - if organizations.empty?
        = t('.no_organizations_lead')
      - elsif @dashboard.attention?
        = t('.attention_lead', count: organizations.size)
      - else
        = t('.fine_lead', count: organizations.size)

  = link_to new_organization_path, class: 'gh-btn', data: { turbo_frame: 'modal' } do
    %i.fa-solid.fa-plus{ 'aria-hidden': 'true' }
    = t('.create')

- if organizations.any?
  = render 'stat_tiles', tiles: @dashboard.stat_tiles, label: t('.stats_label')

  .gh-dashboard-layout
    %section.gh-panel.gh-recent-purchases-panel{ 'aria-labelledby': 'gh-orgs-title' }
      %h2#gh-orgs-title.gh-h2= t('.organizations')
      .gh-start-org-list
        - organizations.each do |org|
          = link_to organization_path(org.organization), class: 'gh-start-org-row' do
            %span.gh-name-cell
              %b= org.organization.name
              %small
                = t('.admins', count: org.admins)
                - if org.pending_admins.positive?
                  = "· #{t('.pending_admins', count: org.pending_admins)}"
            = render 'capacity_bar', members: org.member_count, max: org.organization.max_members,
                                     percent: org.fill_percent, full: org.full?
      = link_to t('.all_organizations'), organizations_path, class: 'gh-btn gh-btn--secondary gh-start-more'

    .gh-dashboard-side-column
      - if @dashboard.attention?
        %section.gh-card.gh-todo-card
          .gh-card-frame
            .gh-card-inset
              %p.gh-page-kicker= t('.attention')
              %ul.gh-start-attention-list
                - @dashboard.without_admin.each do |org|
                  %li
                    = link_to org.organization.name, organization_path(org.organization)
                    %small= t('.no_admin')
                    = link_to new_admin_organization_path(org.organization), class: 'gh-btn gh-btn--secondary gh-btn--small',
                      data: { turbo_frame: 'modal' } do
                      %i.fa-solid.fa-user-shield{ 'aria-hidden': 'true' }
                      = t('.add')
                - @dashboard.nearly_full.each do |org|
                  %li
                    = link_to org.organization.name, organization_path(org.organization)
                    %small= org.full? ? t('.no_free_seats') : t('.free_seats', count: org.free)
                    = link_to edit_organization_path(org.organization), class: 'gh-btn gh-btn--secondary gh-btn--small',
                      data: { turbo_frame: 'modal' } do
                      %i.fa-solid.fa-pen{ 'aria-hidden': 'true' }
                      = t('.limit')
      - else
        %section.gh-panel.gh-my-groups-panel
          %h2.gh-h2= t('.fine_title')
          %p.gh-small= t('.fine_body')

      %section.gh-panel.gh-my-groups-panel
        %h2.gh-h2= t('.how_title')
        %p.gh-small= t('.how_body', usos: Organization::USOS_NAME)
- else
  %section.gh-panel.gh-empty-state
    %h2.gh-h2= t('.empty_title')
    %p.gh-lead= t('.empty_lead')
    .gh-button-row
      = link_to t('.create'), new_organization_path, class: 'gh-btn', data: { turbo_frame: 'modal' }
