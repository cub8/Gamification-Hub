- organization = @dashboard.organization

- if organization.nil?
  %section.gh-panel.gh-empty-state
    %h1.gh-h1= home_greeting(@current_user)
    %p.gh-lead
      Twoje konto administratora nie jest przypisane do żadnej organizacji.
      Skontaktuj się z administratorem systemu.
- else
  %section.gh-panel.gh-page-header
    .gh-page-header-text
      %p.gh-page-kicker= organization.name
      %h1.gh-h1= home_greeting(@current_user)
      %p.gh-lead
        - if @dashboard.full?
          Organizacja nie ma wolnych miejsc — nowe osoby nie dołączą, dopóki
          ktoś nie zostanie usunięty albo limit nie wzrośnie.
        - elsif @dashboard.pending_users.any?
          - pending = @dashboard.pending_users.size
          = "#{pending} #{gh_plural(pending, 'osoba jeszcze nie przyjęła', 'osoby jeszcze nie przyjęły', 'osób jeszcze nie przyjęło')} zaproszenia."
        - else
          = organization_capacity_lead(organization, @dashboard.members)

    .gh-button-row
      = link_to organization_path(organization), class: 'gh-btn gh-btn--secondary' do
        %i.fa-solid.fa-users{ 'aria-hidden': 'true' }
        Użytkownicy
      = link_to new_user_organization_path(organization), class: 'gh-btn', data: { turbo_frame: 'modal' } do
        %i.fa-solid.fa-user-plus{ 'aria-hidden': 'true' }
        Dodaj użytkownika

  = render 'stat_tiles', tiles: @dashboard.stat_tiles, label: 'Podsumowanie organizacji'

  .gh-dashboard-layout
    %section.gh-panel.gh-recent-purchases-panel{ 'aria-labelledby': 'gh-recent-users-title' }
      %h2#gh-recent-users-title.gh-h2 Ostatnio dodani
      - if @dashboard.recent_users.any?
        .gh-start-org-list
          - @dashboard.recent_users.each do |user|
            .gh-start-org-row
              = render 'organizations/person', user: user
              %span.gh-teacher-role
                = user_role_label(user.role)
                %small= user.first_login? ? 'Zaproszenie wysłane' : "Dodano #{user.created_at.strftime('%d.%m.%Y')}"
        = link_to 'Wszyscy użytkownicy', organization_path(organization), class: 'gh-btn gh-btn--secondary gh-start-more'
      - else
        %p.gh-small
          Nikogo tu jeszcze nie ma. Dodaj studentów i nauczycieli albo poczekaj,
          aż zalogują się przez uczelnię.

    .gh-dashboard-side-column
      %section.gh-panel.gh-my-groups-panel
        %h2.gh-h2 Miejsca
        = render 'capacity_bar', members: @dashboard.members, max: organization.max_members,
                                 percent: @dashboard.fill_percent, full: @dashboard.full?
        %p.gh-small
          Limit ustala administrator systemu. Każde konto, także administratora,
          zajmuje jedno miejsce.

      - if @dashboard.pending_users.any?
        %section.gh-card.gh-todo-card
          .gh-card-frame
            .gh-card-inset
              %p.gh-page-kicker Czeka na przyjęcie zaproszenia
              %ul.gh-start-attention-list
                - @dashboard.pending_users.first(OrganizationAdminStartDashboard::RECENT_LIMIT).each do |user|
                  %li
                    %span= user.full_name.presence || user.email
                    %small= user.email
