- organization = @dashboard.organization

- if organization.nil?
  %section.gh-panel.gh-empty-state
    %h1.gh-h1= home_greeting(@current_user)
    %p.gh-lead= t('.no_organization')
- else
  %section.gh-panel.gh-page-header
    .gh-page-header-text
      %p.gh-page-kicker= organization.name
      %h1.gh-h1= home_greeting(@current_user)
      %p.gh-lead
        - if @dashboard.full?
          = t('.full_lead')
        - elsif @dashboard.pending_users.any?
          = t('.pending_lead', count: @dashboard.pending_users.size)
        - else
          = organization_capacity_lead(organization, @dashboard.member_count)

    .gh-button-row
      = link_to organization_path(organization), class: 'gh-btn gh-btn--secondary' do
        %i.fa-solid.fa-users{ 'aria-hidden': 'true' }
        = t('.users')
      = link_to new_user_organization_path(organization), class: 'gh-btn', data: { turbo_frame: 'modal' } do
        %i.fa-solid.fa-user-plus{ 'aria-hidden': 'true' }
        = t('.add_user')

  = render 'stat_tiles', tiles: @dashboard.stat_tiles, label: t('.stats_label')

  .gh-dashboard-layout
    %section.gh-panel.gh-recent-purchases-panel{ 'aria-labelledby': 'gh-recent-users-title' }
      %h2#gh-recent-users-title.gh-h2= t('.recent')
      - if @dashboard.recent_users.any?
        .gh-start-org-list
          - @dashboard.recent_users.each do |user|
            .gh-start-org-row
              = render 'organizations/person', user: user
              %span.gh-teacher-role
                = user_role_label(user.role)
                %small= user.first_login? ? t('.invited') : t('.added', when: gh_when(user.created_at))
        = link_to t('.all_users'), organization_path(organization), class: 'gh-btn gh-btn--secondary gh-start-more'
      - else
        %p.gh-small= t('.nobody')

    .gh-dashboard-side-column
      %section.gh-panel.gh-my-groups-panel
        %h2.gh-h2= t('.seats')
        = render 'capacity_bar', members: @dashboard.member_count, max: organization.max_members,
                                 percent: @dashboard.fill_percent, full: @dashboard.full?
        %p.gh-small
          - if organization.unlimited?
            = t('.unlimited_note')
          - else
            = t('.limited_note')

      - if @dashboard.pending_users.any?
        %section.gh-card.gh-todo-card
          .gh-card-frame
            .gh-card-inset
              %p.gh-page-kicker= t('.pending_title')
              %ul.gh-start-attention-list
                - @dashboard.pending_users.first(Dashboard::OrganizationAdmin::RECENT_LIMIT).each do |user|
                  %li
                    %span= user.full_name.presence || user.email
                    %small= user.email
