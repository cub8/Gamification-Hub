- groups = @dashboard.groups

%section.gh-panel.gh-page-header
  .gh-page-header-text
    %h1.gh-h1= t('.greeting', name: @current_user.full_name.to_s.split(' ').first)
    %p.gh-lead= groups.any? ? t('.groups_lead', count: groups.size) : t('.no_groups_lead')

.gh-group-card-grid
  - groups.each do |group|
    - story_group = group.story_group
    %article.gh-card.gh-card--neutral.gh-gcard
      .gh-card-frame
        .gh-card-inset
          .gh-card-art
            - cover = gh_group_cover(story_group)
            = cover
            - unless cover
              %i.fa-solid.fa-book-open{ 'aria-hidden': 'true' }

          .gh-card-header
            %h2.gh-card-name= story_group.name

          - if group.fresh?
            %p.gh-explainer-note= t('.fresh', currency: story_group.currency_name)

          %dl.gh-group-card-stats
            %div
              %dt= t('.to_spend')
              %dd
                = render 'layouts/currency_token', story_group: story_group
                = group.balance
                %small= story_group.currency_name

            %div
              %dt= t('.lives')
              %dd
                %span.gh-lives-badge{ class: ('gh-lives-badge--zero' if group.lives.zero?) }
                  %i.fa-solid.fa-heart{ 'aria-hidden': 'true' }
                  = group.lives

            .gh-stat-span-full
              %dt
                = t('.rank')
                %b= group.rank&.name || t('.no_rank')
              - if group.next_rank
                %dd.gh-rank-progress-target
                  = t('.to_next', total: group.total, needed: group.next_threshold, rank: group.next_rank.name)
              - else
                %dd.gh-rank-progress-target= t('.top', total: group.total)
              .gh-progress-bar.gh-octagon-clip{ role: 'progressbar',
                       'aria-valuemin': 0,
                       'aria-valuemax': group.next_threshold.positive? ? group.next_threshold : group.total,
                       'aria-valuenow': group.total,
                       'aria-label': t('.progress_label', name: story_group.name) }
                %i.gh-octagon-clip{ style: "--gh-p: #{gh_percent(group.total, group.next_threshold)}%" }

            %div
              %dt= t('.badges')
              %dd
                = group.badges_earned
                %small= t('.badges_of', total: group.badges_total)

          .gh-card-footer
            = link_to t('.open_group'), story_group_path(story_group), class: 'gh-btn'
            = link_to story_group_shop_index_path(story_group), class: 'gh-btn gh-btn--secondary' do
              %i.fa-solid.fa-bag-shopping
              = t('.shop')

  .gh-panel.gh-join-code-card
    %h2.gh-h3= t('.have_code')
    %p.gh-small= t('.code_hint')
    = link_to new_join_path, class: 'gh-btn gh-btn--secondary', data: { turbo_frame: 'modal' } do
      %i.fa-solid.fa-plus
      = t('.join')

- if @dashboard.feed.any?
  %section.gh-panel.gh-activity-feed
    %h2.gh-h2= t('.feed')
    %ul.gh-ledger-list
      - @dashboard.feed.each do |entry|
        - tone = entry.reward? ? 'earn' : (entry.purchase? ? 'spend' : nil)
        %li.gh-activity-feed-row
          %span{ class: "gh-activity-feed-row-marker #{"gh-activity-feed-row-marker--#{tone}" if tone}", 'aria-hidden': 'true' }
          %span.gh-activity-feed-row-text
            = gh_feed_title(entry)
            %small= t('.feed_meta', group: entry.student.story_group.name, when: gh_when(entry.created_at))
          %span{ class: "gh-activity-feed-row-amount #{"gh-activity-feed-row-amount--#{tone}" if tone}" }
            = entry.amount.positive? ? "+#{entry.amount}" : entry.amount
