- content_for :title, t('.title')

= link_to login_path, class: 'gh-link-button gh-back-link' do
  %i.fa-solid.fa-chevron-left
  %span= t('.back')

%h1.gh-h1= t('.title')
%p.gh-lead= t('.lead')

= form_with url: auth_passwordless_path, method: :post do |f|
  .gh-form-field
    = f.label :email, t('.email')
    .gh-text-input
      = f.email_field :email,
        placeholder: t('.placeholder'),
        autocomplete: 'email',
        autofocus: true,
        required: true

  .gh-button-stack
    %button.gh-btn{ type: 'submit' }= t('.send')

= render 'shared/register_prompt'
