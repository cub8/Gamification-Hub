%h1.fs-2 Logowanie adresem e-mail

= form_with url: auth_passwordless_path, method: :post, class: 'w-75' do |f|
  %div.d-block.sg-form-group.mb-2
    = f.email_field :email, placeholder: 'jan.nowak@example.com', class: 'form-control'
  = f.submit 'Kontynuuj', class: 'btn btn-primary w-100 fw-medium'

= link_to 'Cofnij', login_path, class: 'btn-link text-dimmed'
