- content_for :title, 'Logowanie e-mailem'

= link_to login_path, class: 'gh-linkbtn gh-back' do
  %i.fa-solid.fa-chevron-left
  %span Inne sposoby logowania

%h1.gh-h1 Logowanie e-mailem
%p.gh-lead Wyślemy Ci link do logowania. Hasło nie jest potrzebne.

= form_with url: auth_passwordless_path, method: :post do |f|
  .gh-fld
    = f.label :email, 'Adres e-mail'
    .gh-inp
      = f.email_field :email,
        placeholder: 'jan.nowak@example.com',
        autocomplete: 'email',
        autofocus: true,
        required: true

  .gh-stack
    %button.gh-btn{ type: 'submit' } Wyślij link

%p.gh-alt
  Nie masz konta?
  %button.gh-linkbtn{ type: 'button' } Zarejestruj się
