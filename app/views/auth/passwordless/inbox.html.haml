- content_for :title, t('.title')
- waiting_label = t('.waiting', time: '%{time}')
- idle_label    = t('.resend')

.text-center
  .gh-icon-circle-lg.gh-octagon-clip.mx-auto
    %i.fa-solid.fa-envelope
  %h1.gh-h1= t('.title')
  %p.gh-lead.mx-auto= t('.sent_to')
  %p.gh-email-display= @email
  %p.gh-small.mt-4
    = t('.valid_for', minutes: gh_minutes(LoginToken::EXPIRES_IN.in_minutes.to_i))
    = t('.spam')

  .gh-button-stack
    = button_to auth_passwordless_path,
      params: { email: @email },
      disabled: @cooldown.positive?,
      class: 'gh-btn gh-btn--secondary',
      data: { countdown_target: 'button' },
      form: { data: { controller: 'countdown',
                      countdown_seconds_value: @cooldown,
                      countdown_idle_label_value: idle_label,
                      countdown_waiting_label_value: waiting_label } } do
      - if @cooldown.positive?
        = waiting_label.sub('%{time}', gh_mmss(@cooldown))
      - else
        = idle_label

    = link_to t('.change_email'), new_auth_passwordless_path, class: 'gh-link-button'
