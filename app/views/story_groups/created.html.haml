- content_for :title, t('.page_title', name: @story_group.name)
- quick = @counts.values.any?(&:positive?)
- created_parts = %i[ranks badges items categories].map { |key| t(".#{key}", count: @counts[key]) }

%section.gh-panel.gh-wizard-success-panel
  .gh-wizard-success-icon.gh-octagon-clip
    %i.fa-solid.fa-check{ 'aria-hidden': 'true' }

  %h1.gh-h1= t('.title', name: @story_group.name)

  %p.gh-lead
    - if quick
      = t('.quick_lead', list: gh_and_list(created_parts))
    - else
      = t('.empty_lead')

  %p.gh-explainer-note
    %i.fa-solid.fa-qrcode{ 'aria-hidden': 'true' }
    %span= t('.invites_note_html', tab: tag.b(t('.invites_tab')))

  %h2.gh-h3= t('.next')
  %ol.gh-next-steps-list
    - (quick ? t('.quick_steps') : t('.empty_steps')).each do |step|
      %li= step

  .gh-button-row
    = link_to t('.go_to_group'), story_group_path(@story_group), class: 'gh-btn'
    = link_to new_story_group_invite_path(@story_group), class: 'gh-btn gh-btn--secondary' do
      %i.fa-solid.fa-qrcode{ 'aria-hidden': 'true' }
      = t('.create_invite')
