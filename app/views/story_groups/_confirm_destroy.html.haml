- students = story_group.students.count
- teachers = story_group.teachers.count + 1

%h2#gh-del-group-title.gh-h2= t('.title')
%p
  = t('.lose_access', count:    students + teachers,
                      students: t('.students', count: students),
                      teachers: t('.teachers', count: teachers))
  = t('.gone')

= form_with url: story_group_path(story_group), method: :delete,
  data: { controller: 'confirm-name',
          confirm_name_expected_value: story_group.name,
          turbo_frame: (@in_modal ? 'modal' : nil) } do

  .gh-form-field
    = label_tag :confirm do
      = t('.confirm')
      %b= story_group.name
    .gh-text-input{ class: ('gh-text-input--invalid' if @confirm_failed) }
      = text_field_tag :confirm, nil, autocomplete: 'off', autofocus: true,
        'aria-invalid': (@confirm_failed ? 'true' : nil),
        'aria-describedby': (@confirm_failed ? 'gh-del-group-error' : nil),
        data: { confirm_name_target: 'input', action: 'confirm-name#check' }
    - if @confirm_failed
      %p#gh-del-group-error.gh-field-error{ role: 'alert' }
        %i.fa-solid.fa-triangle-exclamation{ 'aria-hidden': 'true' }
        %span= t('.mismatch')

  .gh-dialog-button-row
    - if @in_modal
      %button.gh-btn.gh-btn--secondary{ type: 'button', data: { action: 'dialog#close' } }= t('shared.actions.cancel')
    - else
      = link_to t('shared.actions.cancel'), edit_story_group_path(story_group), class: 'gh-btn gh-btn--secondary'

    %button.gh-btn{ type: 'submit', disabled: true,
                    data: { confirm_name_target: 'submit' } }
      = t('.remove')
