- error  = ->(attribute) { story_group.errors[attribute].first }
- packs  = StarterPack

- steps = t('.steps')

.gh-wizard{ data: { controller: 'group-wizard',
                    action: 'gh:image-crop->group-wizard#art',
                    group_wizard_preset_url_value: preset_preview_story_groups_path,
                    group_wizard_i18n_value: t('.js').to_json } }

  %section.gh-panel.gh-page-header.gh-page-header--stacked
    %p.gh-breadcrumbs
      = link_to t('.breadcrumb'), story_groups_path
      %i.fa-solid.fa-chevron-right{ 'aria-hidden': 'true' }
      %span= t('.title')
    %h1.gh-h1= t('.title')
    %p.gh-lead= t('.lead')

    %nav.gh-wizard-steps{ 'aria-label': t('.steps_label') }
      - steps.each_with_index do |label, index|
        %button.gh-wizard-step-tab{ type: 'button', disabled: index.positive?,
                        'aria-current': (index.zero? ? 'step' : nil),
                        class: ('gh-wizard-step-tab--current' if index.zero?),
                        data: { group_wizard_target: 'stepTab',
                                group_wizard_index_param: index,
                                action: 'group-wizard#goto' } }
          %span.gh-wizard-step-number.gh-octagon-clip
            %span{ data: { group_wizard_target: 'stepNum' } }= index + 1
            %i.fa-solid.fa-check{ 'aria-hidden': 'true', hidden: true,
                                  data: { group_wizard_target: 'stepTick' } }
          %span{ data: { group_wizard_target: 'stepLabel' } }= label

  = form_with model: story_group, data: { group_wizard_target: 'form',
                                          action: 'keydown->group-wizard#keydown' } do |f|

    - if story_group.errors[:base].any?
      %p.gh-field-error{ role: 'alert' }
        %i.fa-solid.fa-triangle-exclamation{ 'aria-hidden': 'true' }
        %span= story_group.errors[:base].first

    .gh-form-shell{ data: { group_wizard_target: 'grid' } }
      %section.gh-panel.gh-form-column

        %section{ data: { group_wizard_target: 'panel' } }
          %h2.sr-only= steps[0]

          .gh-form-section.gh-form-section--first
            %h2.gh-h3= t('.name_section')
            %p.gh-field-hint= t('.name_hint')

            .gh-form-field
              = f.label :name, t('.name')
              .gh-text-input{ class: ('gh-text-input--invalid' if error.call(:name)) }
                = f.text_field :name, maxlength: 40, autocomplete: 'off',
                  placeholder: t('.name_placeholder'),
                  'aria-invalid': (error.call(:name) ? 'true' : nil),
                  'aria-describedby': (error.call(:name) ? 'gh-wiz-name-error' : nil),
                  data: { group_wizard_target: 'name', action: 'group-wizard#refresh' }
              %p#gh-wiz-name-error.gh-field-error{ role: 'alert', hidden: error.call(:name).blank?,
                                           data: { group_wizard_target: 'nameError' } }
                %i.fa-solid.fa-triangle-exclamation{ 'aria-hidden': 'true' }
                %span= error.call(:name) || t('.name_missing')

            .gh-form-field
              = f.label :description do
                = t('.story')
                %small= t('shared.actions.optional')
              .gh-text-input{ class: ('gh-text-input--invalid' if error.call(:description)) }
                = f.text_area :description, rows: 4, maxlength: 1024,
                  placeholder: t('.story_placeholder')
              - if error.call(:description)
                %p.gh-field-error{ role: 'alert' }
                  %i.fa-solid.fa-triangle-exclamation{ 'aria-hidden': 'true' }
                  %span= error.call(:description)
              %span.gh-field-hint= t('.story_hint')

          .gh-form-section
            %h2.gh-h3= t('.art_section')
            %p.gh-field-hint= t('.art_hint')

            = render 'shared/image_field', form: f, record: story_group,
              presets: GroupArt::KEYS, registry: GroupArt,
              kind: 'group', tile: :art, refresh_action: 'group-wizard#art',
              copy: { label: t('story_groups.settings.art_label'),
                      hint: t('story_groups.settings.art_hint') }

        %section{ data: { group_wizard_target: 'panel' }, hidden: true }
          %h2.sr-only= steps[1]

          .gh-form-section.gh-form-section--first
            %h2.gh-h3= t('.currency_section')
            %p.gh-field-hint= t('.currency_hint')

            .gh-form-field
              = f.label :currency_name, t('.currency_name')
              .gh-text-input{ class: ('gh-text-input--invalid' if error.call(:currency_name)) }
                = f.text_field :currency_name, maxlength: 40, autocomplete: 'off',
                  placeholder: t('.currency_placeholder'),
                  'aria-invalid': (error.call(:currency_name) ? 'true' : nil),
                  'aria-describedby': (error.call(:currency_name) ? 'gh-wiz-currency-error' : nil),
                  data: { group_wizard_target: 'currency', action: 'group-wizard#refresh' }
              %p#gh-wiz-currency-error.gh-field-error{ role: 'alert',
                                               hidden: error.call(:currency_name).blank?,
                                               data: { group_wizard_target: 'currencyError' } }
                %i.fa-solid.fa-triangle-exclamation{ 'aria-hidden': 'true' }
                %span= error.call(:currency_name) || t('.currency_missing')

            = render 'shared/image_field', form: f, record: story_group,
              attribute: :currency_icon, glyph_attribute: :currency_icon_glyph,
              presets: CurrencyIcons::KEYS, registry: CurrencyIcons,
              kind: 'currency', tile: :currency, aspect: 1,
              refresh_action: 'group-wizard#refresh',
              copy: t('story_groups.currency_icon')

          .gh-form-section
            %h2.gh-h3= t('.lives_section')
            .gh-form-field{ data: { controller: 'lives-stepper', lives_stepper_max_value: 10 } }
              %p#gh-wiz-lives-label.gh-form-label= t('.lives')
              .gh-number-stepper{ role: 'group', 'aria-labelledby': 'gh-wiz-lives-label' }
                %button.gh-number-stepper-button.gh-octagon-clip{ type: 'button', 'aria-label': t('.fewer_lives'),
                                    disabled: story_group.default_lives.to_i.zero?,
                                    data: { lives_stepper_target: 'down',
                                            action: 'lives-stepper#down' } }
                  %i.fa-solid.fa-minus{ 'aria-hidden': 'true' }
                %output{ 'aria-live': 'polite',
                         data: { lives_stepper_target: 'output' } }= story_group.default_lives
                %button.gh-number-stepper-button.gh-octagon-clip{ type: 'button', 'aria-label': t('.more_lives'),
                                    disabled: story_group.default_lives.to_i >= 10,
                                    data: { lives_stepper_target: 'up',
                                            action: 'lives-stepper#up' } }
                  %i.fa-solid.fa-plus{ 'aria-hidden': 'true' }

              = f.hidden_field :default_lives, data: { lives_stepper_target: 'field' }

              - if error.call(:default_lives)
                %p.gh-field-error{ role: 'alert' }
                  %i.fa-solid.fa-triangle-exclamation{ 'aria-hidden': 'true' }
                  %span= error.call(:default_lives)

              %span.gh-field-hint= t('.lives_hint')

          .gh-form-section
            %h2.gh-h3= t('.ranking_section')

            .gh-toggle-switch-row
              = f.check_box :ranking_enabled, class: 'gh-toggle-switch gh-octagon-clip', role: 'switch',
                'aria-labelledby': 'gh-wiz-ranking-label',
                data: { group_wizard_target: 'ranking',
                        action: 'change->group-wizard#refresh' }
              %span
                %b#gh-wiz-ranking-label= t('.ranking')
                %span.gh-field-hint= t('.ranking_hint')

            .gh-form-field{ hidden: !story_group.ranking_enabled?,
                     data: { group_wizard_target: 'rankingMode' } }
              = f.label :ranking_mode, t('.ranking_mode')
              %span.gh-select-input
                = f.select :ranking_mode,
                  StoryGroup.ranking_modes.keys.map { |mode| [StoryGroup.ranking_mode_label(mode), mode] },
                  {}, data: { action: 'group-wizard#refresh' }
                %i.fa-solid.fa-chevron-down{ 'aria-hidden': 'true' }
              %span.gh-field-hint= t('.ranking_mode_hint')

        %section{ data: { group_wizard_target: 'panel' }, hidden: true }
          %h2.sr-only= steps[2]

          .gh-form-section.gh-form-section--first
            %h2.gh-h3= t('.start_section')
            %p.gh-field-hint= t('.start_hint')

            .gh-choice-grid{ role: 'radiogroup', 'aria-label': t('.start_label') }
              %label.gh-choice-card
                = radio_button_tag 'setup[path]', 'quick', false, class: 'sr-only',
                  id: 'gh-wiz-path-quick',
                  data: { group_wizard_target: 'path', action: 'group-wizard#refresh' }
                %span.gh-tag.gh-tag--discount= t('.recommended')
                %b= t('.quick')
                %span= t('.quick_body')
              %label.gh-choice-card
                = radio_button_tag 'setup[path]', 'manual', false, class: 'sr-only',
                  id: 'gh-wiz-path-manual',
                  data: { group_wizard_target: 'path', action: 'group-wizard#refresh' }
                %b= t('.manual')
                %span= t('.manual_body')

            %p.gh-field-error{ role: 'alert', hidden: true,
                       data: { group_wizard_target: 'pathError' } }
              %i.fa-solid.fa-triangle-exclamation{ 'aria-hidden': 'true' }
              %span= t('.path_missing')

          .gh-form-section{ hidden: true, data: { group_wizard_target: 'quickOnly' } }
            %h2.gh-h3= t('.pack_section')
            %p.gh-field-hint= t('.pack_hint')

            .gh-choice-grid{ role: 'radiogroup', 'aria-label': t('.pack_label') }
              - packs::KEYS.each_with_index do |key, index|
                %label.gh-choice-card
                  = radio_button_tag 'setup[pack]', key, index.zero?, class: 'sr-only',
                    id: "gh-wiz-pack-#{key}",
                    data: { group_wizard_target: 'pack', action: 'group-wizard#refresh' }
                  %b= packs.label_for(key)
                  %span= packs.description_for(key)
                  %em= "#{packs.rank_names(key).first(3).join(' → ')} → …"

          .gh-form-section{ hidden: true, data: { group_wizard_target: 'quickOnly' } }
            %h2.gh-h3= t('.classes_section')
            %p.gh-field-hint= t('.classes_hint')

            .gh-form-field
              .gh-number-stepper{ role: 'group', 'aria-label': t('.classes_label') }
                %button.gh-number-stepper-button.gh-octagon-clip{ type: 'button', 'aria-label': t('.fewer_classes'),
                                    data: { group_wizard_target: 'classesDown',
                                            action: 'group-wizard#classesDown' } }
                  %i.fa-solid.fa-minus{ 'aria-hidden': 'true' }
                %output{ 'aria-live': 'polite',
                         data: { group_wizard_target: 'classesOutput' } }= packs::DEFAULT_CLASSES
                %button.gh-number-stepper-button.gh-octagon-clip{ type: 'button', 'aria-label': t('.more_classes'),
                                    data: { group_wizard_target: 'classesUp',
                                            action: 'group-wizard#classesUp' } }
                  %i.fa-solid.fa-plus{ 'aria-hidden': 'true' }

              = hidden_field_tag 'setup[classes]', packs::DEFAULT_CLASSES, id: 'gh-wiz-classes',
                data: { group_wizard_target: 'classes' }

        %section{ data: { group_wizard_target: 'panel' }, hidden: true }
          %h2.sr-only= steps[3]

          .gh-form-section.gh-form-section--first{ hidden: true, data: { group_wizard_target: 'manualSummary' } }
            %h2.gh-h3= t('.summary')
            %p.gh-field-hint= t('.summary_hint')

            %dl.gh-summary-list
              %dt= t('shared.actions.name')
              %dd{ data: { group_wizard_target: 'sumName' } }
              %dt= t('.summary_currency')
              %dd{ data: { group_wizard_target: 'sumCurrency' } }
              %dt= t('.summary_lives')
              %dd{ data: { group_wizard_target: 'sumLives' } }
              %dt= t('.summary_ranking')
              %dd{ data: { group_wizard_target: 'sumRanking' } }

          = turbo_frame_tag 'starter_pack',
            data: { group_wizard_target: 'presetFrame',
                    action: 'turbo:frame-load->group-wizard#refresh' },
            hidden: true

      %aside.gh-preview-column{ 'aria-label': t('shared.actions.preview'), data: { group_wizard_target: 'preview' } }

        %section.gh-panel.gh-preview-panel{ data: { group_wizard_target: 'previewGroup' } }
          %h3= t('.card_preview')
          %article.gh-card.gh-card--neutral.gh-group-index-card
            .gh-card-frame
              .gh-card-inset
                .gh-card-art.gh-art--monogram{ data: { group_wizard_target: 'artBox' } }
                  %span{ data: { group_wizard_target: 'artMono' } }
                .gh-card-header
                  %h2.gh-card-name.gh-placeholder-text{ data: { group_wizard_target: 'nameEcho' } }
                    = t('.js.name_placeholder')
                %p.gh-group-index-meta
                  %span= t('.you_lead')

          %span.gh-field-hint= t('.background_hint')

        %section.gh-panel.gh-preview-panel{ hidden: true, data: { group_wizard_target: 'previewCurrency' } }
          %h3= t('.currency_preview')
          .gh-currency-preview-pair
            - %w[light dark].each do |theme|
              = render 'currency_mini', theme: theme

    .gh-panel.gh-form-actions-bar
      = link_to t('shared.actions.cancel'), story_groups_path, class: 'gh-btn gh-btn--secondary',
        data: { group_wizard_target: 'cancel' }
      %button.gh-btn.gh-btn--secondary{ type: 'button', hidden: true, 'aria-label': t('.back'),
                                  data: { group_wizard_target: 'back',
                                          action: 'group-wizard#back' } }
        %i.fa-solid.fa-chevron-left{ 'aria-hidden': 'true' }
        %span.gh-form-actions-bar-label= t('.back')
      %span.gh-form-actions-spacer
      %span.gh-page-kicker{ data: { group_wizard_target: 'counter' } }= t('.step_counter', step: 1, total: steps.size)
      %button.gh-btn{ type: 'button', data: { group_wizard_target: 'next',
                                              action: 'group-wizard#next' } }
        %span.gh-form-actions-bar-label{ data: { group_wizard_target: 'nextLabel' } }= t('shared.actions.next')
        %span.gh-form-actions-bar-label--compact{ data: { group_wizard_target: 'nextLabelShort' } }= t('shared.actions.next')
        %i.fa-solid.fa-chevron-right{ 'aria-hidden': 'true',
                                      data: { group_wizard_target: 'nextIcon' } }
      = f.submit t('.submit'), class: 'gh-btn', hidden: true,
        data: { group_wizard_target: 'submit' }
