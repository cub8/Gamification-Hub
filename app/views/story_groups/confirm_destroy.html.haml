-# Either the layout's shared `modal` frame or a page — never both. A page
-# carrying its own <turbo-frame id="modal"> would collide with the one the
-# layout already has inside the dialog.
- content_for :title, "Usuń grupę #{@story_group.name}"

- if @in_modal
  = turbo_frame_tag 'modal' do
    = render 'confirm_destroy', story_group: @story_group
- else
  -# Rendered as a page it needs a surface of its own: this screen keeps the app
  -# shell, so unlike the join flow it never lands inside .gh-acard.
  %section.gh-panel.gh-dlg-page
    = render 'confirm_destroy', story_group: @story_group
