%h1= @story_group.name
= render @story_group

%div
  - if policy(@story_group).update?
    = link_to "Edit this story group", edit_story_group_path(@story_group)
    |
  = link_to "Back to story groups", story_groups_path

  - if policy(@story_group).destroy?
    = button_to "Destroy this story group", @story_group, method: :delete

%hr

%h2 Items
= link_to "Go to items", story_group_items_path(@story_group)

%h2 Ranks
= link_to "View ranks", story_group_ranks_path(@story_group)

%h2 Badges
= link_to "View badges", story_group_badges_path(@story_group)
