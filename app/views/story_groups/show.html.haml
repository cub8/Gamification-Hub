%h1= @story_group.name

- if policy(@story_group).view_ranking?
  = link_to "Ranking", story_group_ranking_path(@story_group)
  |
= link_to "Ranks", story_group_ranks_path(@story_group)
|
= link_to "Badges", story_group_badges_path(@story_group)
- if policy(@story_group).update?
  |
  = link_to "Items", story_group_items_path(@story_group)
  |
  = link_to "Teachers", story_group_teachers_path(@story_group)
  |
  = link_to "Students", story_group_students_path(@story_group)
  |
  = link_to "Activity groups", story_group_activity_groups_path(@story_group)
  |
  = link_to "Invites", story_group_invites_path(@story_group)
- if policy(@story_group).student?
  |
  = link_to "My Profile", story_group_profile_index_path(@story_group)
  |
  = link_to "Shop", story_group_shop_index_path(@story_group)

%hr

= render @story_group

%div
  - if policy(@story_group).update?
    = link_to "Edit this story group", edit_story_group_path(@story_group)
    |
  = link_to "Back to story groups", story_groups_path
  - if policy(@story_group).destroy?
    |
    = link_to "Destroy this story group", @story_group, data: { turbo_method: :delete }
