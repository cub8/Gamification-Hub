-# Mockup: #/s/groups and #/t/groups, design/mockup-src/js-expanded/30-gh.js
-# `vIndex`. One screen, both personas — the tabs and the "Utwórz grupę" button
-# are what differ, and both are decided by the data rather than by the role.
- content_for :title, 'Grupy'

%section.gh-panel.gh-page-header
  .gh-page-header-text
    %h1.gh-h1 Grupy
    %p.gh-lead
      - if @current_user.student?
        Grupy, w których się uczysz.
      - else
        Grupy, które prowadzisz, wspierasz albo w których się uczysz.

  .gh-button-row
    = link_to new_join_path, class: 'gh-btn gh-btn--secondary', data: { turbo_frame: 'modal' } do
      %i.fa-solid.fa-plus
      Dołącz do grupy
    -# A page, not the dialog it used to be: creation is a four-step wizard now
    -# and DECISIONS.md:26 puts steps on a page.
    - if policy(:story_group).create?
      = link_to new_story_group_path, class: 'gh-btn' do
        %i.fa-solid.fa-plus
        Utwórz grupę

-# The mockup's tabs are buttons that swap content client-side; ours navigate,
-# so they are links carrying aria-current — the same shape as the .gh-purchase-filter-chip
-# group filter already shipped on the teacher start screen. role="tab" without
-# a tabpanel would be a lie.
- if @listing.tabs.size > 1
  %nav.gh-group-tabs{ 'aria-label': 'Filtr grup' }
    - @listing.tabs.each do |tab|
      = link_to story_groups_path(filter: tab.key), class: 'gh-group-tab',
        'aria-current': (@listing.filter == tab.key).to_s do
        = tab.label
        %span.gh-count-label= tab.total

%div{ data: { controller: 'group-search' } }
  - if @listing.groups.any?
    .flex.flex-wrap.gap-3.items-center.mt-4
      %label.gh-search-input.gh-search-input--wide
        %i.fa-solid.fa-magnifying-glass{ 'aria-hidden': 'true' }
        %input{ type: 'search',
                placeholder: 'Szukaj grupy',
                'aria-label': 'Szukaj grupy',
                data: { group_search_target: 'input', action: 'input->group-search#filter' } }

    .gh-group-index-grid
      - @listing.groups.each do |group|
        = render 'story_groups/group_card', group: group

    -# Revealed by the controller when the query matches nothing on the page.
    %section.gh-panel.gh-empty-state{ hidden: true, data: { group_search_target: 'empty' } }
      %h2.gh-h2
        Brak grup o nazwie
        %span{ data: { group_search_target: 'emptyQuery' } }
      %p.gh-lead Wyczyść wyszukiwanie albo sprawdź pisownię.

  - else
    %section.gh-panel.gh-empty-state
      %h2.gh-h2
        - if @listing.filter
          Brak grup w tej zakładce
        - elsif @current_user.student?
          Nie należysz jeszcze do żadnej grupy
        - else
          Nie masz jeszcze żadnej grupy
      %p.gh-lead
        - if @listing.filter
          Zmień zakładkę, żeby zobaczyć pozostałe grupy.
        - else
          Masz kod od prowadzącego? Dołącz do grupy jako uczestnik.
