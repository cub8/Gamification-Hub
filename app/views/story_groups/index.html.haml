- content_for :title, "Story groups"

%h1 Story groups

#story_groups
  %table.table
    %tr
      %th Owner
      %th Name
      %th Description
      %th Currency name
      %th
    - @story_groups.each do |story_group|
      %tr
        %td= story_group.owner.full_name
        %td= story_group.name
        %td= story_group.description
        %td= story_group.currency_name
        %td= link_to "Show", story_group

- if policy(:story_group).create?
  %p
    = link_to "New story group", new_story_group_path, data: { turbo_frame: "modal" }

%p
  = link_to "Home", root_path
