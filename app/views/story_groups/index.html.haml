- content_for :title, "Story Groups"

.dark-page
  .mb-4
    %ul.nav.mb-0
      %li.nav-item
        = link_to "Wszystkie grupy", story_groups_path, class: "nav-link px-0 me-4 #{'active' if params[:filter].blank?}"
      - if @show_mine_tab
        %li.nav-item
          = link_to "Moje", story_groups_path(filter: "mine"), class: "nav-link px-0 me-4 #{'active' if params[:filter] == 'mine'}"
      - if @show_student_tab
        %li.nav-item
          = link_to "Uczę się", story_groups_path(filter: "student"), class: "nav-link px-0 me-4 #{'active' if params[:filter] == 'student'}"
      - if @show_teacher_tab
        %li.nav-item
          = link_to "Nauczam", story_groups_path(filter: "teacher"), class: "nav-link px-0 #{'active' if params[:filter] == 'teacher'}"

  - if @story_groups.empty?
    %p.text-dimmed Brak grup fabularnych.
  - else
    .row.g-3
      - @story_groups.each do |story_group|
        .col-12.col-sm-6.col-md-4.col-xl-3
          = link_to story_group_path(story_group), class: "text-decoration-none d-block h-100" do
            .dark-card.cursor-pointer
              - if story_group.icon.attached?
                .dark-card-cover
                  = image_tag story_group.icon
              - else
                .dark-card-icon
                  %i.fa-solid.fa-book-open.fa-3x

              .dark-card-body
                .dark-card-title= story_group.name
                %p.text-dimmed.small.mb-0= story_group.owner.full_name

  - if policy(:story_group).create?
    = link_to new_story_group_path, class: "btn btn-primary position-fixed bottom-0 end-0 mb-4 me-4", data: { turbo_frame: "modal" } do
      %i.fa-solid.fa-plus.me-2
      Utwórz grupę fabularną
