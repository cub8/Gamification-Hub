- content_for :title, t('.title')

%section.gh-panel.gh-page-header
  .gh-page-header-text
    %h1.gh-h1= t('.title')
    %p.gh-lead= @current_user.student? ? t('.student_lead') : t('.teacher_lead')

  .gh-button-row
    = link_to new_join_path, class: 'gh-btn gh-btn--secondary', data: { turbo_frame: 'modal' } do
      %i.fa-solid.fa-plus
      = t('.join')
    - if policy(:story_group).create?
      = link_to new_story_group_path, class: 'gh-btn' do
        %i.fa-solid.fa-plus
        = t('.create')

- if @listing.tabs.size > 1
  %nav.gh-group-tabs{ 'aria-label': t('.filter') }
    - @listing.tabs.each do |tab|
      = link_to story_groups_path(filter: tab.key), class: 'gh-group-tab',
        'aria-current': (@listing.filter == tab.key).to_s do
        = tab.label
        %span.gh-count-label= tab.total

%div{ data: { controller: 'group-search' } }
  - if @listing.groups.any?
    .flex.flex-wrap.gap-3.items-center.mt-4
      %label.gh-search-input.gh-search-input--wide
        %i.fa-solid.fa-magnifying-glass{ 'aria-hidden': 'true' }
        %input{ type: 'search',
                placeholder: t('.search'),
                'aria-label': t('.search'),
                data: { group_search_target: 'input', action: 'input->group-search#filter' } }

    .gh-group-index-grid
      - @listing.groups.each do |group|
        = render 'story_groups/group_card', group: group

    %section.gh-panel.gh-empty-state{ hidden: true, data: { group_search_target: 'empty' } }
      %h2.gh-h2
        = t('.no_match')
        %span{ data: { group_search_target: 'emptyQuery' } }
      %p.gh-lead= t('.no_match_hint')

  - else
    %section.gh-panel.gh-empty-state
      %h2.gh-h2
        - if @listing.filter
          = t('.empty_tab_title')
        - elsif @current_user.student?
          = t('.empty_student_title')
        - else
          = t('.empty_title')
      %p.gh-lead= @listing.filter ? t('.empty_tab_body') : t('.empty_body')
