- error = ->(attribute) { story_group.errors[attribute].first }

%section.gh-panel.gh-page-header
  %h1.gh-h1= t('.title')
  %p.gh-lead= t('.lead')

= form_with model: story_group do |f|
  %section.gh-panel.gh-settings-section
    .gh-form-section.gh-form-section--first
      %h2.gh-h3= t('.group_section')

      .gh-form-field
        = f.label :name, t('.name')
        .gh-text-input{ class: ('gh-text-input--invalid' if error.call(:name)) }
          = f.text_field :name, maxlength: 40, autocomplete: 'off',
            placeholder: t('.name_placeholder'),
            'aria-invalid': (error.call(:name) ? 'true' : nil),
            'aria-describedby': (error.call(:name) ? 'gh-group-name-error' : nil)
        - if error.call(:name)
          %p#gh-group-name-error.gh-field-error{ role: 'alert' }
            %i.fa-solid.fa-triangle-exclamation{ 'aria-hidden': 'true' }
            %span= error.call(:name)

      .gh-form-field
        = f.label :description, t('.story')
        .gh-text-input{ class: ('gh-text-input--invalid' if error.call(:description)) }
          = f.text_area :description, rows: 3, maxlength: 1024,
            'aria-invalid': (error.call(:description) ? 'true' : nil),
            'aria-describedby': (error.call(:description) ? 'gh-group-story-error' : nil)
        - if error.call(:description)
          %p#gh-group-story-error.gh-field-error{ role: 'alert' }
            %i.fa-solid.fa-triangle-exclamation{ 'aria-hidden': 'true' }
            %span= error.call(:description)
        %span.gh-field-hint= t('.story_hint')

      = render 'shared/image_field', form: f, record: story_group,
        presets: GroupArt::KEYS, registry: GroupArt,
        kind: 'group', tile: :art,
        copy: { label: t('.art_label'),
                hint: t('.art_hint') }

    .gh-form-section
      %h2.gh-h3= t('.currency_section')
      %p.gh-field-hint= t('.currency_hint')

      .gh-form-field
        = f.label :currency_name, t('.currency_name')
        .gh-text-input{ class: ('gh-text-input--invalid' if error.call(:currency_name)) }
          = f.text_field :currency_name, maxlength: 40, autocomplete: 'off',
            placeholder: t('.currency_placeholder'),
            'aria-invalid': (error.call(:currency_name) ? 'true' : nil),
            'aria-describedby': (error.call(:currency_name) ? 'gh-group-currency-error' : nil)
        - if error.call(:currency_name)
          %p#gh-group-currency-error.gh-field-error{ role: 'alert' }
            %i.fa-solid.fa-triangle-exclamation{ 'aria-hidden': 'true' }
            %span= error.call(:currency_name)
        %span.gh-field-hint= t('.currency_name_hint')

      = render 'shared/image_field', form: f, record: story_group,
        attribute: :currency_icon, glyph_attribute: :currency_icon_glyph,
        presets: CurrencyIcons::KEYS, registry: CurrencyIcons,
        kind: 'currency', tile: :currency, aspect: 1,
        copy: t('story_groups.currency_icon')

    .gh-form-section
      %h2.gh-h3= t('.lives_section')
      .gh-form-field{ data: { controller: 'lives-stepper', lives_stepper_max_value: 10 } }
        %p#gh-default-lives-label.gh-form-label= t('.lives')
        .gh-number-stepper{ role: 'group', 'aria-labelledby': 'gh-default-lives-label' }
          %button.gh-number-stepper-button.gh-octagon-clip{ type: 'button', 'aria-label': t('shared.actions.fewer'),
                              disabled: story_group.default_lives.to_i.zero?,
                              data: { lives_stepper_target: 'down',
                                      action: 'lives-stepper#down' } }
            %i.fa-solid.fa-minus{ 'aria-hidden': 'true' }
          %output{ 'aria-live': 'polite', data: { lives_stepper_target: 'output' } }= story_group.default_lives
          %button.gh-number-stepper-button.gh-octagon-clip{ type: 'button', 'aria-label': t('shared.actions.more'),
                              disabled: story_group.default_lives.to_i >= 10,
                              data: { lives_stepper_target: 'up',
                                      action: 'lives-stepper#up' } }
            %i.fa-solid.fa-plus{ 'aria-hidden': 'true' }

        = f.hidden_field :default_lives, data: { lives_stepper_target: 'field' }

        - if error.call(:default_lives)
          %p.gh-field-error{ role: 'alert' }
            %i.fa-solid.fa-triangle-exclamation{ 'aria-hidden': 'true' }
            %span= error.call(:default_lives)

        %span.gh-field-hint= t('.lives_hint')

  .gh-panel.gh-form-actions-bar
    = link_to t('.back'), story_group_path(story_group), class: 'gh-link-button'
    %span.gh-form-actions-spacer
    %button.gh-btn{ type: 'submit' }= t('shared.actions.save_changes')

- if policy(story_group).destroy?
  %section.gh-panel.gh-danger-zone
    %h2.gh-h3= t('.delete_title')
    %p.gh-small= t('.delete_body')
    .gh-button-row
      = link_to confirm_destroy_story_group_path(story_group),
        class: 'gh-btn gh-btn--secondary', data: { turbo_frame: 'modal' } do
        %i.fa-solid.fa-trash{ 'aria-hidden': 'true' }
        = t('.delete')
