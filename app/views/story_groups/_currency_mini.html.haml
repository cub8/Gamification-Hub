.gh-currency-preview{ class: "gh-theme--#{theme}" }
  %span.gh-balance-button
    %span.gh-currency-token.gh-octagon-clip{ style: '--gh-s: 32px', 'aria-hidden': 'true' }
      %span.gh-octagon-clip{ data: { group_wizard_target: 'markBox' } }
        %span{ data: { group_wizard_target: 'markLetter' } }
    %span
      %b 19
      %small do wydania

  %span.gh-currency-preview-purse
    %span.gh-currency-token.gh-octagon-clip{ style: '--gh-s: 50px', 'aria-hidden': 'true' }
      %span.gh-octagon-clip{ data: { group_wizard_target: 'markBox' } }
        %span{ data: { group_wizard_target: 'markLetter' } }
    %b 19

  %span.gh-currency-preview-price-line
    15
    %span.gh-currency-token.gh-octagon-clip{ style: '--gh-s: 22px', 'aria-hidden': 'true' }
      %span.gh-octagon-clip{ data: { group_wizard_target: 'markBox' } }
        %span{ data: { group_wizard_target: 'markLetter' } }

  %span.gh-price-badge
    %b 15
