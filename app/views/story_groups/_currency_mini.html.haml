-# One themed copy of the currency preview on step 2 of the wizard.
-# Mockup: js-expanded/30-form.js `mini()` (:84).
-#
-# Rendered twice, light and dark, so a teacher picking a mark sees it on both
-# table colours at once — an upload that reads well on one can disappear on the
-# other. `.gh-theme--*` carries a whole token set on this element (tokens.css),
-# which is what makes two themes on one page possible.
-#
-# The numbers are fixed sample values, not data: this is a picture of four
-# screens, not a calculation.
-#
-# Every token's mark is filled by group_wizard_controller, which clones it out
-# of the checked picker tile — the same trick rank_form_controller uses.
.gh-cmini{ class: "gh-theme--#{theme}" }
  -# The purse in the header.
  %span.gh-bal
    %span.gh-tok{ style: '--gh-s: 32px', 'aria-hidden': 'true' }
      %span{ data: { group_wizard_target: 'markBox' } }
        %span{ data: { group_wizard_target: 'markLetter' } }
    %span
      %b 19
      %small do wydania

  -# "Historia waluty", where the balance is the headline.
  %span.gh-cmini-purse
    %span.gh-tok{ style: '--gh-s: 50px', 'aria-hidden': 'true' }
      %span{ data: { group_wizard_target: 'markBox' } }
        %span{ data: { group_wizard_target: 'markLetter' } }
    %b 19

  -# The buy dialog, where the price is read as a sentence.
  %span.gh-dlgt
    15
    %span.gh-tok{ style: '--gh-s: 22px', 'aria-hidden': 'true' }
      %span{ data: { group_wizard_target: 'markBox' } }
        %span{ data: { group_wizard_target: 'markLetter' } }

  -# A price chip on a shop card, which shows the number alone
  -# (DECISIONS.md:24) — so there is no mark in this one.
  %span.gh-cost
    %b 15
