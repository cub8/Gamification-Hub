%h2.gh-h2#gh-quick-title= t('.title', name: story_group.name)
%p= t('.hint')

- if active.any?
  .gh-form-field{ data: { controller: 'invite-picker' } }
    %label{ for: 'gh-quick-select' }
      = t('.picker', count: active.size)
    %span.gh-select-input
      %select#gh-quick-select{data: { invite_picker_target: 'select',
                                      action:               'change->invite-picker#pick', }}
        - active.each do |invite|
          %option{ value: invite.id }= invite_option_label(invite)
      %i.fa-solid.fa-chevron-down{ 'aria-hidden': 'true' }

    %p.gh-small= t('.hidden_note')

    - active.each_with_index do |invite, index|
      .gh-quick-block{hidden: index.positive?,
                      data:   { invite_picker_target: 'block', invite_picker_for: invite.id },}
        = render 'qr_stat', invite: invite
- else
  %p.gh-explainer-note= t('.empty')
  .gh-button-row.gh-quick-invite-cta
    = link_to new_story_group_invite_path(story_group),
              class: 'gh-btn',
              data:  { turbo_frame: 'modal' } do
      %i.fa-solid.fa-plus{ 'aria-hidden': 'true' }
      = t('.new')

.gh-dialog-button-row
  = link_to t('.manage'), story_group_invites_path(story_group),
            class: 'gh-btn gh-btn--secondary', data: { turbo_frame: '_top' }
  - if in_modal
    %button.gh-btn{ type: 'button', data: { action: 'dialog#close' }, autofocus: true }= t('shared.actions.close')
  - else
    = link_to t('shared.actions.close'), story_group_invites_path(story_group), class: 'gh-btn'
