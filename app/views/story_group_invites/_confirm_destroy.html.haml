-# Mockup: 30-isg.js `mDel`. A dialog rather than data-turbo-confirm, because
-# the point of it is the consequence sentence, which a browser confirm cannot
-# carry.
- joined = invite.uses.to_i

%h2#gh-del-title.gh-h2= "Usunąć zaproszenie #{invite.code}?"
%p
  Kod przestanie działać od razu.
  -# Only worth saying when somebody actually used it.
  - if joined.positive?
    = "#{joined} #{gh_plural(joined, 'osoba, która dołączyła', 'osoby, które dołączyły', 'osób, które dołączyły')}"
    = 'z tym kodem, zostaje w grupie.'

.gh-dialog-button-row
  -# Anuluj first and focused: the safe button is the one you land on.
  - if @in_modal
    %button.gh-btn.gh-btn--secondary{ type: 'button', data: { action: 'dialog#close' }, autofocus: true } Anuluj
  - else
    = link_to 'Anuluj', story_group_invites_path(@story_group), class: 'gh-btn gh-btn--secondary'

  = button_to 'Usuń zaproszenie', story_group_invite_path(@story_group, invite),
    method: :delete, class: 'gh-btn',
    form: { data: { turbo_frame: (@in_modal ? 'modal' : nil) } }
