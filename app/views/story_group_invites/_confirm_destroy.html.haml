- joined = invite.uses.to_i

%h2#gh-del-title.gh-h2= t('.title', code: invite.code)
%p
  = t('.body')
  - if joined.positive?
    = t('.joined', count: joined)

.gh-dialog-button-row
  - if @in_modal
    %button.gh-btn.gh-btn--secondary{ type: 'button', data: { action: 'dialog#close' }, autofocus: true }= t('shared.actions.cancel')
  - else
    = link_to t('shared.actions.cancel'), story_group_invites_path(@story_group), class: 'gh-btn gh-btn--secondary'

  = button_to t('.remove'), story_group_invite_path(@story_group, invite),
    method: :delete, class: 'gh-btn',
    form: { data: { turbo_frame: (@in_modal ? 'modal' : nil) } }
