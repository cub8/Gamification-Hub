- content_for :title, "Edytuj zaproszenie"

.dark-page
  .row.justify-content-center
    .col-12.col-md-8.col-lg-6
      %h1.page-title.mb-4 Edytuj zaproszenie

      - content_for :form_cancel do
        = link_to "Anuluj", story_group_invite_path(@story_group, @invite), class: "btn-cancel py-2 px-3"

      = render "form", invite: @invite, url: story_group_invite_path(@story_group, @invite)
