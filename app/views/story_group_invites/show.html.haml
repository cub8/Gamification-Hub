- content_for :title, t('.page_title', code: @invite.code)

- if @in_modal
  = turbo_frame_tag 'modal' do
    = render 'code',
             invite:      @invite,
             story_group: @story_group,
             in_modal:    @in_modal
- else
  %section.gh-panel.gh-dialog-page-panel
    = render 'code',
             invite:      @invite,
             story_group: @story_group,
             in_modal:    @in_modal
