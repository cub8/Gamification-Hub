- labelled = local_assigns.fetch(:labelled, true)
- title = "Kopiuj kod #{invite.code}"

%button{ type: 'button',
         class: labelled ? 'gh-btn gh-btn--secondary gh-copy-action' : 'gh-icon-button',
         title: title,
         'aria-label': title,
         data: { controller: 'clipboard',
                 action: 'clipboard#copy',
                 clipboard_title: title,
                 clipboard_text_value: invite.code,
                 clipboard_done_value: 'Skopiowano',
                 clipboard_message_value: "Skopiowano kod #{invite.code}." } }
  %i.fa-solid.fa-copy{ 'aria-hidden': 'true', data: { clipboard_target: 'icon' } }
  - if labelled
    %span{ data: { clipboard_target: 'label' } } Kopiuj kod
