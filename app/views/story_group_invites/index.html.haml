- content_for :title, t('.title')

%section.gh-panel.gh-page-header
  .gh-page-header-text
    %h1.gh-h1= t('.title')
    %p.gh-lead= t('.lead')

  = link_to new_story_group_invite_path(@story_group), class: 'gh-btn',
    data: { turbo_frame: 'modal' } do
    %i.fa-solid.fa-plus
    = t('.new')

%section.gh-panel.gh-invite-list
  .gh-invite-row.gh-invite-row--header{ 'aria-hidden': 'true' }
    %span= t('.code')
    %span= t('.status')
    %span= t('.uses')
    %span= t('.validity')
    %span

  - if @active.any?
    = render partial: 'invite_row', collection: @active, as: :invite,
      locals: { fresh_id: @fresh_invite_id }
  - else
    %p.gh-explainer-note= t('.empty')

- if @inactive.any?
  %details.gh-inactive-invites
    %summary= t('.inactive', count: @inactive.size)
    %section.gh-panel.gh-invite-list
      = render partial: 'invite_row', collection: @inactive, as: :invite
