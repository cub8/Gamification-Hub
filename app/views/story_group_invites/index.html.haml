- content_for :title, "Zaproszenia"

.dark-page
  .d-flex.align-items-center.justify-content-between.mb-4
    %h1.h3.mb-0 Zaproszenia
    = link_to new_story_group_invite_path(@story_group), class: "btn btn-primary", data: { turbo_frame: 'modal', turbo_prefetch: true } do
      %i.fa-solid.fa-plus.me-1
      Nowe zaproszenie

  - if @invites.empty?
    %p.text-dimmed Brak zaproszeń.
  - else
    .table-responsive
      %table.table.table-sm.table-hover
        %thead
          %tr
            %th Kod
            %th.text-center Użycia
            %th Wygasa
            %th.text-center Status
            %th.text-end Akcje
        %tbody
          - @invites.each do |invite|
            %tr.position-relative
              %td
                = link_to invite.code, story_group_invite_path(@story_group, invite), class: "d-block text-decoration-none text-reset stretched-link", data: { turbo_frame: 'modal' }
              %td.text-center.text-dimmed
                - unless invite.max_uses.nil?
                  = link_to "#{invite.uses} / #{invite.max_uses}", story_group_invite_path(@story_group, invite), class: "d-block text-decoration-none text-reset stretched-link", data: { turbo_frame: 'modal' }  
                - else
                  = link_to "#{invite.uses}", story_group_invite_path(@story_group, invite), class: "d-block text-decoration-none text-reset stretched-link", data: { turbo_frame: 'modal' }  
              %td.text-dimmed
                - unless invite.expires_at.nil?
                  = link_to invite.expires_at.strftime("%d.%m.%Y %H:%M"), story_group_invite_path(@story_group, invite), class: "d-block text-decoration-none text-reset stretched-link", data: { turbo_frame: 'modal' }
                -else
                  \-
              %td.text-center
                - if invite.usable?
                  %span.badge.bg-success.position-relative.z-2 Aktywne
                - else
                  %span.badge.bg-secondary.position-relative.z-2 Wygasłe
              %td.text-end
                .d-flex.justify-content-end.gap-1
                  = link_to edit_story_group_invite_path(@story_group, invite), class: "btn btn-sm btn-secondary border-0 position-relative z-2", title: "Edytuj", data: { turbo_frame: 'modal', turbo_prefetch: true } do
                    %i.fa-solid.fa-pen
                  = button_to story_group_invite_path(@story_group, invite),
                    method: :delete,
                    form: { data: { turbo_confirm: "Usunąć zaproszenie #{invite.code}?" } },
                    class: "btn btn-sm btn-danger border-0 position-relative z-2", title: "Usuń" do
                    %i.fa-solid.fa-trash
