- content_for :title, "Invites"

.dark-page
  .d-flex.align-items-center.justify-content-between.mb-4
    %h1.h3.mb-0 Invites
    = link_to new_story_group_invite_path(@story_group), class: "btn btn-primary" do
      %i.fa-solid.fa-plus.me-1
      New Invite

  - if @invites.empty?
    %p.text-dimmed No invites yet.
  - else
    %table.table.table-sm.table-hover
      %thead
        %tr
          %th Code
          %th.text-center Uses
          %th Expires at
          %th.text-center Status
          %th.text-end Actions
      %tbody
        - @invites.each do |invite|
          %tr
            %td
              %code.text-main= invite.code
            %td.text-center.text-dimmed= "#{invite.uses} / #{invite.max_uses}"
            %td.text-dimmed= invite.expires_at.strftime("%Y-%m-%d %H:%M")
            %td.text-center
              - if invite.usable?
                %span.badge.bg-success Active
              - else
                %span.badge.bg-secondary Expired
            %td.text-end
              .d-flex.justify-content-end.gap-1
                = link_to story_group_invite_path(@story_group, invite), class: "btn btn-sm btn-secondary border-0", title: "View" do
                  %i.fa-solid.fa-eye
                = link_to edit_story_group_invite_path(@story_group, invite), class: "btn btn-sm btn-secondary border-0", title: "Edit" do
                  %i.fa-solid.fa-pen
                = button_to story_group_invite_path(@story_group, invite),
                  method: :delete,
                  form: { data: { turbo_confirm: "Remove invite #{invite.code}?" } },
                  class: "btn btn-sm btn-danger border-0", title: "Remove" do
                  %i.fa-solid.fa-trash
