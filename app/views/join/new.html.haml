-# Each step renders either into the layout's shared `modal` frame or as a
-# focused page — never both. A page carrying its own <turbo-frame id="modal">
-# would collide with the one the layout already has inside the dialog.
- content_for :title, 'Dołącz do grupy'

- if @in_modal
  = turbo_frame_tag 'modal' do
    = render 'join/step_code', code: @code, lookup: @lookup
- else
  = render 'join/step_code', code: @code, lookup: @lookup
