- nickname_error = local_assigns[:result]&.nickname_error

%p.gh-small.mb-1= t('.step')
%h2.gh-h2#gh-join-title= t('.title', name: story_group.name)
%p= t('.hint')

= form_with url:    join_index_path,
            method: :post,
            data:   { turbo_frame: (@in_modal ? 'modal' : nil) } do
  = hidden_field_tag :code, code

  .gh-form-field
    = label_tag :nickname, t('.nickname')
    .gh-text-input{ class: ('gh-text-input--invalid' if nickname_error) }
      = text_field_tag :nickname, params[:nickname],
                       maxlength:          24,
                       autocomplete:       'off',
                       autofocus:          true,
                       'aria-invalid':     nickname_error ? 'true' : nil,
                       'aria-describedby': 'gh-nick-note'

    -# haml-lint:disable RepeatedId
    - if nickname_error
      %p.gh-field-error#gh-nick-note{ role: 'alert' }
        %i.fa-solid.fa-triangle-exclamation{ 'aria-hidden': 'true' }
        %span= nickname_error
    - else
      %span.gh-field-hint#gh-nick-note= t('.nickname_hint')
    -# haml-lint:enable RepeatedId

  .gh-dialog-button-row
    = render 'join/cancel'
    %button.gh-btn{ type: 'submit' }= t('.join')
