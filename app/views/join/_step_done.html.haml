%span.gh-card-art.gh-joined-group-art{ 'aria-hidden': 'true' }
  = gh_group_cover(story_group) || gh_monogram(story_group.name)

%h2#gh-join-title.gh-h2= t('.title', name: story_group.name)
%p
  = t('.led_by', name: story_group.owner.full_name)
  = t('.you_are_html', name: tag.b(membership.display_name))
  = t('.currency', currency: story_group.currency_name)

.gh-dialog-button-row
  = link_to t('.done'), story_group_path(story_group), class: 'gh-btn',
    data: { turbo_frame: '_top' }
