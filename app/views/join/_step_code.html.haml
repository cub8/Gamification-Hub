- error = local_assigns[:lookup]&.error
- member_of = local_assigns[:lookup]&.member_of

%p.gh-small.mb-1= t('.step')
%h2.gh-h2#gh-join-title= t('.title')
%p= t('.hint')

= form_with url:    lookup_join_index_path,
            method: :get,
            data:   { controller:  'join-code',
                      turbo_frame: (@in_modal ? 'modal' : nil), } do
  = hidden_field_tag :code, code, data: { join_code_target: 'code' }

  .gh-join-code-inputs{ role: 'group', 'aria-label': t('.code_label') }
    - StoryGroupInvite::CODE_LENGTH.times do |index|
      %span.gh-join-code-slot
        %input{type:           'text',
               maxlength:      2,
               autocomplete:   'off',
               autocapitalize: 'characters',
               spellcheck:     'false',
               value:          code.to_s[index],
               autofocus:      index.zero?,
               'aria-label':   t('.slot_label', index: index + 1, total: StoryGroupInvite::CODE_LENGTH),
               data:           { join_code_target: 'slot',
                                 action:           'input->join-code#type keydown->join-code#key paste->join-code#paste', },}

  - if member_of
    %p.gh-field-error.pb-2{ role: 'alert' }
      %i.fa-solid.fa-triangle-exclamation.fa-fw.gh-join-icon{ 'aria-hidden': 'true' }
      %span
        = t('.member')
        = link_to t('.open_group'),
                  story_group_path(member_of),
                  class: 'gh-link-button',
                  data:  { turbo_frame: '_top' }
  - elsif error
    %p.gh-field-error.pb-2{ role: 'alert' }
      %i.fa-solid.fa-triangle-exclamation.fa-fw.gh-join-icon{ 'aria-hidden': 'true' }
      %span= error

  %p.gh-small.gh-join-hint
    %i.fa-solid.fa-camera.fa-fw.gh-join-icon{ 'aria-hidden': 'true' }
    = t('.qr_hint')

  .gh-dialog-button-row
    = render 'join/cancel'
    %button.gh-btn{ type: 'submit', data: { join_code_target: 'submit' } }= t('shared.actions.next')
