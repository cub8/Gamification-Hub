-# Either the layout's shared `modal` frame or a page — never both.
- content_for :title, "Przyznaj odznakę - #{@student.display_name}"

- if @in_modal
  = turbo_frame_tag 'modal' do
    = render 'form', students_badge: @students_badge
- else
  %section.gh-panel.gh-dialog-page-panel
    = render 'form', students_badge: @students_badge
