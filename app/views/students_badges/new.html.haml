- content_for :title, "Przydziel odznakę — #{@student.full_name}"

= turbo_frame_tag 'modal' do
  .modal-overlay.py-5.px-3
    .form-card.p-4
      .d-flex.align-items-center.gap-3.mb-3
        = link_to story_group_student_path(@story_group, @student), class: "btn btn-secondary", title: 'Do studenta', data: { turbo_prefetch: true } do
          %i.fa-solid.fa-arrow-left
        .d-flex.align-items-center
          %h1.page-title.mb-0 Przydziel odznakę

      - if @badge.errors.any?
        .form-errors.p-3.mb-3
          %h2 Popraw poniższe błędy:
          %ul
            - @badge.errors.full_messages.each do |message|
              %li= message

      = form_with url: story_group_student_badges_path(@story_group, @student), method: :post, scope: :students_badge do |f|
        .form-section.p-4.mb-3
          .section-title.mb-3
            = @student.full_name
            %small.text-dimmed.fw-normal.ms-2= @student.email

          .field-group.mb-3
            = f.label :badge_id, "Wybierz odznakę"
            = f.collection_select :badge_id, @badges, :id, :name,
              { prompt: "Choose a badge" },
              { class: "form-control",
                data: { controller: "tom-select-basic" } }

        .form-actions.gap-3.mt-4
          = link_to "Anuluj", story_group_student_path(@story_group, @student), class: "btn-cancel py-2 px-3", data: { turbo_prefetch: true }
          = f.submit "Zapisz", class: "btn-submit py-2 px-4"
