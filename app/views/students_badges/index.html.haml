%h2 
  =@student.full_name 
  &nbsp; Badges

%table.table
  %thead
    %tr
    %th Icon
    %th Name
    %th
  %tbody
    - @badges.each do |badge|
      %tr
        %td 
          - if badge.icon.attached?
            = image_tag badge.icon, width: 40
        %td= badge.name
        %td
          = button_to "Remove",
            story_group_student_badge_path(@story_group, @student, badge),
            method: :delete,
            data: { confirm: "Are you sure?" }

%p
  = link_to "Give Badge",
    new_story_group_student_badge_path(@story_group, @student)
  |
  = link_to "Back", story_group_students_path(@story_group)
