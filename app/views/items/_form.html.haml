= form_with model: [@story_group, item] do |f|
  - if item.errors.any?
    %div{style: "color: red"}
      %h4= "#{pluralize(item.errors.count, "error")} prohibited this item from being saved:"
      %ul
        - item.errors.each do |error|
          %li= error.full_message

  %div
    = f.label :name, 'Name'
    = f.text_field :name

  %div
    = f.label :story_description, 'Story description'
    = f.text_area :story_description

  %div
    = f.label :didactic_description, 'Didactic description'
    = f.text_area :didactic_description

  %div
    = f.label :price, 'Price'
    = f.number_field :price

  %div
    = f.label :image, 'Image'
    = f.file_field :image

  %div
    = f.label :can_buy_at_0_lives, 'Can buy at 0 lives?'
    = f.check_box :can_buy_at_0_lives

  %hr

  %h3 Wymagania i Promocje

  %div
    = f.label :unlock_rank_id, 'Minimalna ranga do zakupu'
    = f.collection_select :unlock_rank_id, @story_group.ranks.order(:required_currency_value), :id, :name, { include_blank: 'Brak (dowolna)' }, { data: { controller: 'tom-select-basic' } }

  %div
    = f.label :min_rank_for_discount_id, 'Ranga od której nalicza się promocja'
    = f.collection_select :min_rank_for_discount_id, @story_group.ranks.order(:required_currency_value), :id, :name, { include_blank: 'Brak (od najniższej)' }, { data: { controller: 'tom-select-basic' } }

  %div
    = f.label :unlock_badge_ids, 'Odznaki odblokowujące zakup'
    = f.collection_select :unlock_badge_ids, @story_group.badges, :id, :name, { include_blank: 'Brak' }, { multiple: true, data: { controller: 'tom-select-basic' } }

  %div
    = f.label :discount_badge_ids, 'Odznaki wymagane do nabijania promocji'
    = f.collection_select :discount_badge_ids, @story_group.badges, :id, :name, { include_blank: 'Brak' }, { multiple: true, data: { controller: 'tom-select-basic' } }

  %br

  = f.submit (@item.new_record? ? 'Create' : 'Save')
