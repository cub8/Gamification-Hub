-# The item form, shared by new and edit. Mockup: js-expanded/30-item.js:37-57
-# (the fields) and :133-139 (the page around them).
-#
-# A PAGE, not a dialog (DECISIONS.md:26). The preview column beside it is the
-# reason: an item card has three states and they need the width.
- editing = item.persisted?
- error   = ->(attribute) { item.errors[attribute].first }
- badges  = @story_group.badges.kept.by_name.to_a
- card    = ItemCard.new(item, ranks: shelf.ranks, badges: badges)
-# Re-picked on every render, which is the point: it is AN example student, not
-# the example. The shuffle below is what lets the browser re-pick the same way.
- example = DiscountExample.new(card)
- bought  = editing ? shelf.bought_for(item) : 0

%section.gh-panel.gh-phead.gh-phead--stack
  %p.gh-crumbs
    = link_to 'Przedmioty', story_group_items_path(@story_group)
    %i.fa-solid.fa-chevron-right{ 'aria-hidden': 'true' }
    %span= editing ? (item.name_was.presence || item.name) : 'Nowy przedmiot'
  %h1.gh-h1= editing ? 'Edytuj przedmiot' : 'Nowy przedmiot'
  %p.gh-lead
    = editing ? 'Podgląd obok pokazuje kartę po zmianach.' : 'Wypełnij kartę, a podgląd obok pokaże, jak zobaczą ją studenci.'

-# The crop event bubbles up from the image field, and #art re-reads the artwork
-# out of the picker tile the cropper just redrew — so dragging the crop box
-# moves the preview card and the thumbnail with it.
-#
-# The group-wide half of the ceiling, handed over rather than re-derived: the
-# chips carry only each badge's own discount and the ladder's best is not any
-# one select option, so item_form_controller has no way to work these out
-# without a second copy of a rule ItemCard already owns.
-#
-# The two `example_*_order` values are ONE shuffle, walked by both sides, so the
-# server's example student and the browser's cannot come out different.
- form_data = { controller: 'item-form',
                action:     'gh:image-crop->item-form#art',
                item_form_ladder_discount_value: card.ladder_discount,
                item_form_ladder_rank_value:     card.ladder_discount_rank&.name.to_s,
                item_form_badge_discount_value:  card.badges_discount,
                item_form_badge_names_value:     card.discount_badges.map(&:name).to_json,
                item_form_example_rank_order_value:  example.rank_order.to_json,
                item_form_example_badge_order_value: example.badge_order.to_json, }

= form_with model: [@story_group, item], data: form_data do |f|

  .gh-wiz
    %section.gh-panel.gh-fcol
      - if bought.positive?
        %p.gh-info
          %i.fa-solid.fa-users{ 'aria-hidden': 'true' }
          %span
            %b
              = "#{bought} #{gh_plural(bought, 'student ma', 'studentów ma', 'studentów ma')} ten przedmiot."
            Zmiany ceny, wymagań i zniżek dotyczą tylko nowych zakupów.

      .gh-fsec
        %h2.gh-h3 Karta przedmiotu
        %p.gh-hint Tak przedmiot wygląda w sklepie i w ekwipunku studenta.

        .gh-fld
          = f.label :name, 'Nazwa'
          .gh-inp{ class: ('gh-inp--bad' if error.call(:name)) }
            = f.text_field :name, maxlength: 50, autocomplete: 'off',
              placeholder: 'np. Poprawa wejściówki',
              'aria-invalid': (error.call(:name) ? 'true' : nil),
              'aria-describedby': (error.call(:name) ? 'gh-item-name-error' : nil),
              data: { item_form_target: 'name', action: 'item-form#refresh' }
          - if error.call(:name)
            %p#gh-item-name-error.gh-err{ role: 'alert' }
              %i.fa-solid.fa-triangle-exclamation{ 'aria-hidden': 'true' }
              %span= error.call(:name)

        .gh-fld
          = f.label :didactic_description, 'Co daje studentowi'
          .gh-inp{ class: ('gh-inp--bad' if error.call(:didactic_description)) }
            = f.text_area :didactic_description, rows: 2, maxlength: 255,
              placeholder: 'np. Możliwość ponownego napisania wejściówki',
              'aria-invalid': (error.call(:didactic_description) ? 'true' : nil),
              'aria-describedby': (error.call(:didactic_description) ? 'gh-item-rules-error' : nil),
              data: { item_form_target: 'rules', action: 'item-form#refresh' }
          - if error.call(:didactic_description)
            %p#gh-item-rules-error.gh-err{ role: 'alert' }
              %i.fa-solid.fa-triangle-exclamation{ 'aria-hidden': 'true' }
              %span= error.call(:didactic_description)
          %span.gh-hint Opis dydaktyczny: konkretna korzyść, bez fabuły.

        .gh-fld
          = f.label :story_description do
            Opis fabularny
            %small (opcjonalnie)
          .gh-inp{ class: ('gh-inp--bad' if error.call(:story_description)) }
            = f.text_area :story_description, rows: 2, maxlength: 255,
              placeholder: 'np. Awaryjny powrót statku do bazy',
              'aria-invalid': (error.call(:story_description) ? 'true' : nil),
              'aria-describedby': (error.call(:story_description) ? 'gh-item-story-error' : nil),
              data: { item_form_target: 'story', action: 'item-form#refresh' }
          - if error.call(:story_description)
            %p#gh-item-story-error.gh-err{ role: 'alert' }
              %i.fa-solid.fa-triangle-exclamation{ 'aria-hidden': 'true' }
              %span= error.call(:story_description)

        = render 'shared/image_field', form: f, record: item,
          presets: Glyphs::ITEM, kind: 'item',
          refresh_action: 'item-form#refresh'

      .gh-fsec
        %h2.gh-h3 Cena

        .gh-fld
          = f.label :price, 'Cena'
          .gh-price-row
            .gh-inp.gh-inp--num{ class: ('gh-inp--bad' if error.call(:price)) }
              = f.number_field :price, min: 1, step: 1,
                'aria-invalid': (error.call(:price) ? 'true' : nil),
                'aria-describedby': (error.call(:price) ? 'gh-item-price-error' : nil),
                data: { item_form_target: 'price', action: 'item-form#refresh' }
            = render 'layouts/currency_token', story_group: @story_group, size: 32
            %span.gh-k= @story_group.currency_name

        - if error.call(:price)
          %p#gh-item-price-error.gh-err{ role: 'alert' }
            %i.fa-solid.fa-triangle-exclamation{ 'aria-hidden': 'true' }
            %span= error.call(:price)

        .gh-swrow
          -# `change->` explicitly: Stimulus defaults an <input> to the
          -# `input` event, which a checkbox does fire on click but which
          -# reads wrong for a toggle.
          = f.check_box :can_buy_at_0_lives, class: 'gh-sw',
            'aria-labelledby': 'gh-item-zero-label',
            data: { item_form_target: 'zero', action: 'change->item-form#refresh' }
          %span
            %b#gh-item-zero-label Można kupić przy 0 życiach
            %span.gh-hint Przydaje się dla przedmiotów, które przywracają życie.

      .gh-fsec
        %h2.gh-h3 Kto może kupić
        %p.gh-hint Bez wymagań przedmiot jest dostępny dla wszystkich.

        .gh-sent
          %span Kupić może
          %span.gh-sel
            = f.select :unlock_rank_id, item_unlock_rank_options(shelf.ranks, item.unlock_rank_id), {},
              'aria-label': 'Kto może kupić',
              data: { item_form_target: 'unlockRank', action: 'item-form#refresh' }
            %i.fa-solid.fa-chevron-down{ 'aria-hidden': 'true' }

        .gh-sent
          %span Wymagane odznaki
          - if badges.any?
            = render 'badge_chips', f: f, field: :unlock_badge_ids, badges: badges,
              legend: 'Wymagane odznaki', placeholder: 'Dodaj odznakę…',
              form_target: 'unlockBadge'
          - else
            %span.gh-hint W tej grupie nie ma jeszcze odznak.

        %p.gh-expl{ data: { item_form_target: 'unlockText' } }= item_unlock_sentence(item)

      .gh-fsec
        %h2.gh-h3 Zniżki
        -# The second sentence is the part that surprises everyone: the warunki
        -# below decide WHO gets a discount, never how big it is. The size always
        -# comes from the student's own rank and every badge they hold
        -# (DiscountCalculatorService), which is why an item with no conditions
        -# here still sells below its price.
        %p.gh-hint
          Zniżka z rangi to procent przypisany do rangi studenta. Zniżki z odznak
          się sumują. Wystarczy spełnić jeden z warunków, żeby zniżka zadziałała
          — bez warunków dostaje ją każdy kupujący. Wysokość liczy się zawsze
          z rangi i wszystkich odznak studenta, także tych niewybranych tutaj.

        .gh-sent
          %span Zniżka dla rang
          %span.gh-sel
            = f.select :min_rank_for_discount_id,
              item_discount_rank_options(shelf.ranks, item.min_rank_for_discount_id), {},
              'aria-label': 'Zniżka dla rang',
              data: { item_form_target: 'discountRank', action: 'item-form#refresh' }
            %i.fa-solid.fa-chevron-down{ 'aria-hidden': 'true' }

        .gh-sent
          %span Zniżka za odznaki
          - if badges.any?
            = render 'badge_chips', f: f, field: :discount_badge_ids, badges: badges,
              legend: 'Odznaki ze zniżką', placeholder: 'Dodaj odznakę ze zniżką…',
              form_target: 'discountBadge', show_discount: true
          - else
            %span.gh-hint W tej grupie nie ma jeszcze odznak.

        -# Two sentences in the one consequence box: a student you could actually
        -# meet, then the ceiling behind the card's "Zniżki do −X%" chip. Separate
        -# elements because writeSentence replaces a target's children whole.
        .gh-expl
          %p{ data: { item_form_target: 'discountText' } }= item_discount_sentence(item, card, example)
          %p.gh-expl-max{ data: { item_form_target: 'discountMax' } }= item_discount_max_sentence(card)

        -# Not errors: a teacher may well mean an overlap. Rendered as notes, and
        -# the form saves either way.
        .gh-warns{ data: { item_form_target: 'warnings' } }
          - item_overlap_warnings(item, card).each do |warning|
            %p.gh-warn2
              %i.fa-solid.fa-triangle-exclamation{ 'aria-hidden': 'true' }
              %span= warning

      - if editing
        .gh-fsec
          %h2.gh-h3 Usuwanie
          %p.gh-hint
            Przedmiot zniknie ze sklepu i z list. Studenci, którzy go kupili,
            nadal go mają, a w ich historii zostanie jako „Usunięty z oferty”.
          .gh-rowb
            = link_to confirm_destroy_story_group_item_path(@story_group, item),
              class: 'gh-btn gh-btn--sec', data: { turbo_frame: 'modal' } do
              %i.fa-solid.fa-trash{ 'aria-hidden': 'true' }
              Usuń przedmiot

    %aside.gh-pcol{ 'aria-label': 'Podgląd' }
      = render 'preview', item: item, card: card

  -# The requirement lines the sealed foot shows. A <template> rather than a
  -# string in the controller: item_form_controller clones these and sets the
  -# name, so the markup stays here where it can be read alongside the card.
  %template{ data: { item_form_target: 'reqRank' } }
    %li
      Wymaga rangi
      %b
  %template{ data: { item_form_target: 'reqBadge' } }
    %li
      Wymaga odznaki
      %b
  %template{ data: { item_form_target: 'warnTemplate' } }
    %p.gh-warn2
      %i.fa-solid.fa-triangle-exclamation{ 'aria-hidden': 'true' }
      %span

  .gh-panel.gh-wbar
    = link_to 'Anuluj', story_group_items_path(@story_group), class: 'gh-linkbtn'
    %span.gh-wbar-sp
    %button.gh-btn{ type: 'submit' }
      - unless editing
        %i.fa-solid.fa-plus{ 'aria-hidden': 'true' }
      = editing ? 'Zapisz zmiany' : 'Dodaj przedmiot'
