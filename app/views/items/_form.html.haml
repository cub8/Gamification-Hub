- if item.errors.any?
  .form-errors.p-3.mb-3
    %h2 Popraw poniższe błędy:
    %ul
      - item.errors.full_messages.each do |message|
        %li= message

= form_with model: [@story_group, item] do |f|
  .form-section.p-4.mb-3
    .section-title.mb-3 Podstawowe dane

    .field-group.mb-3
      = f.label :name, "Nazwa"
      = f.text_field :name, class: "form-control"

    .field-group.mb-3
      = f.label :story_description, "Opis fabularny"
      = f.text_area :story_description, class: "form-control"

    .field-group.mb-3
      = f.label :didactic_description, "Opis dydaktyczny"
      = f.text_area :didactic_description, class: "form-control"

    .field-group.mb-3
      = f.label :price, "Cena"
      = f.number_field :price, min: 0, class: "form-control"

    .field-group.mb-3.d-flex.align-items-center.gap-2
      = f.check_box :can_buy_at_0_lives, class: "form-check-input mt-0"
      = f.label :can_buy_at_0_lives, "Można kupić przy 0 życiach", class: "mb-0"

  .form-section.p-4.mb-3
    .section-title.mb-3 Ikona

    .field-group.mb-3{ data: { controller: "file-upload" } }
      - if item.image.attached?
        .mb-2
          = image_tag item.image, width: 60, height: 60, class: "object-fit-contain"
      .file-upload
        = f.label :image, class: "file-btn px-3 py-2" do
          %i.fa-solid.fa-upload
          = item.image.attached? ? "Zastąp obraz" : "Prześlij"
        = f.file_field :image,
            accept: "image/*",
            class: "d-none",
            data: { file_upload_target: "input", action: "change->file-upload#update" }

        %span.d-none.d-block{ data: { file_upload_target: "fileName" } }
          %i.fa-solid.fa-image
          %span.uploaded-file-name
        %span.file-hint.mt-1 Akceptowane formaty: GIF, JPEG, PNG

  .form-section.p-4.mb-3
    .section-title.mb-3 Wymagania i zniżki

    .field-group.mb-3
      = f.label :unlock_rank_id, "Minimalna ranga wymagana do odblokowania zakupu"
      = f.collection_select :unlock_rank_id, @story_group.ranks.order(:required_currency_value), :id, :name,
        { include_blank: "Brak (dowolna ranga)" },
        { class: "form-control", data: { controller: "tom-select-basic" } }

    .field-group.mb-3
      = f.label :min_rank_for_discount_id, "Ranga od której nabija się zniżka"
      = f.collection_select :min_rank_for_discount_id, @story_group.ranks.order(:required_currency_value), :id, :name,
        { include_blank: "Brak (od najniższej)" },
        { class: "form-control", data: { controller: "tom-select-basic" } }

    .field-group.mb-3
      = f.label :unlock_badge_ids, "Odznaki wymagane do odblokowania zakupu"
      = f.collection_select :unlock_badge_ids, @story_group.badges, :id, :name,
        { include_blank: "Brak" },
        { multiple: true, class: "form-control", data: { controller: "tom-select-basic" } }

    .field-group.mb-3
      = f.label :discount_badge_ids, "Odznaki od których nabija się zniżka"
      = f.collection_select :discount_badge_ids, @story_group.badges, :id, :name,
        { include_blank: "Brak" },
        { multiple: true, class: "form-control", data: { controller: "tom-select-basic" } }

  .form-actions.gap-3.mt-4
    = link_to "Anuluj", story_group_items_path(@story_group), class: "btn-cancel py-2 px-3", data: { turbo_frame: '_top', turbo_prefetch: true}
    = f.submit 'Zapisz', class: "btn-submit py-2 px-4"
