- if item.errors.any?
  .form-errors.p-3.mb-3
    %h2 Please fix the following errors:
    %ul
      - item.errors.full_messages.each do |message|
        %li= message

= form_with model: [@story_group, item] do |f|
  .form-section.p-4.mb-3
    .section-title.mb-3 Basic Information

    .field-group.mb-3
      = f.label :name, "Name"
      = f.text_field :name, class: "form-control"

    .field-group.mb-3
      = f.label :story_description, "Story description"
      = f.text_area :story_description, class: "form-control"

    .field-group.mb-3
      = f.label :didactic_description, "Didactic description"
      = f.text_area :didactic_description, class: "form-control"

    .field-group.mb-3
      = f.label :price, "Price"
      = f.number_field :price, min: 0, class: "form-control"

    .field-group.mb-3.d-flex.align-items-center.gap-2
      = f.check_box :can_buy_at_0_lives, class: "form-check-input mt-0"
      = f.label :can_buy_at_0_lives, "Can buy at 0 lives", class: "mb-0"

  .form-section.p-4.mb-3
    .section-title.mb-3 Image

    .field-group.mb-3
      - if item.image.attached?
        .mb-2
          = image_tag item.image, width: 60, height: 60, class: "object-fit-contain"
      .file-upload
        = f.label :image, class: "file-btn px-3 py-2" do
          %i.fa-solid.fa-upload
          = item.image.attached? ? "Replace image" : "Upload image"
        = f.file_field :image, accept: "image/*", class: "d-none"
        %small.file-hint.mt-1 GIF, JPG or PNG

  .form-section.p-4.mb-3
    .section-title.mb-3 Requirements & Discounts

    .field-group.mb-3
      = f.label :unlock_rank_id, "Minimum rank to purchase"
      = f.collection_select :unlock_rank_id, @story_group.ranks.order(:required_currency_value), :id, :name,
        { include_blank: "None (any rank)" },
        { class: "form-control", data: { controller: "tom-select-basic" } }

    .field-group.mb-3
      = f.label :min_rank_for_discount_id, "Rank from which discount applies"
      = f.collection_select :min_rank_for_discount_id, @story_group.ranks.order(:required_currency_value), :id, :name,
        { include_blank: "None (from lowest)" },
        { class: "form-control", data: { controller: "tom-select-basic" } }

    .field-group.mb-3
      = f.label :unlock_badge_ids, "Badges required to unlock purchase"
      = f.collection_select :unlock_badge_ids, @story_group.badges, :id, :name,
        { include_blank: "None" },
        { multiple: true, class: "form-control", data: { controller: "tom-select-basic" } }

    .field-group.mb-3
      = f.label :discount_badge_ids, "Badges required for discount"
      = f.collection_select :discount_badge_ids, @story_group.badges, :id, :name,
        { include_blank: "None" },
        { multiple: true, class: "form-control", data: { controller: "tom-select-basic" } }

  .form-actions.gap-3.mt-4
    = yield :form_cancel
    = f.submit class: "btn-submit py-2 px-4"
