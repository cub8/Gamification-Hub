-# The form's preview column. Mockup: preview(), js-expanded/30-item.js:65-68.
-#
-# Server-rendered so it is right before a single keystroke and right with no
-# JavaScript at all; item_form_controller then keeps it honest as you type. It
-# never generates markup — it rewrites the text in this one and clones the
-# <template>s at the foot of the form, which is what lets the glyphs stay
-# Rails-rendered inline SVG.
-#
-# All three feet are rendered, two of them hidden, so the segmented control
-# below the heading switches between real states rather than building them.
- targets = { card:        { item_form_target: 'card' },
              name:        { item_form_target: 'frontName' },
              cost:        { item_form_target: 'frontCost' },
              art:         { item_form_target: 'frontArt' },
              seal:        { item_form_target: 'seal' },
              seal_label:  { item_form_target: 'sealLabel' },
              tag_disc:    { item_form_target: 'tagDisc' },
              tag_life:    { item_form_target: 'tagLife' },
              rules:       { item_form_target: 'frontRules' },
              flavor:      { item_form_target: 'frontFlavor' },
              foot_afford: { item_form_target: 'footAfford' },
              foot_save:   { item_form_target: 'footSave' },
              foot_sealed: { item_form_target: 'footSealed' },
              buy_label:   { item_form_target: 'buyLabel' },
              need:        { item_form_target: 'need' },
              bar:         { item_form_target: 'bar' },
              req_list:    { item_form_target: 'reqList' }, }

-# Illustrative numbers. The mockup's own are sample data with no meaning
-# (max(1, min(6, price - 1)), 30-item.js:58); this at least shows a student who
-# is most of the way there, which is what the state is for.
- price = item.price.to_i
- need  = [(price * 0.4).ceil, 1].max

%details.gh-pvd{ open: true }
  %summary
    Podgląd karty
    %i.fa-solid.fa-chevron-down{ 'aria-hidden': 'true' }

  %section.gh-panel.gh-pv
    %h3 Tak zobaczą to studenci

    .gh-seg2{ role: 'group', 'aria-label': 'Stan karty' }
      %button{ type: 'button', 'aria-pressed': 'true', value: 'afford',
               data: { action: 'item-form#state', item_form_target: 'state' } }
        Dostępny
      %button{ type: 'button', 'aria-pressed': 'false', value: 'save',
               data: { action: 'item-form#state', item_form_target: 'state' } }
        Zbierasz
      -# An item without requirements can never be sealed (DECISIONS.md:34), so
      -# the tab is disabled rather than showing a state that cannot happen.
      %button{ type: 'button', 'aria-pressed': 'false', value: 'sealed',
               disabled: !card.requires?,
               data: { action: 'item-form#state', item_form_target: 'state' } }
        Zapieczętowany

    %span.gh-hint{ hidden: card.requires?, data: { item_form_target: 'sealHint' } }
      Bez wymagań przedmiot nigdy nie będzie zapieczętowany.

    .gh-pvcard
      = render 'card', item: item, card: card, state: :afford,
        need: need, progress: 0.6, targets: targets, all_feet: true

  %section.gh-panel.gh-pv
    %h3 Miniatura w powiadomieniach
    .gh-thumbrow
      = render 'layouts/redesign/item_thumb', item: item,
        inner_data: { item_form_target: 'thumbArt' }
      %span
        %b{ data: { item_form_target: 'thumbName' } }= item_name(item)
        %span.gh-small Zakup studenta, dziś 10:21
