- content_for :title, t('.title')

%section.gh-panel.gh-page-header
  .gh-page-header-text
    %h1.gh-h1= t('.title')
    %p.gh-lead= t('.lead', count: @shelf.size)

  .gh-button-row
    = link_to new_story_group_item_path(@story_group), class: 'gh-btn' do
      %i.fa-solid.fa-plus
      = t('.new')

- if @shelf.any?
  .gh-badge-grid--teacher
    - @shelf.slots.each do |slot|
      = render 'grid_card', item: slot.item, card: @shelf.card_for(slot.item), bought: slot.bought
- else
  %section.gh-panel.gh-empty-state
    %h2.gh-h2= t('.empty_title')
    %p.gh-lead= t('.empty_body')
