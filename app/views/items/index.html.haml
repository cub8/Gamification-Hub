- content_for :title, "Items"

.dark-page
  .d-flex.align-items-center.justify-content-between.mb-4
    %h1.h3.mb-0 Items
    = link_to new_story_group_item_path(@story_group), class: "btn btn-primary" do
      %i.fa-solid.fa-plus.me-1
      New Item

  - if @items.empty?
    %p.text-dimmed No items yet.
  - else
    %table.table.table-sm.table-hover
      %thead
        %tr
          %th Image
          %th Name
          %th Story description
          %th Didactic description
          %th.text-end Price
          %th.text-center 0 lives
          %th.text-end Actions
      %tbody
        - @items.each do |item|
          %tr
            %td
              - if item.image.attached?
                = image_tag item.image, width: 36, height: 36, class: "object-fit-contain"
              - else
                %i.fa-solid.fa-box.fs-4.text-dimmed
            %td= item.name
            %td.text-dimmed= item.story_description
            %td.text-dimmed= item.didactic_description
            %td.text-end= item.price
            %td.text-center
              - if item.can_buy_at_0_lives
                %i.fa-solid.fa-check.text-success
              - else
                %i.fa-solid.fa-xmark.text-dimmed
            %td.text-end
              .d-flex.justify-content-end.gap-1
                = link_to edit_story_group_item_path(@story_group, item), class: "btn btn-sm btn-secondary border-0", title: "Edit" do
                  %i.fa-solid.fa-pen
                = button_to story_group_item_path(@story_group, item),
                  method: :delete,
                  form: { data: { turbo_confirm: "Delete item \"#{item.name}\"?" } },
                  class: "btn btn-sm btn-danger border-0", title: "Delete" do
                  %i.fa-solid.fa-trash
