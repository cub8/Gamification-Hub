.gh-auth-footer.relative.z-10{ data: { controller: 'theme',
                                theme_light_label_value: t('layouts.theme.light'),
                                theme_dark_label_value: t('layouts.theme.dark') } }
  %button.gh-link-button{ type: 'button',
                      data: { action: 'theme#toggle', theme_target: 'label' },
                      'aria-label': t('layouts.theme.toggle') }
    = gh_theme == 'dark' ? t('layouts.theme.light') : t('layouts.theme.dark')
  = render 'layouts/locale_switcher'
  %span
    = t('.help')
    %button.gh-link-button{ type: 'button' }= t('.contact')
