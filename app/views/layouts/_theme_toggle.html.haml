.gh-auth-footer.relative.z-10{ data: { controller: 'theme',
                                theme_light_label_value: 'Jasny motyw',
                                theme_dark_label_value: 'Ciemny motyw' } }
  %button.gh-link-button{ type: 'button',
                      data: { action: 'theme#toggle', theme_target: 'label' },
                      'aria-label': 'Przełącz motyw' }
    = gh_theme == 'dark' ? 'Jasny motyw' : 'Ciemny motyw'
  %span
    Pomoc:
    %button.gh-link-button{ type: 'button' } kontakt
