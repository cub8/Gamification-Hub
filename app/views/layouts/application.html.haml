!!!
%html
  %head
    %meta{content: "text/html; charset=UTF-8", "http-equiv" => "Content-Type"}/
    %title= content_for(:title) || "Gamification Hub"
    %meta{content: "width=device-width,initial-scale=1", name: "viewport"}/
    %meta{content: "yes", name: "apple-mobile-web-app-capable"}/
    %meta{content: "Gamification Hub", name: "application-name"}/
    %meta{content: "yes", name: "mobile-web-app-capable"}/
    = csrf_meta_tags
    = csp_meta_tag
    = yield :head
    %link{href: "/icon.png", rel: "icon", type: "image/png"}/
    %link{href: "/icon.svg", rel: "icon", type: "image/svg+xml"}/
    %link{href: "/icon.png", rel: "apple-touch-icon"}/
    = stylesheet_link_tag :application, "data-turbo-track": "reload"
    = javascript_include_tag "application", "data-turbo-track": "reload", type: "module"
  %body.vh-100.d-flex.flex-column.overflow-hidden
    = render Shared::HeaderComponent.new(current_user: @current_user)

    %main.d-flex.flex-grow-1.overflow-hidden.p-2.gap-2{ data: { controller: 'desktop-sidebar' } }
      %div{ class: ('d-none' if @sidebar_collapsed), data: { desktop_sidebar_target: 'full' } }
        = render Shared::MainSidebarComponent.new(current_path: url_for, user: @current_user, story_group: @story_group, collapsed: false)
      %div{ class: ('d-none' unless @sidebar_collapsed), data: { desktop_sidebar_target: 'collapsed' } }
        = render Shared::MainSidebarComponent.new(current_path: url_for, user: @current_user, story_group: @story_group, collapsed: true)
      #app-content.flex-grow-1.overflow-auto
        - if notice
          %p{style: "color: green"}= notice
        - if alert
          %p{style: "color: red"}= alert
        = yield
        %turbo-frame#modal
