!!!
%html{ lang: 'pl', data: { gh_theme: gh_theme } }
  %head
    %meta{ charset: 'utf-8' }/
    %title= content_for(:title) || 'Gamification Hub'
    %meta{ content: 'width=device-width,initial-scale=1', name: 'viewport' }/
    %meta{ content: 'Gamification Hub', name: 'application-name' }/
    %meta{ content: 'yes', name: 'mobile-web-app-capable' }/
    %meta{ name: 'turbo-prefetch', content: 'false' }/
    = csrf_meta_tags
    = csp_meta_tag
    = yield :head
    %link{ href: '/icon.png', rel: 'icon', type: 'image/png' }/
    %link{ href: '/icon.svg', rel: 'icon', type: 'image/svg+xml' }/
    %link{ href: '/icon.png', rel: 'apple-touch-icon' }/
    = stylesheet_link_tag :application, 'data-turbo-track': 'reload'
    = javascript_include_tag 'application', 'data-turbo-track': 'reload', type: 'module'

  %body.bg-table.text-ink.font-ui
    - if @chrome == false
      .gh-cover-pattern{ 'aria-hidden': 'true' }

      %main.gh-auth-page.relative.z-10
        = link_to root_path, class: 'gh-brand-lockup no-underline' do
          = image_tag 'logo.png', alt: '', class: 'h-[46px] w-[46px] object-contain'
          %span Gamification Hub
        %section.gh-panel.gh-auth-card
          = render 'layouts/flash'
          = yield
        = render 'layouts/theme_toggle'
    - else
      .gh-app-shell{data: { controller:              'theme menu sidebar',
                            theme_light_label_value: 'Jasny motyw',
                            theme_dark_label_value:  'Ciemny motyw', }}
        = render Shared::HeaderComponent.new(user:         @current_user,
                                             group_chrome: gh_group_chrome,)

        .gh-app-body
          = render Shared::SidebarComponent.new(user:         @current_user,
                                                current_path: request.path,
                                                collapsed:    @sidebar_collapsed,
                                                group_chrome: gh_group_chrome,)
          .gh-content-well
            - group_art = gh_group_cover_url(gh_group_chrome&.story_group)
            - if group_art || @group_art_layer
              .gh-group-cover-bg{'aria-hidden': 'true', hidden: group_art.nil?,
                                 style: (group_art ? "background-image:url(#{group_art})" : nil),
                                 data: { group_art_layer: '' },}
              .gh-group-cover-tint{ 'aria-hidden': 'true' }
            - else
              .gh-cover-pattern.gh-cover-pattern--inset{ 'aria-hidden': 'true' }
            %main.gh-main-content#app-content
              = render 'layouts/flash'
              = yield

        - unless @focused
          = render Shared::TabBarComponent.new(user:         @current_user,
                                               current_path: request.path,
                                               group_chrome: gh_group_chrome,)

        = render 'layouts/account_menu', user: @current_user
        = render 'layouts/more_sheet', user: @current_user,
          chrome: gh_group_chrome, current_path: request.path

        - if gh_group_chrome
          = render 'layouts/group_switcher', user:   @current_user,
                                             chrome: gh_group_chrome

        %dialog.gh-dialog.gh-dialog--anchored{data: { controller: 'dialog',
                                                      action:     'close->dialog#onClose click->dialog#closeOnBackdrop', }}
          .gh-dialog-body.gh-octagon-clip
            = turbo_frame_tag 'panel', data: { dialog_target: 'frame',
                                               action:        'turbo:frame-load->dialog#open', }

    = render 'layouts/toasts'

    %dialog.gh-dialog{data: { controller: 'dialog',
                              action:     'close->dialog#onClose click->dialog#closeOnBackdrop', }}
      .gh-dialog-body.gh-octagon-clip
        = turbo_frame_tag 'modal', data: { dialog_target: 'frame',
                                           action:        'turbo:frame-load->dialog#open', }

    %dialog.gh-dialog{data: { controller: 'dialog',
                              action:     'close->dialog#onClose click->dialog#closeOnBackdrop', }}
      .gh-dialog-body.gh-octagon-clip
        = turbo_frame_tag 'modal2', data: { dialog_target: 'frame',
                                            action:        'turbo:frame-load->dialog#open', }
