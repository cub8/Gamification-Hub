-# Flash messages for the redesign layout.
-# Replaces MessagesComponent (Bootstrap .alert + data-bs-dismiss).

- messages = { notice: flash[:notice] || notice, alert: flash[:alert] || alert }.compact

- if messages.any?
  #flash-messages.flex.flex-col.gap-2.mb-4{ data: { controller: 'flash' } }
    - messages.each do |kind, message|
      - tone = kind == :alert ? 'text-heart-ink' : 'text-earn'
      %div{ class: "gh-plate relative flex items-center justify-center px-10 py-3 text-center #{tone}",
            role: kind == :alert ? 'alert' : 'status',
            data: { flash_target: 'message' } }
        %span= message
        %button{ class: 'gh-close absolute right-1 top-1/2 -translate-y-1/2',
                 type: 'button',
                 data: { action: 'flash#dismiss' },
                 'aria-label': 'Zamknij' }
          %i.fa-solid.fa-xmark
