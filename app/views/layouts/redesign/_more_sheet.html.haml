-# The mobile "Więcej" sheet — everything the tab bar could not fit.
-# Mockup: js-expanded/10-core.js `sheetMore()`, out-of-group branch.
%dialog#gh-more-sheet.gh-dialog.gh-dialog--menu{ data: { action: 'click->menu#closeOnBackdrop' },
                                                 'aria-labelledby': 'gh-more-title' }
  .gh-dialog-body
    %span.gh-grab{ 'aria-hidden': 'true' }
    %h2#gh-more-title.gh-h2 Więcej

    - if user.teacher?
      %ul.gh-menu
        %li
          = link_to new_story_group_path, data: { turbo_frame: 'modal' } do
            %i.fa-solid.fa-plus
            %span Utwórz grupę

    %p.gh-pop-sec Konto
    %ul.gh-menu
      %li
        -# Inert until #/s/account exists.
        %button{ type: 'button' }
          %i.fa-solid.fa-gear
          %span Ustawienia konta
      %li
        %button{ type: 'button', data: { action: 'theme#toggle' } }
          %i.fa-solid.fa-moon.gh-ic-moon
          %i.fa-solid.fa-sun.gh-ic-sun
          %span{ data: { theme_target: 'label' } }
            = gh_theme == 'dark' ? 'Jasny motyw' : 'Ciemny motyw'
      %li
        = link_to logout_path, data: { turbo_method: :delete } do
          %i.fa-solid.fa-arrow-right-from-bracket
          %span Wyloguj się

    .gh-stack
      %button.gh-btn.gh-btn--sec{ type: 'button', data: { action: 'menu#close' } } Zamknij
