-# Unread badge on the header bell.
-#
-# .gh-icon-button-badge-slot takes this out of .gh-icon-button's grid flow — as an in-flow second
-# child it created a second grid row and pushed the bell glyph off centre.
-#
-# turbo_permanent keeps it across Turbo navigations so a live broadcast that
-# arrived between visits is not undone by a cached snapshot. Its own id, not
-# the Bootstrap layout's `notification-dot-container`: the legacy broadcast
-# injects Bootstrap-classed markup, which would render unstyled here.
#gh-notification-dot.gh-icon-button-badge-slot{ data: { turbo_permanent: true } }
  - if count.positive?
    %span.gh-notification-count.gh-octagon-clip{ 'aria-hidden': 'true' }= count
