- content_for :title, t('.page_title')

%h1.gh-h1= t('.title')
%p.gh-lead= t('.lead')

= form_with model: @current_user, url: account_setup_path, method: :patch do |f|
  .gh-form-field
    = f.label :email, t('.email')
    .gh-text-input
      = f.email_field :email, disabled: true

  = render 'organizations/field', form: f, record: @current_user, attribute: :full_name,
                                  label: t('.full_name'),
                                  options: { maxlength: 80, autofocus: true, required: true,
                                             autocomplete: 'name', placeholder: t('.full_name_placeholder') }

  .gh-button-stack
    %button.gh-btn{ type: 'submit' }= t('.submit')

= button_to t('.logout'), logout_path, method: :delete, class: 'gh-link-button'
