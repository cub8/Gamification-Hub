-# "Grafika": presets + upload, the field DECISIONS.md:25 makes a rule for every
-# image in the app. Ported from the mockup's imageField() (30-br.js:27-29) and
-# shared by ranks now, badges, items and story groups next — hence
-# app/views/shared, which this partial creates.
-#
-# `record` must respond to #icon (an attachment) and #icon_glyph (a key into
-# Redesign::Glyphs). `presets` is the subset this entity offers, in picker
-# order. `kind` tints the tiles with the entity's own colour.
-#
-# Two mockup defects deliberately not ported:
-#   * its tiles are <button role="radio">, which cannot post and do nothing
-#     without JavaScript. These are real radios, so the picker works with the
-#     keyboard and with JS off, and Stimulus only listens for the change.
-#   * its selected tile is framed in --item orange even on a rank form
-#     (20-form.css:36). Here the frame follows `kind`.
-# `refresh_action` lets the screen's own controller hear the picker without
-# this partial knowing its name — ranks pass "rank-form#refresh", badges will
-# pass their own.
-#
-# `aspect` is the shape the upload is cut to, and it must be the shape of the
-# hole it goes into: 1.6 is `.gh-art`'s `aspect-ratio: 16 / 10` (card.css).
-# Change one and change the other, or uploads stop filling the card.
-# The art is required on every entity that uses this field, so the error slot
-# lives here rather than in three form templates. Both attributes land in it:
-# `icon_glyph` carries "nothing chosen" and "unknown preset", `icon` carries a
-# rejected file type.
- field_id = ->(suffix) { "gh-#{kind}-art-#{suffix}" }
- refresh  = local_assigns[:refresh_action]
- art_error = record.errors[:icon_glyph].first || record.errors[:icon].first
- error_id  = field_id.call('error')

.gh-fld{ data: { controller: 'image-crop',
                 image_crop_aspect_value: local_assigns.fetch(:aspect, 1.6),
                 image_crop_width_value: 1024, } }
  %p.gh-lbl Grafika

  .gh-pz-grid{ role: 'radiogroup', 'aria-label': 'Gotowe grafiki',
               'aria-invalid': (art_error ? 'true' : nil),
               'aria-describedby': (art_error ? error_id : nil) }
    - presets.each do |key|
      %label.gh-pz{ class: "gh-pz--#{kind}" }
        = form.radio_button :icon_glyph, key, class: 'sr-only',
          id: field_id.call(key),
          'aria-label': "Grafika: #{Redesign::Glyphs.label_for(key)}",
          data: { action: ['image-crop#pickPreset', refresh].compact.join(' ') }
        %i= gh_glyph(key)


    -# The eleventh tile: your own art. Always in the markup, hidden until there
    -# is something to show — image_crop_controller reveals and selects it the
    -# moment a file is chosen, so the picker never disagrees with what will be
    -# saved. An empty key is how the record says "the upload is the art".
    %label.gh-pz.gh-pz--own{ hidden: !record.icon.attached? }
      = form.radio_button :icon_glyph, '', class: 'sr-only',
        id: field_id.call('own'), 'aria-label': 'Twoja grafika',
        checked: record.icon.attached? && record.icon_glyph.blank?,
        data: { image_crop_target: 'ownRadio',
                action: ['image-crop#pickOwn', refresh].compact.join(' ') }
      %i
        -# `src` is omitted, not blank, when there is nothing yet: an empty src
        -# resolves against the page URL, so the browser would re-request this
        -# very page for an image it cannot even see.
        - preview = { alt: '', data: { image_crop_target: 'ownPreview' } }
        - preview[:src] = url_for(record.icon) if record.icon.attached?
        %img{ preview }

  - if art_error
    %p.gh-err{ id: error_id, role: 'alert' }
      %i.fa-solid.fa-triangle-exclamation{ 'aria-hidden': 'true' }
      %span= art_error

  .gh-drop
    %span.gh-drop-ic
      %i.fa-solid.fa-upload{ 'aria-hidden': 'true' }
    %span
      %b Albo wgraj własną grafikę
      %small JPG lub PNG, najlepiej co najmniej 400 px.
    %label.gh-btn.gh-btn--sec.gh-btn--sm
      Wybierz plik
      = form.file_field :icon, class: 'sr-only',
        accept: 'image/png,image/jpeg,image/gif',
        data: { image_crop_target: 'input', action: 'image-crop#choose' }

  -# Populated by image_crop_controller once a file is chosen, and hidden until
  -# then. Without JavaScript it stays hidden and the file posts uncropped — a
  -# worse frame, but a working form.
  .gh-crop{ data: { image_crop_target: 'editor' }, hidden: true }
    %p.gh-lbl Przytnij grafikę
    .gh-crop-box{ data: { image_crop_target: 'box' } }
    %span.gh-hint
      Przesuń i przeskaluj zaznaczenie — podgląd obok zmienia się na bieżąco.
      Zapisujemy kadr w kształcie karty, więc wypełni ją w całości. Na listach
      zobaczysz go w kwadratowej miniaturze, też w całości.
