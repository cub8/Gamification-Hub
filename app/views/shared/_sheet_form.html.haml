-# The template editor and sheet settings — one form, three headings.
-# Mockup: js-expanded/30-ag.js:42-50 (the editor) and :115-118 (the page).
-#
-# The mockup marks these screens `chrome:'focus'`, but every form already
-# converted here (ranks, badges, items, group settings) keeps the app shell and
-# a crumb trail, and consistency with those wins.
-#
-# Locals: record, variant (:template_new | :template_edit | :sheet),
-# and, per variant, sheet_names or awards_count.
- sheet        = variant == :sheet
- editing      = variant != :template_new
- name_attr    = sheet ? :name : :base_name
- cats_attr    = sheet ? :activity_group_categories : :categories
- categories   = sheet ? record.activity_group_categories : record.categories
- visible      = categories.reject { |c| c.marked_for_destruction? || (sheet && c.hidden?) }
- error        = ->(attribute) { record.errors[attribute].first }
- sheet_names  = local_assigns[:sheet_names] || []
- awards_count = local_assigns[:awards_count].to_i

-# Two real names off the register, so the preview reads as this group's table
-# rather than as a screenshot. The mockup's own two are the fallback.
- sample_names = @story_group.student_memberships.with_user.first(2).map(&:display_name).presence || ['Adam Pawłowski', 'Barbara Kowalewska']

- headings   = { template_new: 'Nowy szablon arkusza', template_edit: 'Edytuj szablon arkusza', sheet: 'Ustawienia arkusza' }
- heading    = headings[variant]
- crumb_tail = sheet ? record.name : (record.base_name_was.presence || record.base_name)
- crumb_tail = 'Nowy szablon' if variant == :template_new

-# The plural forms and the currency name travel as values because the summary
-# line and the dirty marker are the only text this controller rewrites, and
-# Polish plurals are not something JavaScript should be guessing at.
- form_data = { controller: 'sheet-form',
                sheet_form_columns_value: %w[kolumna kolumny kolumn].to_json,
                sheet_form_currency_value: @story_group.currency_name.to_s,
                sheet_form_category_label_value: (sheet ? 'kolumnę' : 'kategorię'),
                sheet_form_editing_value: editing.to_s }

-# The controller wraps the whole screen, not just the <form>: the crumb link
-# above it and the discard dialog below it are both things it has to reach.
%div{ data: form_data }
  %section.gh-panel.gh-page-header.gh-page-header--stacked
    %p.gh-breadcrumbs
      = link_to 'Arkusze ocen', story_group_activity_groups_path(@story_group),
        data: { action: 'sheet-form#leave' }
      %i.fa-solid.fa-chevron-right{ 'aria-hidden': 'true' }
      %span= crumb_tail
    %h1.gh-h1= heading
    %p.gh-lead
      = sheet ? 'Zmiany dotyczą tylko tego arkusza.' : 'Podgląd obok pokazuje nagłówek tabeli ocen.'

  = form_with model: [@story_group, record], data: { sheet_form_target: 'form' } do |f|
    .gh-form-shell
      %section.gh-panel.gh-form-column
        - if variant == :template_edit && sheet_names.any?
          %p.gh-info-banner
            %i.fa-solid.fa-table{ 'aria-hidden': 'true' }
            %span
              %b Zmiany dotyczą tylko arkuszy utworzonych od teraz.
              - if sheet_names.many?
                = "#{sheet_names.first} – #{sheet_names.last} zostają bez zmian."
              - else
                = "#{sheet_names.first} zostaje bez zmian."
        - if sheet && awards_count.positive?
          %p.gh-info-banner
            %i.fa-solid.fa-lock{ 'aria-hidden': 'true' }
            %span
              %b= "W tym arkuszu przyznano już #{awards_count} #{gh_plural(awards_count, 'nagrodę', 'nagrody', 'nagród')}."
              Zmiany kolumn dotyczą tylko przyszłych nagród.
              = "Szablon #{record.activity_group_template.base_name} się nie zmienia."

        - if record.errors[:base].any?
          %p.gh-field-error{ role: 'alert' }
            %i.fa-solid.fa-triangle-exclamation{ 'aria-hidden': 'true' }
            %span= record.errors[:base].first

        .gh-form-section
          .gh-form-field.mt-0
            = f.label name_attr, sheet ? 'Nazwa arkusza' : 'Nazwa szablonu'
            .gh-text-input{ class: ('gh-text-input--invalid' if error.call(name_attr)) }
              = f.text_field name_attr, maxlength: 100, autocomplete: 'off',
                placeholder: (sheet ? 'np. Laboratoria 5 (14.10)' : 'np. Laboratoria'),
                'aria-invalid': (error.call(name_attr) ? 'true' : nil),
                'aria-describedby': (error.call(name_attr) ? 'gh-sheet-name-error' : nil),
                data: { sheet_form_target: 'title', action: 'sheet-form#refresh' }
            - if error.call(name_attr)
              %p#gh-sheet-name-error.gh-field-error{ role: 'alert' }
                %i.fa-solid.fa-triangle-exclamation{ 'aria-hidden': 'true' }
                %span= error.call(name_attr)
            - unless sheet
              %span.gh-field-hint
                Nowe arkusze dostaną nazwę szablonu z kolejnym numerem, np.
                = "#{record.base_name.presence || 'Laboratoria'} 6."

        .gh-form-section
          %h2.gh-h3= sheet ? 'Kolumny w tabeli ocen' : 'Kategorie nagród'
          %p.gh-field-hint
            Każda kategoria to kolumna w tabeli ocen. Kolejność tutaj to kolejność kolumn.

          %ul.gh-category-list{ data: { controller: 'sortable-rows', sheet_form_target: 'list',
                               action: 'sortable-rows:reordered->sheet-form#refresh' } }
            = f.fields_for cats_attr do |cf|
              = render 'shared/category_row', f: cf, category: cf.object,
                number: cf.index.to_i + 1, sheet: sheet

          %button.gh-btn.gh-btn--secondary.gh-add-category-btn{ type: 'button', data: { action: 'sheet-form#add' } }
            %i.fa-solid.fa-plus{ 'aria-hidden': 'true' }
            = sheet ? 'Dodaj kolumnę' : 'Dodaj kategorię'

          %p.gh-explainer-note
            %span{ data: { sheet_form_target: 'summaryCount' } }
              = "#{visible.size} #{gh_plural(visible.size, 'kolumna', 'kolumny', 'kolumn')}"
            w tabeli ocen. Student może zdobyć do
            %b{ data: { sheet_form_target: 'summaryMax' } }= visible.sum { |category| category.reward.to_i }
            = "#{@story_group.currency_name} za arkusz."

          -# The blank row the "Dodaj" button clones. NEW_RECORD is rewritten to a
          -# timestamp on clone, which is how Rails keeps nested-attribute indices
          -# apart without the server having to hand out more of them.
          %template{ data: { sheet_form_target: 'blank' } }
            = f.fields_for cats_attr, categories.klass.new(reward: 1), child_index: 'NEW_RECORD' do |cf|
              = render 'shared/category_row', f: cf, category: cf.object,
                number: 0, sheet: sheet

        - if editing
          .gh-form-section
            %h2.gh-h3 Usuwanie
            %p.gh-field-hint
              = sheet ? 'Arkusz zniknie z listy, a przyznane nagrody zostają u studentów i w ich historii.' : 'Szablon zniknie z listy, a utworzone z niego arkusze zostają.'
            .gh-button-row
              - path = sheet ? confirm_destroy_story_group_activity_group_path(@story_group, record) : confirm_destroy_story_group_activity_group_template_path(@story_group, record)
              = link_to path, class: 'gh-btn gh-btn--secondary', data: { turbo_frame: 'modal' } do
                %i.fa-solid.fa-trash{ 'aria-hidden': 'true' }
                = sheet ? 'Usuń arkusz' : 'Usuń szablon'

      %aside.gh-preview-column{ 'aria-label': 'Podgląd' }
        = render 'shared/grid_preview', categories: visible, sample_names: sample_names

    .gh-panel.gh-form-actions-bar
      = link_to 'Anuluj', story_group_activity_groups_path(@story_group), class: 'gh-link-button',
        data: { action: 'sheet-form#leave' }
      %span.gh-form-actions-spacer
      - if editing
        -# Server-rendered as "Brak zmian" and enabled: without JavaScript there
        -# is no dirty tracking, and a submit button you cannot press is worse
        -# than one that saves an unchanged record.
        %span.gh-small{ data: { sheet_form_target: 'dirty' } } Brak zmian
      %button.gh-btn{ type: 'submit', data: { sheet_form_target: 'submit' } }
        - unless editing
          %i.fa-solid.fa-plus{ 'aria-hidden': 'true' }
        = editing ? 'Zapisz zmiany' : 'Utwórz szablon'

  -# Only reachable once something has changed, so it is rendered but never
  -# opened without JavaScript.
  %dialog.gh-dialog{ data: { sheet_form_target: 'discard',
                             action: 'close->sheet-form#closeDiscard click->sheet-form#closeOnBackdrop' } }
    .gh-dialog-body.gh-octagon-clip
      %h2.gh-h2 Odrzucić zmiany?
      %p Niezapisane zmiany zostaną utracone.
      .gh-dialog-button-row
        %button.gh-btn.gh-btn--secondary{ type: 'button', data: { action: 'sheet-form#closeDiscard' }, autofocus: true }
          Wróć do edycji
        %button.gh-btn{ type: 'button', data: { action: 'sheet-form#discard' } } Odrzuć zmiany
