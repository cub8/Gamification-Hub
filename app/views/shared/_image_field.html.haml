- attribute       = local_assigns.fetch(:attribute, :icon)
- glyph_attribute = local_assigns.fetch(:glyph_attribute, :icon_glyph)
- registry        = local_assigns.fetch(:registry, Glyphs)
- tile            = local_assigns.fetch(:tile, :glyph)
- defaults        = { label: 'Grafika',
                      presets: 'Gotowe grafiki',
                      own: 'Twoja grafika',
                      upload: 'Albo wgraj własną grafikę',
                      hint: 'JPG lub PNG, najlepiej co najmniej 400 px.',
                      crop: 'Przytnij grafikę',
                      cropped: 'Przesuń i przeskaluj zaznaczenie — podgląd obok zmienia się na bieżąco. Zapisujemy kadr w kształcie karty, więc wypełni ją w całości. Na listach zobaczysz go w kwadratowej miniaturze, też w całości.', }
- copy            = defaults.merge(local_assigns.fetch(:copy, {}))

- field_id  = ->(suffix) { "gh-#{kind}-art-#{suffix}" }
- refresh   = local_assigns[:refresh_action]
- attachment = record.public_send(attribute)
- art_error = record.errors[glyph_attribute].first || record.errors[attribute].first
- error_id  = field_id.call('error')

.gh-form-field{ data: { controller: 'image-crop',
                 image_crop_aspect_value: local_assigns.fetch(:aspect, 1.6),
                 image_crop_width_value: 1024, } }
  %p.gh-form-label= copy[:label]

  .gh-art-preset-grid{ class: "gh-art-preset-grid--#{kind}", role: 'radiogroup', 'aria-label': copy[:presets],
               'aria-invalid': (art_error ? 'true' : nil),
               'aria-describedby': (art_error ? error_id : nil) }
    - presets.each do |key|
      %label.gh-art-preset-tile{ class: "gh-art-preset-tile--#{kind}" }
        = form.radio_button glyph_attribute, key, class: 'sr-only',
          id: field_id.call(key),
          'aria-label': "#{copy[:label]}: #{registry.label_for(key)}",
          data: { action: ['image-crop#pickPreset', refresh].compact.join(' ') }
        %i.gh-octagon-clip
          - case tile
          - when :art
            = gh_group_art(key)
          - when :currency
            = gh_currency_icon(key)
          - else
            = gh_glyph(key)

    -# The last tile: your own art. Always in the markup, hidden until there
    -# is something to show — image_crop_controller reveals and selects it the
    -# moment a file is chosen, so the picker never disagrees with what will be
    -# saved. An empty key is how the record says "the upload is the art".
    %label.gh-art-preset-tile.gh-art-preset-tile--custom{ hidden: !attachment.attached? }
      = form.radio_button glyph_attribute, '', class: 'sr-only',
        id: field_id.call('own'), 'aria-label': copy[:own],
        checked: attachment.attached? && record.public_send(glyph_attribute).blank?,
        data: { image_crop_target: 'ownRadio',
                action: ['image-crop#pickOwn', refresh].compact.join(' ') }
      %i.gh-octagon-clip
        -# `src` is omitted, not blank, when there is nothing yet: an empty src
        -# resolves against the page URL, so the browser would re-request this
        -# very page for an image it cannot even see.
        - preview = { alt: '', data: { image_crop_target: 'ownPreview' } }
        - preview[:src] = url_for(attachment) if attachment.attached?
        %img{ preview }

  - if art_error
    %p.gh-field-error{ id: error_id, role: 'alert' }
      %i.fa-solid.fa-triangle-exclamation{ 'aria-hidden': 'true' }
      %span= art_error

  .gh-file-dropzone
    %span.gh-file-dropzone-icon
      %i.fa-solid.fa-upload{ 'aria-hidden': 'true' }
    %span
      %b= copy[:upload]
      %small= copy[:hint]
    %label.gh-btn.gh-btn--secondary.gh-btn--small
      Wybierz plik
      = form.file_field attribute, class: 'sr-only',
        accept: 'image/png,image/jpeg,image/gif',
        data: { image_crop_target: 'input', action: 'image-crop#choose' }

  -# Populated by image_crop_controller once a file is chosen, and hidden until
  -# then. Without JavaScript it stays hidden and the file posts uncropped — a
  -# worse frame, but a working form.
  .gh-image-cropper{ data: { image_crop_target: 'editor' }, hidden: true }
    %p.gh-form-label= copy[:crop]
    .gh-image-cropper-box{ data: { image_crop_target: 'box' } }
    %span.gh-field-hint= copy[:cropped]
