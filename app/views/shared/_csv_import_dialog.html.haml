= turbo_frame_tag 'modal' do
  %h2.gh-h2= title
  = form_with url: url, method: :post, multipart: true, local: true, data: { turbo_frame: 'modal' } do
    = render 'shared/csv_dropzone_field', name: :file, hint: hint

    .gh-dialog-button-row
      %button.gh-btn.gh-btn--secondary{ type: 'button', data: { action: 'dialog#close' } }
        Anuluj
      %button.gh-btn{ type: 'submit' }
        Importuj
