- locked = sheet && category.locked?
- error  = ->(attribute) { category.errors[attribute].first }
- row_id = "gh-cat-#{f.index}"

%li.gh-category-row{ id: row_id,
            class: [('gh-category-row--hidden' if sheet && category.hidden?)],
            data: { sheet_form_target: 'row', gh_locked: locked.to_s } }
  = f.hidden_field :position, data: { sheet_form_target: 'position' }

  %span.gh-category-drag-handle{ title: t('.drag'), 'aria-hidden': 'true' }
    %i.fa-solid.fa-grip-vertical

  .gh-category-row-body
    .gh-text-input{ class: ('gh-text-input--invalid' if error.call(:didactic_description)) }
      = f.text_field :didactic_description, autocomplete: 'off',
        placeholder: t('.name_placeholder'),
        'aria-label': t('shared.sheet_form.js.name_label', number: number),
        'aria-invalid': (error.call(:didactic_description) ? 'true' : nil),
        data: { sheet_form_target: 'name', action: 'sheet-form#refresh' }
    - if error.call(:didactic_description)
      %p.gh-field-error{ role: 'alert' }
        %i.fa-solid.fa-triangle-exclamation{ 'aria-hidden': 'true' }
        %span= error.call(:didactic_description)

    %details.gh-story-disclosure{ open: category.story_description.present? }
      %summary.gh-category-story-toggle.gh-link-button
        %i.fa-solid.fa-align-left{ 'aria-hidden': 'true' }
        = t('.add_story')
      .gh-text-input.gh-category-story-textarea
        = f.text_area :story_description, rows: 1,
          placeholder: t('.story_placeholder'),
          'aria-label': t('shared.sheet_form.js.story_label', number: number)

    - if sheet && category.persisted? && category.sheet_only?
      %span.gh-tag.gh-tag--sheet-only= t('.sheet_only')
    - if sheet
      %span.gh-tag.gh-tag--hidden-column{ hidden: !category.hidden?,
                                   data: { sheet_form_target: 'hiddenTag' } }
        = t('.hidden_column')

    - if locked
      %p.gh-category-lock-note
        %i.fa-solid.fa-lock{ 'aria-hidden': 'true' }
        %span
          = t('.awarded', count: category.awards_count)
          = t('.locked_note')
          %span{ hidden: (category.reward == category.reward_was), data: { sheet_form_target: 'rewardNote' } }
            = t('.reward_note')

  .gh-category-row-price
    .gh-text-input.gh-text-input--numeric{ class: ('gh-text-input--invalid' if error.call(:reward)) }
      = f.number_field :reward, min: 1, step: 1,
        'aria-label': t('shared.sheet_form.js.reward_label', number: number),
        'aria-invalid': (error.call(:reward) ? 'true' : nil),
        data: { sheet_form_target: 'reward', action: 'sheet-form#refresh',
                gh_awarded: (locked ? category.reward_was : nil) }
    = render 'layouts/currency_token', story_group: @story_group, size: 26
    - if error.call(:reward)
      %p.gh-field-error{ role: 'alert' }
        %i.fa-solid.fa-triangle-exclamation{ 'aria-hidden': 'true' }
        %span= error.call(:reward)

  .gh-category-row-actions
    %button.gh-icon-button{ type: 'button', 'aria-label': t('.move_up'),
                        data: { action: 'sheet-form#moveUp', sheet_form_target: 'up' } }
      %i.fa-solid.fa-chevron-up{ 'aria-hidden': 'true' }
    %button.gh-icon-button{ type: 'button', 'aria-label': t('.move_down'),
                        data: { action: 'sheet-form#moveDown', sheet_form_target: 'down' } }
      %i.fa-solid.fa-chevron-down{ 'aria-hidden': 'true' }

    - if locked
      - toggle = category.hidden? ? t('.show') : t('.hide')
      %label.gh-icon-button.gh-icon-toggle{ title: toggle }
        = f.check_box :hidden, { data: { sheet_form_target: 'hide', action: 'sheet-form#refresh' },
                                 'aria-label': toggle }
        %i.fa-solid{ class: (category.hidden? ? 'fa-eye' : 'fa-eye-slash'), 'aria-hidden': 'true',
                     data: { sheet_form_target: 'hideIcon' } }
    - else
      %label.gh-icon-button.gh-icon-toggle{ title: t('shared.actions.remove') }
        = f.check_box :_destroy, { data: { sheet_form_target: 'destroy', action: 'sheet-form#remove' },
                                   'aria-label': t(sheet ? 'shared.sheet_form.js.destroy_column' : 'shared.sheet_form.js.destroy_category',
                                                             number: number) }
        %i.fa-solid.fa-trash{ 'aria-hidden': 'true' }
