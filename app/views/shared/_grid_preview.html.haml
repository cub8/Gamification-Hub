- sample = local_assigns[:sample_names].presence || t('shared.sheet_form.sample_names')

%details.gh-preview-details{ open: true }
  %summary
    = t('.summary')
    %i.fa-solid.fa-chevron-down{ 'aria-hidden': 'true' }

  %section.gh-panel.gh-preview-panel
    %h3.gh-h3= t('.header')

    .gh-grading-table-preview
      %table.gh-grading-table
        %thead
          %tr{ data: { sheet_form_target: 'previewHead' } }
            %th.gh-grading-th-student{ scope: 'col' }= t('.student')
            - categories.each do |category|
              %th{ scope: 'col' }
                .gh-grading-column-head
                  %span.gh-grading-column-name= category.didactic_description.presence || '…'
                  %span.gh-price-badge
                    %b= "+#{category.reward.to_i}"
                    = render 'layouts/currency_token', story_group: @story_group, size: 16
        %tbody
          - sample.each do |name|
            %tr{ data: { sheet_form_target: 'previewRow' } }
              %th.gh-grading-td-student{ scope: 'row' }= name
              - categories.each do
                %td
                  %span.gh-grading-cell.gh-grading-cell--sm

    %span.gh-field-hint= t('.hint')

%template{ data: { sheet_form_target: 'previewHeadCell' } }
  %th{ scope: 'col' }
    .gh-grading-column-head
      %span.gh-grading-column-name
      %span.gh-price-badge
        %b
        = render 'layouts/currency_token', story_group: @story_group, size: 16
%template{ data: { sheet_form_target: 'previewBodyCell' } }
  %td
    %span.gh-grading-cell.gh-grading-cell--sm
