- content_for :title, "Adjust Currency"

.dark-page
  .row.justify-content-center
    .col-12.col-md-8.col-lg-6
      %h1.sg-form-title Adjust Currency

      = form_with url: story_group_student_currency_adjustment_path(@story_group, @student), method: :post do |f|
        .sg-section
          .sg-section-title
            = @student.full_name
            %small.text-dimmed.fw-normal.ms-2= @student.email

          .sg-form-group
            = f.label :amount, "Amount"
            = f.number_field :amount, name: "currency_adjustment[amount]", class: "form-control", placeholder: "e.g. 100 or -50"
            %small.text-dimmed Use a negative value to deduct currency.

          .d-flex.gap-3.mt-2
            .text-dimmed
              Current currency:
              %strong.text-main= @student.current_currency
            .text-dimmed
              Total currency:
              %strong.text-main= @student.total_currency

        .sg-form-actions
          = link_to "Cancel", story_group_students_path(@story_group), class: "sg-btn-cancel"
          = f.submit "Adjust", class: "sg-btn-submit"
