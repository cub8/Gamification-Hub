- content_for :title, "Nowy arkusz z szablonu #{@template.base_name}"

- if @in_modal
  = turbo_frame_tag 'modal' do
    = render 'new_form', template: @template, suggested_names: @suggested_names
- else
  %section.gh-panel.gh-dialog-page-panel
    = render 'new_form', template: @template, suggested_names: @suggested_names
