%h1 Activity Groups

= link_to 'Back to story group', @story_group

%hr

%h2 Templates

= link_to 'New template', new_story_group_activity_group_template_path(@story_group)

%br
%br

- if @activity_group_templates.empty?
  %p No templates yet.
- else
  - @activity_group_templates.each do |template|
    %div
      %strong= template.base_name
      \(#{template.categories.count} categories)

      = link_to 'Edit', edit_story_group_activity_group_template_path(@story_group, template)
      |
      = button_to 'Delete', story_group_activity_group_template_path(@story_group, template),
          method: :delete, data: { turbo_confirm: 'Are you sure?' }

    %hr

%h2 Groups

%div{ data: {
  controller: 'activity-group-name-dialog',
  activity_group_name_dialog_new_url_value: new_story_group_activity_group_path(@story_group),
  activity_group_name_dialog_default_name_value: @next_group_name
} }
  = link_to 'New activity group', '#',
      data: { action: 'click->activity-group-name-dialog#open' }

  %dialog{ data: { activity_group_name_dialog_target: 'dialog' } }
    %h3 Nazwa grupy aktywności
    %div
      %label{ for: 'group_name_input' } Nazwa
      %input#group_name_input{ type: 'text', data: { activity_group_name_dialog_target: 'nameInput' } }
    %div
      %button{ type: 'button', data: { action: 'click->activity-group-name-dialog#close' } } Anuluj
      %button{ type: 'button', data: { action: 'click->activity-group-name-dialog#confirm' } } Utwórz

%br
%br

- if @activity_groups.empty?
  %p No activity groups yet.
- else
  .activity-group-columns
    - @activity_groups.each do |group|
      .activity-group-column
        %h4= group.name

        - if group.activity_group_categories.any?
          %table.table.table-sm
            %thead
              %tr
                %th Story description
                %th Didactic description
                %th Reward
            %tbody
              - group.activity_group_categories.each do |category|
                %tr
                  %td= category.story_description
                  %td= category.didactic_description
                  %td= category.reward
        - else
          %p.text-muted No categories.

        .mt-2
          = link_to 'Edit', edit_story_group_activity_group_path(@story_group, group)
          |
          = button_to 'Delete', story_group_activity_group_path(@story_group, group),
              method: :delete, data: { turbo_confirm: 'Are you sure?' }
