%h1 Activity Groups

= link_to 'Back to story group', @story_group
|
= link_to 'New template', new_story_group_activity_group_template_path(@story_group)

%hr

- if @activity_group_templates.empty?
  %p No templates yet.
- else
  - @activity_group_templates.each do |template|
    %section
      %h2= template.base_name

      = link_to 'Edit template', edit_story_group_activity_group_template_path(@story_group, template)
      |
      = button_to 'Delete template', story_group_activity_group_template_path(@story_group, template),
          method: :delete, data: { turbo_confirm: 'Are you sure?' }

      %br
      %br

      = render 'bulk_create_modal', story_group: @story_group, template: template
      = render 'name_modal', story_group: @story_group, template: template

      %br
      %br

      - if template.activity_groups.empty?
        %p.text-muted No groups yet.
      - else
        .activity-group-columns
          - template.activity_groups.each do |group|
            .activity-group-column
              %h4= group.name

              - if group.activity_group_categories.any?
                %table.table.table-sm
                  %thead
                    %tr
                      %th Story description
                      %th Didactic description
                      %th Reward
                  %tbody
                    - group.activity_group_categories.each do |category|
                      %tr
                        %td= category.story_description
                        %td= category.didactic_description
                        %td= category.reward
              - else
                %p.text-muted No categories.

              .mt-2
                = link_to 'Give rewards', story_group_activity_group_students_activity_group_categories_path(@story_group, group)
                |
                = link_to 'Edit', edit_story_group_activity_group_path(@story_group, group)
                |
                = button_to 'Delete', story_group_activity_group_path(@story_group, group),
                    method: :delete, data: { turbo_confirm: 'Are you sure?' }

      %hr
