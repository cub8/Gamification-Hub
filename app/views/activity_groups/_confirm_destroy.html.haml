%h2#gh-del-title.gh-h2= t('.title', name: activity_group.name)
%p= t('.body')

- if awards_count.positive?
  %p.gh-info-banner
    %i.fa-solid.fa-lock{ 'aria-hidden': 'true' }
    %span
      = t('.awarded', count: awards_count)
      = t('.nothing_undone')

.gh-dialog-button-row
  - if @in_modal
    %button.gh-btn.gh-btn--secondary{ type: 'button', data: { action: 'dialog#close' }, autofocus: true }
      = t('shared.actions.cancel')
  - else
    = link_to t('shared.actions.cancel'), edit_story_group_activity_group_path(@story_group, activity_group),
      class: 'gh-btn gh-btn--secondary'

  = button_to t('.remove'), story_group_activity_group_path(@story_group, activity_group),
    method: :delete, class: 'gh-btn',
    form: { data: { turbo_frame: (@in_modal ? 'modal' : nil) } }
