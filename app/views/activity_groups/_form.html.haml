= form_with model: [@story_group, @activity_group] do |f|
  - if @activity_group.errors.any?
    %div
      %ul
        - @activity_group.errors.full_messages.each do |msg|
          %li= msg

  %div
    = f.label :name, 'Name'
    = f.text_field :name

  %h3 Categories

  %div{ data: {
    controller: 'sortable-form nested-rondo',
    sortable_form_handle_value: '.drag-handle',
  } }

    %div{ data: { sortable_form_target: 'list', nested_rondo_target: 'fieldContain' } }
      = f.fields_for :activity_group_categories do |cf|
        = render ActivityGroup::CategoryFormComponent.new(f: cf)

    = link_to_add_association 'Add category', f, :activity_group_categories,
        partial: 'activity_groups/category_form'

  %br

  = f.submit 'Save'
