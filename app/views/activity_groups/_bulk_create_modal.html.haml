- modal_id = "bulk-create-modal-#{template.id}"

= link_to 'Add multiple groups', '#',
    data: { bs_toggle: 'modal', bs_target: "##{modal_id}" }

.modal.fade{ id: modal_id, tabindex: '-1' }
  .modal-dialog
    .modal-content
      .modal-header
        %h5.modal-title Add multiple groups
        %button.btn-close{ type: 'button', data: { bs_dismiss: 'modal' } }
      = form_with url: create_bulk_story_group_activity_groups_path(story_group), method: :post do |f|
        = hidden_field_tag :template_id, template.id
        .modal-body
          %div
            = label_tag :count, 'Number of groups'
            = number_field_tag :count, 1, min: 1, max: 50, required: true
        .modal-footer
          %button{ type: 'button', data: { bs_dismiss: 'modal' } } Cancel
          = f.submit 'Create'
