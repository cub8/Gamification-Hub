- modal_id = "bulk-modal-#{template.id}"

.modal.fade{ id: modal_id, tabindex: '-1' }
  .modal-dialog
    .form-card.p-4.pe-auto
      %h2.page-title.mb-4 Dodaj wiele grup
      = form_with url: create_bulk_story_group_activity_groups_path(story_group), method: :post do |f|
        = hidden_field_tag :template_id, template.id
        .field-group.mb-3
          = label_tag :count, 'Liczba grup', class: 'form-label'
          = number_field_tag :count, 1, min: 1, max: 50, required: true, class: 'form-control'
        .d-flex.justify-content-end.gap-2
          %button.btn.btn-secondary{ type: 'button', data: { bs_dismiss: 'modal' } } Anuluj
          = f.submit 'Utwórz', class: 'btn btn-primary'
