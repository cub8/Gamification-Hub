- modal_id = "name-modal-#{template.id}"

.modal.fade{ id: modal_id, tabindex: '-1' }
  .modal-dialog
    .form-card.p-4.pe-auto
      %h2.page-title.mb-4 Nowa grupa aktywności
      = form_with url: story_group_activity_groups_path(story_group), method: :post do |f|
        = hidden_field_tag 'activity_group[activity_group_template_id]', template.id
        .field-group.mb-3
          = label_tag 'activity_group[name]', 'Nazwa', class: 'form-label'
          = text_field_tag 'activity_group[name]', ActivityGroup.next_name_for_template(template), required: true, class: 'form-control'
        .d-flex.justify-content-end.gap-2
          %button.btn.btn-secondary{ type: 'button', data: { bs_dismiss: 'modal' } } Anuluj
          = f.submit 'Utwórz', class: 'btn btn-primary'
