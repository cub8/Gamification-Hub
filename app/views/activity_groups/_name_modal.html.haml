= link_to 'New activity group', '#',
    data: { bs_toggle: 'modal', bs_target: '#activity-group-name-modal' }

.modal.fade#activity-group-name-modal{ tabindex: '-1' }
  .modal-dialog
    .modal-content
      .modal-header
        %h5.modal-title Activity group name
        %button.btn-close{ type: 'button', data: { bs_dismiss: 'modal' } }
      = form_with url: new_story_group_activity_group_path(story_group), method: :get do |f|
        .modal-body
          %div
            = f.label :name, 'Name'
            = f.text_field :name, value: next_group_name, required: true
        .modal-footer
          %button{ type: 'button', data: { bs_dismiss: 'modal' } } Cancel
          = f.submit 'Create'
