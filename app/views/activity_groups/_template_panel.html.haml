-# One template and the sheets stamped from it. Mockup: 30-ag.js:23-29.
- record = template.record
- count  = template.category_count

%section.gh-panel.gh-tpl{ 'aria-labelledby': "gh-tpl-#{record.id}" }
  .gh-tpl-h
    %div
      %h2.gh-h2{ id: "gh-tpl-#{record.id}" }= record.base_name
      %p.gh-tpl-meta
        = "Szablon: #{count} #{gh_plural(count, 'kategoria', 'kategorie', 'kategorii')},"
        = "do #{template.max_reward} #{@story_group.currency_name} na studenta za arkusz."
    %span.gh-tpl-sp

    = link_to 'Edytuj szablon', edit_story_group_activity_group_template_path(@story_group, record),
      class: 'gh-btn gh-btn--sec gh-btn--sm'
    = link_to new_story_group_activity_group_path(@story_group, template_id: record.id),
      class: 'gh-btn gh-btn--sm', data: { turbo_frame: 'modal' } do
      %i.fa-solid.fa-plus{ 'aria-hidden': 'true' }
      Utwórz arkusz

  - if template.any_sheets?
    %ul.gh-agl
      - template.sheets.each_with_index do |sheet, index|
        = render 'sheet_row', sheet: sheet, primary: index.zero?,
          fresh: fresh_sheet_ids.include?(sheet.record.id)
  - else
    %p.gh-expl Z tego szablonu nie utworzono jeszcze arkuszy.
