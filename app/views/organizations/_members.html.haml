- if users.any?
  %div{ data: { controller:              'list-search',
                list_search_total_value: users.size,
                list_search_of_value:    t('.of'), } }
    .gh-student-list-toolbar
      %label.gh-search-input
        %i.fa-solid.fa-magnifying-glass{ 'aria-hidden': 'true' }
        %input{ type:         'search',
                placeholder:  t('.search_placeholder'),
                'aria-label': t('.search_label'),
                data:         { list_search_target: 'input', action: 'input->list-search#filter' }, }
      %span.gh-select-input
        = select_tag :role, options_for_select(user_role_options), include_blank: t('.all_roles'),
          'aria-label': t('.filter_label'),
          data: { list_search_target: 'filter', action: 'change->list-search#filter' }
        %i.fa-solid.fa-chevron-down{ 'aria-hidden': 'true' }
      %span.gh-card-meta{ data: { list_search_target: 'count' } }
        = "#{users.size} #{t('.of')} #{users.size}"

    %section.gh-panel.gh-organizations-panel
      .gh-organization-member-row.gh-organization-member-row--header{ 'aria-hidden': 'true' }
        %span= t('.user')
        %span= t('.role')
        %span= t('.index_number')
        %span.gh-ledger-cell--right= t('.actions')

      = render partial: 'organizations/member_row', collection: users, as: :user

    %section.gh-panel.gh-empty-state{ hidden: true, data: { list_search_target: 'empty' } }
      %h2.gh-h2
        = t('.no_match')
        %span{ data: { list_search_target: 'emptyQuery' } }
      %p.gh-lead= t('.no_match_hint')
- else
  %section.gh-panel.gh-empty-state
    %h2.gh-h2= t('.empty_title')
    %p.gh-lead= t('.empty_lead')
