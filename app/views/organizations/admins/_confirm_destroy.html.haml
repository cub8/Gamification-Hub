- name = admin.full_name.presence || admin.email

%h2.gh-h2= "Usunąć administratora #{name}?"
%p
  Konto zostanie usunięte na stałe i zwolni się jedno miejsce w organizacji.
  - if admin.first_login?
    Wysłane zaproszenie przestanie działać.
= render 'organizations/owned_groups_notice', user: admin

.gh-dialog-button-row
  - if @in_modal
    %button.gh-btn.gh-btn--secondary{ type: 'button', data: { action: 'dialog#close' }, autofocus: true } Anuluj
  - else
    = link_to 'Anuluj', organization_path(@organization), class: 'gh-btn gh-btn--secondary'

  = button_to 'Usuń konto', organization_admin_path(@organization, admin),
              method: :delete, class: 'gh-btn',
              form:   { data: { turbo_frame: (@in_modal ? 'modal' : nil) } }
