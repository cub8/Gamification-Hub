.dark-page{ data: { controller: 'table-search' } }
  .d-flex.align-items-center.justify-content-between.mb-4
    %h1.h3.mb-0= @organization.name
    - if policy(@organization).add_user?
      = link_to new_user_organization_path(@organization), class: "btn btn-primary", data: { turbo_frame: "modal" } do
        %i.fa-solid.fa-plus.me-1
        Dodaj użytkownika

  - if @users.empty?
    %p.text-dimmed Brak użytkowników w organizacji.
  - else
    .d-flex.gap-2.mb-3
      .field-group.mb-0.flex-grow-1
        .input-group
          = text_field_tag :search, nil, placeholder: 'Wyszukaj po imieniu, nazwisku lub emailu', class: 'form-control',
                           data: { action: 'input->table-search#filter', table_search_target: 'input' }
          %span.input-group-text
            %i.fa-solid.fa-magnifying-glass
      .field-group.mb-0
        = select_tag :role, options_for_select(user_role_options), include_blank: 'Wszystkie role',
                     class: 'form-control',
                     data: { action: 'change->table-search#filter', table_search_target: 'select' }

    %table.table.table-hover.align-middle.mb-0{ data: { table_search_target: 'table' } }
      %thead
        %tr
          %th.ps-4 Imię i nazwisko
          %th Email
          %th Rola
          %th Numer uniwersytecki
          %th.text-end.pe-4 Akcje
      %tbody
        - @users.each do |user|
          %tr{ id: dom_id(user), data: { search_text: [user.full_name, user.email].compact.join(' '), filter_value: user.role } }
            %td.ps-4= user.full_name
            %td= user.email
            %td= user_role_label(user.role)
            %td= user.university_number
            %td.text-end.pe-4
              .d-flex.justify-content-end.gap-2
                = link_to edit_organization_user_path(@organization, user),
                  class: "btn btn-sm btn-secondary border-0",
                  title: "Edytuj",
                  data: { turbo_frame: "modal" } do
                  %i.fa-solid.fa-pen
                = button_to organization_user_path(@organization, user),
                  method: :delete,
                  form: { data: { turbo_confirm: "Czy na pewno chcesz usunąć użytkownika #{user.full_name}?" } },
                  class: "btn btn-sm btn-danger border-0",
                  title: "Usuń" do
                  %i.fa-solid.fa-trash
