.dark-page
  .d-flex.align-items-center.justify-content-between.mb-4
    %h1.h3.mb-0= @organization.name
    .d-flex.align-items-center.gap-2
      - if policy(@organization).update? || policy(@organization).destroy?
        .dropdown
          %button.btn.btn-secondary.border-0{ type: "button", data: { bs_toggle: "dropdown" }, "aria-expanded": false }
            %i.fa-solid.fa-ellipsis-vertical
          .dropdown-menu.dropdown-menu-end
            - if policy(@organization).update?
              = link_to edit_organization_path(@organization), class: "btn btn-flat border-0 text-start w-100 rounded", data: { turbo_frame: "modal" } do
                %i.fa-solid.fa-pen.me-2
                Edytuj organizację
            - if policy(@organization).add_admin?
              = link_to new_admin_organization_path(@organization), class: "btn btn-flat border-0 text-start w-100 rounded", data: { turbo_frame: "modal" } do
                %i.fa-solid.fa-user-shield.me-2
                Dodaj administatora
            - if policy(@organization).destroy?
              = button_to @organization, method: :delete,
                  form: { data: { turbo_confirm: "Czy na pewno chcesz usunąć organizację \"#{@organization.name}\"?" } },
                  class: "btn btn-flat text-danger border-0 text-start w-100 rounded" do
                %i.fa-solid.fa-trash.me-1
                Usuń organizację

  = render 'organization'
