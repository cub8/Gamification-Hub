- members = organization.users.count

%h2.gh-h2= t('.title')
%p
  = t('.accounts', count: members)
  = t('.accounts_tail')

= form_with url: organization_path(organization), method: :delete,
  data: { controller: 'confirm-name',
          confirm_name_expected_value: organization.name,
          turbo_frame: (@in_modal ? 'modal' : nil) } do

  .gh-form-field
    = label_tag :confirm do
      = t('.confirm_label')
      %b= organization.name
    .gh-text-input{ class: ('gh-text-input--invalid' if @confirm_failed) }
      = text_field_tag :confirm, nil, autocomplete: 'off', autofocus: true,
        'aria-invalid': (@confirm_failed ? 'true' : nil),
        'aria-describedby': (@confirm_failed ? 'gh-del-organization-error' : nil),
        data: { confirm_name_target: 'input', action: 'confirm-name#check' }
    - if @confirm_failed
      %p#gh-del-organization-error.gh-field-error{ role: 'alert' }
        %i.fa-solid.fa-triangle-exclamation{ 'aria-hidden': 'true' }
        %span= t('.mismatch')

  .gh-dialog-button-row
    - if @in_modal
      %button.gh-btn.gh-btn--secondary{ type: 'button', data: { action: 'dialog#close' } }= t('organizations.dialog_actions.cancel')
    - else
      = link_to t('organizations.dialog_actions.cancel'), organization_path(organization), class: 'gh-btn gh-btn--secondary'

    %button.gh-btn{ type: 'submit', disabled: true,
                    data: { confirm_name_target: 'submit' } }
      = t('.remove')
