-# An item somebody OWNS. Mockup: itemCard(), js-expanded/30-sp.js:17 —
-# a card whose foot is supplied by the caller.
-#
-# Deliberately not items/_card. That one is a shop item in one of three states
-# — buyable, saving up, sealed — and carries a price, a lock plate, a discount
-# ceiling and a progress meter, none of which mean anything once the thing is
-# bought and paid for. Same reasoning as the flat badge card on the teacher's
-# badge grid: a second card, not a fourth state of the first.
-#
-# Locals:
-#   purchase — the StudentsItem
-#   foot     — the line under the card
-#   cost     — show what was paid in the price chip (the teacher's tab does;
-#              the student's own inventory does not, because the foot says it)
- item = purchase.item
- cost = local_assigns.fetch(:cost, false)

%article.gh-card{ class: ('gh-card--consumed' if item.deleted?) }
  .gh-card-frame
    .gh-card-inset
      .gh-card-header
        %h3.gh-card-name= item.name
        - if cost
          %span.gh-price-badge.gh-price-badge--lg
            %b= purchase.price_paid

      .gh-card-art
        %span.gh-art-slot-wrapper
          = render 'items/art', item: item

      -# Off the shelf, still owned. Soft delete keeps it (DECISIONS.md:28) and
      -# the tag is the only thing that says why it is nowhere else.
      - if item.deleted?
        .gh-card-tags
          %span.gh-tag.gh-tag--removed Usunięty z oferty

      %p.gh-rule-text= item.didactic_description
      - if item.story_description.present?
        %p.gh-card-flavor= item.story_description

      .gh-card-footer
        %span.gh-card-meta.gh-small= foot
