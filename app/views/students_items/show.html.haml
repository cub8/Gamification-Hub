- content_for :title, @students_item.item.name

= turbo_frame_tag 'modal' do
  .modal-overlay.py-5.px-3
    .form-card.p-4
      %h2.page-title.mb-4= @students_item.item.name

      .text-center.mb-4
        - if @students_item.item.image.attached?
          = image_tag @students_item.item.image, class: "img-fluid rounded"
        - else
          %i.fa-solid.fa-box.fa-4x.text-dimmed

      - if @students_item.item.story_description.present?
        %p.fst-italic.mb-3= @students_item.item.story_description

      .d-flex.flex-column.gap-2.mb-4
        .d-flex.justify-content-between
          %span.text-dimmed Zapłacono
          .d-flex.align-items-center.gap-1
            %strong= @students_item.price_paid
            %span.text-dimmed.small= @story_group.currency_name
        - if @students_item.discount_applied > 0
          .d-flex.justify-content-between
            %span.text-dimmed Zastosowana zniżka
            %span= "-#{@students_item.discount_applied}%"
        .d-flex.justify-content-between
          %span.text-dimmed Data zakupu
          %span= @students_item.created_at.strftime('%d.%m.%Y %H:%M')

      .d-flex.justify-content-end
        = link_to "Zamknij", story_group_student_students_items_path(@story_group, @student), class: "btn btn-secondary", data: { turbo_frame: "_top" }
