- title = @own_items ? t('.own_title') : t('.title', name: @student.display_name)
- content_for :title, title
- count = @purchases.size

%section.gh-panel.gh-page-header
  .gh-page-header-text
    %h1.gh-h1= title
    %p.gh-lead
      - if @own_items
        = inventory_lead(count)
      - else
        = t('.teacher_lead', count: count)

  - if @own_items
    .gh-button-row
      = link_to story_group_shop_index_path(@story_group), class: 'gh-btn gh-btn--secondary' do
        %i.fa-solid.fa-bag-shopping{ 'aria-hidden': 'true' }
        = t('.go_to_shop')

- if @purchases.any?
  .gh-inventory-grid
    - @purchases.each do |purchase|
      = render 'students_items/card', purchase: purchase, cost: !@own_items,
        foot: (@own_items ? purchase_line(purchase) : purchase_teacher_line(purchase))

    - if @shop
      .gh-panel.gh-empty-slot-panel
        %p= inventory_shop_line(@shop.affordable)
        = link_to t('.see_shop'), story_group_shop_index_path(@story_group), class: 'gh-btn gh-btn--secondary'
- else
  %section.gh-panel.gh-empty-state
    - if @own_items
      %h2.gh-h2= t('.own_empty_title')
      %p.gh-lead= t('.own_empty_body')
      .gh-button-row
        = link_to t('.go_to_shop'), story_group_shop_index_path(@story_group), class: 'gh-btn'
    - else
      %h2.gh-h2= t('.empty_title')
      %p.gh-lead= t('.empty_body')
