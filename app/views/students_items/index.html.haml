- content_for :title, @own_items ? "Moje przedmioty" : "Przedmioty studenta"

- if turbo_frame_request_id == 'modal'
  = turbo_frame_tag 'modal' do
    .modal-overlay.py-5.px-3.dark-page
      .modal-card.p-4.h-auto
        = render 'index'
- else
  .dark-page
    .row.justify-content-center
      = render 'index'
