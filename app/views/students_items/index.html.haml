%h1 Przedmioty studenta: #{@student.user.email}

%table.table
  %tr
    %th Nazwa przedmiotu
    %th Opis fabularny
    %th Zapłacona kwota
    %th Zastosowana zniżka
    %th Data zakupu

  - @students_items.each do |students_item|
    %tr
      %td= students_item.item.name
      %td= students_item.item.story_description
      %td= "#{students_item.price_paid} #{@story_group.currency_name}"
      %td= "(-#{students_item.discount_applied}%)"
      %td= students_item.created_at.strftime('%Y-%m-%d %H:%M')
      %td= link_to 'Pokaż', story_group_student_students_item_path(@story_group, @student, students_item), class: 'btn btn-info btn-sm'

= link_to 'Powrót', story_group_student_path(@story_group, @student), class: 'btn btn-secondary'
