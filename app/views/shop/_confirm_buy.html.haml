- price = offer.price
- left  = @student.current_currency.to_i - price

%h2#gh-buy-title.gh-h2= "Kupić „#{item.name}”?"

.gh-purchase-summary
  = render 'layouts/item_thumb', item: item
  %dl.gh-purchase-details
    %dt Cena
    %dd
      - if offer.discounted?
        %s= offer.list_price
      %span.gh-buy-v= price
      = render 'layouts/currency_token', story_group: @story_group, size: 22
    %dt Zostanie Ci
    %dd
      %span.gh-buy-v= left
      = render 'layouts/currency_token', story_group: @story_group, size: 22

- if offer.discounted?
  %p.gh-small.gh-note-row= "Zniżka #{offer.discount_label}."

%p.gh-small.gh-note-row
  %i.fa-solid.fa-bell{ 'aria-hidden': 'true' }
  %span Prowadzący dostanie powiadomienie o zakupie.

.gh-dialog-button-row
  - if @in_modal
    %button.gh-btn.gh-btn--secondary{ type: 'button', data: { action: 'dialog#close' }, autofocus: true }
      Anuluj
  - else
    = link_to 'Anuluj', story_group_shop_index_path(@story_group), class: 'gh-btn gh-btn--secondary'

  = button_to "Kup za #{price}", buy_story_group_shop_path(@story_group, item),
    method: :post, class: 'gh-btn',
    form: { data: { turbo_frame: '_top' } }
