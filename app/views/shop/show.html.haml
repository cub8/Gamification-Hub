%h1= @item.name

%p
  %strong Story Description:
  = @item.story_description

%p
  %strong Didactic Description:
  = @item.didactic_description

%p
  %strong Price:
  - discount_info = @item.discount_info_for(@student)
  - discounted_price = @item.discounted_price_for(@student)

  - if discounted_price < @item.price
    %s= @item.price
    %strong= "#{discounted_price} #{@story_group.currency_name}"
    = discount_label(discount_info)
  - else
    = "#{@item.price} #{@story_group.currency_name}"


- if @item.image.attached?
  %br
  = image_tag @item.image, width: 200

%br
= link_to 'Back to Shop', story_group_shop_index_path(@story_group)
