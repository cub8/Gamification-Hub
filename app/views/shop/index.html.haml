- content_for :title, "Sklep"

.dark-page
  .d-flex.align-items-center.justify-content-between.mb-4
    %h1.h3.mb-0 Sklep
    .d-flex.align-items-center.gap-2
      - if @story_group.currency_icon.attached?
        = image_tag @story_group.currency_icon, width: 20, height: 20, class: "object-fit-contain"
      %span.fw-semibold= @student.current_currency
      %span.text-dimmed= @story_group.currency_name

  - if @items.empty?
    %p.text-dimmed Brak przedmiotów w sklepie.
  - else
    - if @eligible_items.any?
      .d-flex.flex-column.gap-3
        = render partial: 'item', collection: @eligible_items, locals: { locked: false }

    - if @locked_items.any?
      - if @eligible_items.any?
        .my-4
          %hr.border-secondary
          %p.text-dimmed.small.mt-2.mb-0 Zablokowane
      .d-flex.flex-column.gap-3
        = render partial: 'item', collection: @locked_items, locals: { locked: true }
