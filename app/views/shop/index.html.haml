-# Sklep, the student's shop. Mockup: #/s/shop, js-expanded/30-main.js:87-98.
-#
-# Three zones on the table, in reading order: what you can have, what you are
-# working toward, what is still shut. An empty zone is not rendered — a dashed
-# frame around nothing reads as a fault, not as an absence.
- content_for :title, 'Sklep'

%section.gh-panel.gh-phead
  .gh-phead-t
    %h1.gh-h1 Sklep
    %p.gh-lead
      = shop_balance_sentence(@shop.balance)
      = shop_discount_sentence(@shop.discount_badges)

  -# Both numbers, because they answer different questions: one is what you can
  -# spend today, the other is what decides your rank and never goes down.
  .gh-purse-mini
    = render 'layouts/currency_token', story_group: @story_group, size: 32
    %div
      %b= @shop.balance
      %small do wydania
    %span.gh-div{ 'aria-hidden': 'true' }
    %div
      %b= @shop.total
      %small zebrane łącznie

- if @shop.any?
  - @shop.zones.each do |zone|
    %section.gh-zone
      %h2.gh-zone-l
        %span= zone.label
        %span.gh-zone-n.gh-oct= zone.offers.size
      .gh-cards
        - zone.offers.each do |offer|
          = render 'shop/card', offer: offer, state: zone.key
- else
  %section.gh-panel.gh-gm
    %h2.gh-h2 Sklep jest jeszcze pusty
    %p.gh-lead
      Prowadzący nie dodał jeszcze przedmiotów. Zbieraj walutę — przyda się,
      kiedy sklep się otworzy.
