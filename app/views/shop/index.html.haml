- content_for :title, "Sklep"

.dark-page
  .d-flex.align-items-center.justify-content-between.mb-4
    %h1.h3.mb-0 Sklep
    .d-flex.align-items-center.gap-2
      - if @story_group.currency_icon.attached?
        = image_tag @story_group.currency_icon, width: 20, height: 20, class: "object-fit-contain"
      %span.fw-semibold= @student.current_currency
      %span.text-dimmed= @story_group.currency_name

  - if @items.empty?
    %p.text-dimmed Brak przedmiotów w sklepie.
  - else
    .row.g-3
      - @items.each do |item|
        - discount_info = item.discount_info_for(@student)
        - discounted_price = item.discounted_price_for(@student)
        - eligibility = PurchaseEligibilityService.new(student: @student, item: item).call
        .col-12.col-sm-6.col-md-4.col-xl-3
          .dark-card{ class: ('opacity-75' unless eligibility.eligible?) }
            - if item.image.attached?
              .dark-card-cover
                = image_tag item.image
            - else
              .dark-card-icon
                %i.fa-solid.fa-box.fa-3x

            .dark-card-body
              .dark-card-title= item.name
              - if item.story_description.present?
                %p.text-dimmed.small.fst-italic.mb-2= truncate(item.story_description, length: 80)

              .mt-2
                - if discounted_price < item.price
                  .d-flex.align-items-center.gap-2.flex-wrap
                    %s.text-dimmed.small= item.price
                    %strong= discounted_price
                    %span.text-dimmed.small= @story_group.currency_name
                    %span.badge.bg-success= discount_label(discount_info)
                - else
                  .d-flex.align-items-center.gap-1
                    %strong= item.price
                    %span.text-dimmed.small= @story_group.currency_name

            .dark-card-actions
              = link_to story_group_shop_path(@story_group, item), class: "btn btn-sm btn-secondary border-0", title: "Szczegóły" do
                %i.fa-solid.fa-eye
              - if eligibility.eligible?
                = button_to buy_story_group_shop_path(@story_group, item), method: :post, class: "btn btn-sm btn-primary" do
                  %i.fa-solid.fa-cart-shopping.me-1
                  Kup
              - else
                %span.btn.btn-sm.btn-secondary.disabled
                  %i.fa-solid.fa-lock.me-1
                  Zablokowane
