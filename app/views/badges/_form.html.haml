- editing = badge.persisted?
- error   = ->(attribute) { badge.errors[attribute].first }
- slot    = editing ? shelf.slots.find { |candidate| candidate.badge == badge } : nil
- holders = slot&.holders.to_i

%section.gh-panel.gh-page-header.gh-page-header--stacked
  %p.gh-breadcrumbs
    = link_to t('.breadcrumb'), story_group_badges_path(@story_group)
    %i.fa-solid.fa-chevron-right{ 'aria-hidden': 'true' }
    %span= editing ? (badge.name_was.presence || badge.name) : t('.new_title')
  %h1.gh-h1= editing ? t('.edit_title') : t('.new_title')
  %p.gh-lead= t('.lead')

- form_data = { controller: 'badge-form', action: 'gh:image-crop->badge-form#art',
                badge_form_name_placeholder_value: t('badges.helpers.name_placeholder'),
                badge_form_rule_placeholder_value: t('badges.helpers.rule_placeholder'),
                badge_form_discount_label_value: t('badges.helpers.discount', discount: '%{discount}'), }

= form_with model: [@story_group, badge], data: form_data do |f|

  .gh-form-shell
    %section.gh-panel.gh-form-column
      - if holders.positive?
        %p.gh-info-banner
          %i.fa-solid.fa-users{ 'aria-hidden': 'true' }
          %span
            %b= t('.holders', count: holders)
            = t('.holders_note')

      .gh-form-section
        %h2.gh-h3= t('.card')
        %p.gh-field-hint= t('.card_hint')

        .gh-form-field
          = f.label :name, t('shared.actions.name')
          .gh-text-input{ class: ('gh-text-input--invalid' if error.call(:name)) }
            = f.text_field :name, maxlength: 50, autocomplete: 'off',
              placeholder: t('.name_placeholder'),
              'aria-invalid': (error.call(:name) ? 'true' : nil),
              'aria-describedby': (error.call(:name) ? 'gh-badge-name-error' : nil),
              data: { badge_form_target: 'name', action: 'badge-form#refresh' }
          - if error.call(:name)
            %p#gh-badge-name-error.gh-field-error{ role: 'alert' }
              %i.fa-solid.fa-triangle-exclamation{ 'aria-hidden': 'true' }
              %span= error.call(:name)

        .gh-form-field
          = f.label :didactic_description, t('.rule')
          .gh-text-input{ class: ('gh-text-input--invalid' if error.call(:didactic_description)) }
            = f.text_area :didactic_description, rows: 2, maxlength: 255,
              placeholder: t('.rule_placeholder'),
              'aria-invalid': (error.call(:didactic_description) ? 'true' : nil),
              'aria-describedby': (error.call(:didactic_description) ? 'gh-badge-rule-error' : nil),
              data: { badge_form_target: 'rule', action: 'badge-form#refresh' }
          - if error.call(:didactic_description)
            %p#gh-badge-rule-error.gh-field-error{ role: 'alert' }
              %i.fa-solid.fa-triangle-exclamation{ 'aria-hidden': 'true' }
              %span= error.call(:didactic_description)
          %span.gh-field-hint= t('.rule_hint')

        .gh-form-field
          = f.label :story_description do
            = t('.story')
            %small= t('shared.actions.optional')
          .gh-text-input{ class: ('gh-text-input--invalid' if error.call(:story_description)) }
            = f.text_area :story_description, rows: 2, maxlength: 255,
              placeholder: t('.story_placeholder'),
              'aria-invalid': (error.call(:story_description) ? 'true' : nil),
              'aria-describedby': (error.call(:story_description) ? 'gh-badge-story-error' : nil),
              data: { badge_form_target: 'story', action: 'badge-form#refresh' }
          - if error.call(:story_description)
            %p#gh-badge-story-error.gh-field-error{ role: 'alert' }
              %i.fa-solid.fa-triangle-exclamation{ 'aria-hidden': 'true' }
              %span= error.call(:story_description)

        = render 'shared/image_field', form: f, record: badge,
          presets: Glyphs::BADGE, kind: 'badge',
          refresh_action: 'badge-form#refresh'

      .gh-form-section
        %h2.gh-h3= t('.discount_section')
        %p.gh-field-hint= t('.discount_hint')

        .gh-form-field
          = f.label :discount, t('.discount')
          .gh-price-field-row
            .gh-text-input.gh-text-input--numeric{ class: ('gh-text-input--invalid' if error.call(:discount)) }
              = f.number_field :discount, min: 0, max: 100, step: 1,
                'aria-invalid': (error.call(:discount) ? 'true' : nil),
                'aria-describedby': (error.call(:discount) ? 'gh-badge-disc-error' : nil),
                data: { badge_form_target: 'discount', action: 'badge-form#refresh' }
            %span.gh-price-unit-label %

        - if error.call(:discount)
          %p#gh-badge-disc-error.gh-field-error{ role: 'alert' }
            %i.fa-solid.fa-triangle-exclamation{ 'aria-hidden': 'true' }
            %span= error.call(:discount)

        - using = editing ? shelf.dependent_items(badge) : []
        - if using.any?
          %p.gh-form-label.gh-label--spaced= t('.used_by')
          %ul.gh-badge-usage-list
            - using.each do |item|
              %li
                = render 'layouts/item_thumb', item: item
                = item.name
        - else
          %p.gh-explainer-note= t('.unused')

      - if editing
        .gh-form-section
          %h2.gh-h3= t('shared.actions.removal')
          %p.gh-field-hint= t('.removal_hint')
          .gh-button-row
            = link_to confirm_destroy_story_group_badge_path(@story_group, badge),
              class: 'gh-btn gh-btn--secondary', data: { turbo_frame: 'modal' } do
              %i.fa-solid.fa-trash{ 'aria-hidden': 'true' }
              = t('.remove')

    %aside.gh-preview-column{ 'aria-label': t('shared.actions.preview') }
      = render 'preview', badge: badge

  .gh-panel.gh-form-actions-bar
    = link_to t('shared.actions.cancel'), story_group_badges_path(@story_group), class: 'gh-link-button'
    %span.gh-form-actions-spacer
    %button.gh-btn{ type: 'submit' }
      - unless editing
        %i.fa-solid.fa-plus{ 'aria-hidden': 'true' }
      = editing ? t('shared.actions.save_changes') : t('.create')
