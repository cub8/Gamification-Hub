= form_with(model: [@story_group, badge]) do |form|
  - if badge.errors.any?
    %div{style: "color: red"}
      %h2= "#{pluralize(badge.errors.count, "error")} prohibited this badge from being saved:"
      %ul
        - badge.errors.each do |error|
          %li= error.full_message

  %div
    = form.label :name, style: "display: block"
    = form.text_field :name

  %div
    = form.label :story_description, style: "display: block"
    = form.text_area :story_description

  %div
    = form.label :didactic_description, style: "display: block"
    = form.text_area :didactic_description

  %div
    = form.label 'Discount (%)', style: "display: block"
    = form.number_field :discount, in: 0..100, step: 1

  %div
    = form.label :icon, style: "display: block"
    = form.file_field :icon, accept: "image/*"

  %div
    = form.submit
