- content_for :title, @badge.name

= turbo_frame_tag 'modal' do
  .modal-overlay.py-5.px-3
    .form-card.p-4
      %h2.page-title.mb-4= @badge.name

      .text-center.mb-4
        - if @badge.icon.attached?
          = image_tag @badge.icon, class: "img-fluid rounded"
        - else
          %i.fa-solid.fa-award.fa-4x.text-dimmed

      .d-flex.flex-column.gap-2.mb-4
        - if @badge.story_description.present?
          %p.fst-italic.mb-1= @badge.story_description
        - if @badge.didactic_description.present?
          %p.mb-1= @badge.didactic_description
        .d-flex.justify-content-between
          %span.text-dimmed Zniżka
          %span= "#{@badge.discount}%"

      .d-flex.justify-content-end.align-items-center.gap-2
        = link_to "Zamknij", story_group_badges_path(@story_group), class: "btn btn-secondary", data: { turbo_frame: "_top", turbo_prefetch: true }
        - if policy(@story_group).update?
          = link_to edit_story_group_badge_path(@story_group, @badge), class: "btn btn-primary", data: { turbo_prefetch: true } do
            %i.fa-solid.fa-pen.me-1
            Edytuj
