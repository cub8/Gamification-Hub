%section.gh-panel.gh-page-header
  .gh-page-header-text
    %h1.gh-h1= t('.title')
    %p.gh-lead= t('.lead', earned: shelf.earned_count, total: shelf.size)

- if shelf.any?
  .gh-card-grid.gh-card-grid--compact
    - shelf.slots.each do |slot|
      = render 'flip_card', badge: slot.badge,
        earned: slot.earned?,
        interactive: slot.earned?,
        withdrawn: slot.withdrawn?
- else
  %section.gh-panel.gh-empty-state
    %h2.gh-h2= t('.empty_title')
    %p.gh-lead= t('.empty_body')
