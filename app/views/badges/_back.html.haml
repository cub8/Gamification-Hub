- targets = local_assigns.fetch(:targets, {})
- flipper = local_assigns.fetch(:flipper, false)

.gh-flip-card-back-mark.gh-octagon-clip
  = render 'badges/badge_mark'

%h3.gh-card-name{ class: ('gh-placeholder-text' if badge.name.blank?), data: targets[:back_name] }
  = badge_name(badge)

%p.gh-badge-rule-text
  %span= t('.how')
  %span{ data: targets[:how] }= badge_rule(badge)

- if flipper
  %button.gh-card-flip-btn{ type: 'button', 'aria-label': t('.flip_label', name: badge.name) }
    %i.fa-solid.fa-arrows-rotate{ 'aria-hidden': 'true' }
    = t('.flip')
