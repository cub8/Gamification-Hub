- content_for :title, t('.title')
- columns = tag.code('nazwa, opis_dydaktyczny, opis_fabularny, zniżka, ikona')

= render 'shared/csv_import_dialog', title: t('.dialog_title'),
                                     url:   import_story_group_badges_path(@story_group),
                                     hint:  t('.hint_html', columns: columns),
                                     error: @upload_error
