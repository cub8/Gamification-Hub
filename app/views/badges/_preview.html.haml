-# The form's preview column. Mockup: pvBadge(), js-expanded/30-br.js:62-69.
-#
-# Server-rendered so it is right before a single keystroke and right with no
-# JavaScript at all; badge_form_controller then keeps it honest as you type. It
-# never generates markup — it rewrites the text in this one, which is why the
-# glyphs can stay Rails-rendered inline SVG.
-#
-# The card here is NOT interactive: the segmented control below the heading is
-# what turns it, so a teacher can check both faces without guessing which side
-# a click will land them on.
- targets = { flip:      { badge_form_target: 'flip' },
              name:      { badge_form_target: 'frontName' },
              art:       { badge_form_target: 'frontArt' },
              rules:     { badge_form_target: 'frontRules' },
              flavor:    { badge_form_target: 'frontFlavor' },
              tag:       { badge_form_target: 'frontTag' },
              back_name: { badge_form_target: 'backName' },
              how:       { badge_form_target: 'backHow' }, }

%details.gh-pvd{ open: true }
  %summary
    Podgląd karty
    %i.fa-solid.fa-chevron-down{ 'aria-hidden': 'true' }

  %section.gh-panel.gh-pv
    %h3 Tak zobaczą to studenci

    .gh-seg2{ role: 'group', 'aria-label': 'Strona karty' }
      %button{ type: 'button', 'aria-pressed': 'true', value: 'won',
               data: { action: 'badge-form#side', badge_form_target: 'side' } }
        Zdobyta
      %button{ type: 'button', 'aria-pressed': 'false', value: 'lost',
               data: { action: 'badge-form#side', badge_form_target: 'side' } }
        Jeszcze niezdobyta

    .gh-pvflip
      = render 'flip_card', badge: badge, earned: true,
        interactive: false, targets: targets

  %section.gh-panel.gh-pv
    %h3 W oknie przyznawania
    .gh-thumbrow
      = render 'badge_thumb', badge: badge,
        inner_data: { badge_form_target: 'thumbArt' }
      %span
        %b{ data: { badge_form_target: 'thumbName' } }= badge_name(badge)
        %span.gh-small{ data: { badge_form_target: 'thumbSub' } }
          = badge_thumb_subtitle(badge)
