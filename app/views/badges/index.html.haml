- content_for :title, "Badges"

.dark-page
  .d-flex.align-items-center.justify-content-between.mb-4
    %h1.h3.mb-0 Badges
    - if policy(@story_group).update?
      = link_to new_story_group_badge_path(@story_group), class: "btn btn-primary" do
        %i.bi.bi-plus-lg.me-1
        New Badge

  - if @badges.empty?
    %p.text-dimmed No badges yet.
  - else
    .row.g-3
      - @badges.each do |badge|
        .col-12.col-sm-6.col-md-4.col-xl-3
          .dark-card
            - if badge.icon.attached?
              .dark-card-cover
                = image_tag badge.icon
            - else
              .dark-card-icon
                %i.bi.bi-patch-check{ style: "font-size: 2.5rem;" }

            .dark-card-body
              .dark-card-title= badge.name
              %p.text-dimmed.small.fst-italic.mb-1= truncate(badge.story_description, length: 80)
              %p.text-dimmed.small.mb-0= truncate(badge.didactic_description, length: 80)
              %span.badge.bg-secondary.mt-2= "#{badge.discount}% discount"

            .dark-card-actions
              = link_to story_group_badge_path(@story_group, badge), class: "btn btn-sm btn-secondary border-0", title: "View" do
                %i.bi.bi-eye
              - if policy(@story_group).update?
                = link_to edit_story_group_badge_path(@story_group, badge), class: "btn btn-sm btn-secondary border-0", title: "Edit" do
                  %i.bi.bi-pencil
                = button_to story_group_badge_path(@story_group, badge),
                  method: :delete,
                  form: { data: { turbo_confirm: "Delete badge \"#{badge.name}\"?" } },
                  class: "btn btn-sm btn-danger border-0", title: "Delete" do
                  %i.bi.bi-trash
