- content_for :title, "Edit Badge — #{@badge.name}"

.dark-page
  .row.justify-content-center
    .col-12.col-md-8.col-lg-6
      %h1.page-title.mb-4 Edit Badge

      - content_for :form_cancel do
        = link_to "Cancel", story_group_badge_path(@story_group, @badge), class: "btn-cancel py-2 px-3"

      = render "form", badge: @badge
