- content_for :title, t('.page_title', name: @badge.name)

- if @in_modal
  = turbo_frame_tag 'modal' do
    = render 'confirm_destroy',
             badge:           @badge,
             unlocking_items: @unlocking_items,
             story_group:     @story_group,
             in_modal:        @in_modal
- else
  %section.gh-panel.gh-dialog-page-panel
    = render 'confirm_destroy',
             badge:           @badge,
             unlocking_items: @unlocking_items,
             story_group:     @story_group,
             in_modal:        @in_modal
