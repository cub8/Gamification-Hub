%h2#gh-del-title.gh-h2= t('.title', name: badge.name)
%p= t('.body')

- if unlocking_items.any?
  %p.gh-warning-note{ role: 'alert' }
    %i.fa-solid.fa-triangle-exclamation{ 'aria-hidden': 'true' }
    %span= t('.unlocking', count: unlocking_items.size, items: gh_and_list(unlocking_items.map(&:name)))

.gh-dialog-button-row
  - if @in_modal
    %button.gh-btn.gh-btn--secondary{ type: 'button', data: { action: 'dialog#close' }, autofocus: true }
      = t('shared.actions.cancel')
  - else
    = link_to t('shared.actions.cancel'), edit_story_group_badge_path(@story_group, badge), class: 'gh-btn gh-btn--secondary'

  = button_to t('.remove'), story_group_badge_path(@story_group, badge),
    method: :delete, class: 'gh-btn',
    form: { data: { turbo_frame: (@in_modal ? 'modal' : nil) } }
