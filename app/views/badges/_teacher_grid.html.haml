%section.gh-panel.gh-page-header
  .gh-page-header-text
    %h1.gh-h1= t('.title')
    %p.gh-lead= t('.lead', count: shelf.size)

  .gh-button-row
    = link_to new_story_group_badge_path(@story_group), class: 'gh-btn' do
      %i.fa-solid.fa-plus
      = t('.new')

- if shelf.any?
  .gh-badge-grid--teacher
    - shelf.slots.each do |slot|
      - badge = slot.badge
      %article.gh-card.gh-card--badge
        .gh-card-frame
          .gh-card-inset
            .gh-card-header
              %h3.gh-card-name= badge.name

            .gh-card-art
              = render 'art', badge: badge

            - if (discount = badge_discount_label(badge))
              .gh-card-tags
                %span.gh-tag.gh-tag--discount= discount

            %p.gh-rule-text= badge.didactic_description
            - if badge.story_description.present?
              %p.gh-card-flavor= badge.story_description

            .gh-card-footer
              %span.gh-card-meta= badge_holders_line(slot.holders)
              .gh-card-actions
                = link_to t('.award'), story_group_students_path(@story_group),
                  class: 'gh-btn gh-btn--small'
                = link_to edit_story_group_badge_path(@story_group, badge),
                  class: 'gh-icon-button', 'aria-label': t('.edit_label', name: badge.name) do
                  %i.fa-solid.fa-pen{ 'aria-hidden': 'true' }
- else
  %section.gh-panel.gh-empty-state
    %h2.gh-h2= t('.empty_title')
    %p.gh-lead= t('.empty_body')
